+// UTF-16 big-endian (the packs' text) to UTF-8 and back.
+std::string Utf8(const std::string& utf16) {
+    std::string out;
+    for (size_t i = 0; i + 1 < utf16.size(); i += 2) {
+        const uint32_t unit = (static_cast<uint8_t>(utf16[i]) << 8) | static_cast<uint8_t>(utf16[i + 1]);
+        if (unit < 0x80) {
+            out.push_back(static_cast<char>(unit));
+        } else if (unit < 0x800) {
+            out.push_back(static_cast<char>(0xC0 | (unit >> 6)));
+            out.push_back(static_cast<char>(0x80 | (unit & 0x3F)));
+        } else {
+            out.push_back(static_cast<char>(0xE0 | (unit >> 12)));
+            out.push_back(static_cast<char>(0x80 | ((unit >> 6) & 0x3F)));
+            out.push_back(static_cast<char>(0x80 | (unit & 0x3F)));
+        }
+    }
+    return out;
+}
+
+std::string Utf16(const std::string& utf8) {
+    std::string out;
+    for (size_t i = 0; i < utf8.size();) {
+        const uint8_t byte = static_cast<uint8_t>(utf8[i]);
+        uint32_t unit = byte;
+        size_t length = 1;
+        if (byte >= 0xE0) {
+            unit = byte & 0x0F;
+            length = 3;
+        } else if (byte >= 0xC0) {
+            unit = byte & 0x1F;
+            length = 2;
+        }
+        for (size_t k = 1; k < length && i + k < utf8.size(); ++k) {
+            unit = (unit << 6) | (static_cast<uint8_t>(utf8[i + k]) & 0x3F);
+        }
+        out.push_back(static_cast<char>(unit >> 8));
+        out.push_back(static_cast<char>(unit & 0xFF));
+        i += length;
+    }
+    return out;
+}
+
+// The longest line as the text shows it: characters, not codes (%...%), a name (%A%, %0D%, %1D%)
+// as 8.
+uint32_t LongestLine(const std::string& text) {
+    uint32_t longest = 0;
+    uint32_t line = 0;
+    for (size_t i = 0; i < text.size(); ++i) {
+        if (text[i] == '\n') {
+            line = 0;
+        } else if (text[i] == '%') {
+            const size_t close = text.find('%', i + 1);
+            if (close == std::string::npos) {
+                break;
+            }
+            const std::string code = text.substr(i + 1, close - i - 1);
+            if (code == "A" || code == "0D" || code == "1D") {
+                line += 8;
+            }
+            i = close;
+        } else if ((static_cast<uint8_t>(text[i]) & 0xC0) != 0x80) {
+            ++line;
+        }
+        longest = std::max(longest, line);
+    }
+    return longest;
+}
