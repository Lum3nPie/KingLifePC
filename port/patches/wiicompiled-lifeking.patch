diff --git a/runtime/src/hle/foreign_game_natives.cpp b/runtime/src/hle/foreign_game_natives.cpp
new file mode 100644
index 0000000..be149bd
--- /dev/null
+++ b/runtime/src/hle/foreign_game_natives.cpp
@@ -0,0 +1,24 @@
+// Natives for a foreign game's own code - functions Mario Kart Wii does not have, so they cannot be
+// named by a PAL address. Each one names its game and that game's address (FOREIGN_GAME_NATIVE in
+// hle_stubs.h) and is registered only while that game is running.
+
+#include "hle_stubs.h"
+#include "runtime_config.h"
+
+#include <cstdint>
+#include <cstdio>
+
+// Harvest Moon: Animal Parade (USA), 0x8010FF04: the language the game's own text uses. The disc
+// has English, German, French, Spanish and Italian text, but the US build's function only ever
+// answers 1 (English); the game stores the answer while it starts and picks every message, talk,
+// event and menu file by it. Its numbers are the console's (1 English, 2 German, 3 French,
+// 4 Spanish, 5 Italian), so it now answers [console] language from Config.toml, as SCGetLanguage does.
+extern "C" uint32_t AnimalParadeTextLanguage_HLE()
+{
+    const uint32_t language = RuntimeConfigFile::ConsoleLanguageCode();
+    std::fprintf(stderr, "[animal-parade] text language -> %u (%s)\n", language,
+                 RuntimeConfigFile::Language().c_str());
+    return language;
+}
+
+FOREIGN_GAME_NATIVE(RBIEE9, 8010FF04, AnimalParadeTextLanguage_HLE, uint32_t, (), ());
diff --git a/runtime/src/hle/game_mods/animal_parade_cheats.cpp b/runtime/src/hle/game_mods/animal_parade_cheats.cpp
new file mode 100644
index 0000000..1b40d4e
--- /dev/null
+++ b/runtime/src/hle/game_mods/animal_parade_cheats.cpp
@@ -0,0 +1,172 @@
+// Harvest Moon: Animal Parade cheats, each off unless Config.toml turns it on in [mods]:
+//   cheat_infinite_stamina = true   the stamina stays full: work never tires the player
+//   cheat_infinite_money = true     the money stays at 999,999 G
+//   cheat_stop_time = true          the clock does not move (sleeping still goes on to the next day)
+//   cheat_infinite_lumber = true    the lumber stays at 9,999
+//   cheat_infinite_stone = true     the material stone stays at 9,999
+//   cheat_infinite_feed = true      the fodder and the bird feed stay at 9,999
+// The launcher lists them in its Cheats tab, and the F10 menu has them under Cheats, where they can
+// be turned on and off while playing.
+//
+// Where the game keeps what they change:
+//   *(0x806B3A24)            the game's state (the save data while playing)
+//     +0x1454                the money, in G
+//     +0x1458, +0x145C       the fodder and the bird feed (items 0x4CE and 0x4CF in the shops)
+//     +0x1460, +0x1464       the lumber and the material stone (what the carpenter takes for a building)
+//                            These four are game variables 0x29 to 0x2C, each from 0 to 9,999 (the
+//                            limits the game keeps at *(0x8050AA10 + 8), 12 bytes a variable).
+//     +0x1468, +0x146C       the stamina and its maximum (800 for a new farmer; the bar at the bottom)
+//   0x80107944               the clock's tick: two seconds of game time each call. The field's update
+//                            (0x801294F0) calls it every frame while the clock runs; a script that moves
+//                            the time on calls it too (0x8010EEFC, thirty times for a minute).
+//
+// The money, the stamina and the four stores are set once a frame, from the player's update
+// (player_speed.cpp calls AnimalParadeCheatsEveryFrame). The clock is stopped by leaving out the field's tick only, so the
+// scripts that move the time on still do.
+
+#include "animal_parade_cheats.h"
+
+#include "game_mods.h"
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_config.h"
+
+#include <imgui.h>
+
+#include <atomic>
+#include <cstdint>
+
+// Its own namespace: the runtime is built in unity batches, where another mod's names can share this
+// file's translation unit.
+namespace AnimalParadeCheats {
+namespace {
+
+constexpr uint32_t kGameState = 0x806B3A24u;
+constexpr uint32_t kMoney = 0x1454u;
+constexpr uint32_t kMoneyKept = 999999u;
+constexpr uint32_t kStamina = 0x1468u;
+constexpr uint32_t kStaminaMaximum = 0x146Cu;
+constexpr uint32_t kFodder = 0x1458u;
+constexpr uint32_t kBirdFeed = 0x145Cu;
+constexpr uint32_t kLumber = 0x1460u;
+constexpr uint32_t kMaterialStone = 0x1464u;
+constexpr uint32_t kStoreKept = 9999u;  // the most the game lets each of the four hold
+constexpr uint32_t kFieldTickReturn = 0x80129584u;  // right after the field's call to the tick
+
+// The cheats, in the order the F10 menu lists them. Each starts as its line in Config.toml [mods]
+// says; the F10 menu's Cheats can turn one on or off while playing, and saves the change to the same
+// line, so the launcher shows it too. The game's thread reads them, F10 changes them: atomics.
+struct Cheat {
+    const char* key;          // its line in Config.toml [mods]
+    const char* name;         // in the F10 menu
+    const char* description;  // under it
+    std::atomic<bool> on{false};
+};
+
+Cheat g_cheats[] = {
+    {"cheat_infinite_stamina", "Infinite stamina", "The stamina bar stays full."},
+    {"cheat_infinite_money", "Infinite money", "The money stays at 999,999 G."},
+    {"cheat_infinite_lumber", "Infinite lumber", "The lumber stays at 9,999."},
+    {"cheat_infinite_stone", "Infinite material stone", "The material stone stays at 9,999."},
+    {"cheat_infinite_feed", "Infinite feed", "The fodder and the bird feed stay at 9,999."},
+    {"cheat_stop_time", "Stop time", "The clock stands still (sleeping still goes on to the next day)."},
+};
+enum CheatIndex { kInfiniteStamina, kInfiniteMoney, kInfiniteLumber, kInfiniteStone, kInfiniteFeed, kStopTime };
+
+// Reads Config.toml the first time any cheat is asked about.
+void LoadOnce() {
+    static const bool loaded = [] {
+        for (Cheat& cheat : g_cheats) {
+            cheat.on.store(RuntimeConfigFile::ModEnabled(cheat.key), std::memory_order_relaxed);
+        }
+        return true;
+    }();
+    (void)loaded;
+}
+
+bool On(CheatIndex index) {
+    LoadOnce();
+    return g_cheats[index].on.load(std::memory_order_relaxed);
+}
+
+bool InfiniteStamina() { return On(kInfiniteStamina); }
+bool InfiniteMoney() { return On(kInfiniteMoney); }
+bool InfiniteLumber() { return On(kInfiniteLumber); }
+bool InfiniteStone() { return On(kInfiniteStone); }
+bool InfiniteFeed() { return On(kInfiniteFeed); }
+bool StopTime() { return On(kStopTime); }
+
+// Puts one of the four stores at its most when it has less.
+void Fill(uint32_t state, uint32_t store) {
+    if (Memory::Read32(state + store) < kStoreKept) {
+        Memory::Write32(state + store, kStoreKept);
+    }
+}
+
+// The F10 menu's Cheats: a checkbox for each, applied at once and saved for the next start.
+void DrawCheatsMenu() {
+    LoadOnce();
+    for (Cheat& cheat : g_cheats) {
+        bool on = cheat.on.load(std::memory_order_relaxed);
+        if (ImGui::Checkbox(cheat.name, &on)) {
+            cheat.on.store(on, std::memory_order_relaxed);
+            RuntimeConfigFile::WriteSetting("mods", cheat.key, on ? "true" : "false");
+        }
+        ImGui::Indent();
+        ImGui::TextDisabled("%s", cheat.description);
+        ImGui::Unindent();
+    }
+    ImGui::Separator();
+    ImGui::TextDisabled("Changes apply right away and are kept for the next time you play.");
+}
+
+bool Always() { return true; }
+
+const bool kCheatsMenu = (GameMods::RegisterCheatsPanel({"Cheats", Always, DrawCheatsMenu}), true);
+
+} // namespace
+} // namespace AnimalParadeCheats
+
+void AnimalParadeCheatsEveryFrame() {
+    using namespace AnimalParadeCheats;
+    if (!InfiniteStamina() && !InfiniteMoney() && !InfiniteLumber() && !InfiniteStone() &&
+        !InfiniteFeed()) {
+        return;
+    }
+    const uint32_t state = Memory::Read32(kGameState);
+    if (state == 0 || !Memory::Contains(state, kStaminaMaximum + 4)) {
+        return;
+    }
+    if (InfiniteMoney() && Memory::Read32(state + kMoney) < kMoneyKept) {
+        Memory::Write32(state + kMoney, kMoneyKept);
+    }
+    if (InfiniteStamina()) {
+        const uint32_t maximum = Memory::Read32(state + kStaminaMaximum);
+        if (maximum != 0 && Memory::Read32(state + kStamina) != maximum) {
+            Memory::Write32(state + kStamina, maximum);
+        }
+    }
+    if (InfiniteLumber()) {
+        Fill(state, kLumber);
+    }
+    if (InfiniteStone()) {
+        Fill(state, kMaterialStone);
+    }
+    if (InfiniteFeed()) {
+        Fill(state, kFodder);
+        Fill(state, kBirdFeed);
+    }
+}
+
+// 0x80107944: two seconds of game time. Left out when the field's update calls it and the clock is
+// stopped.
+extern "C" void AnimalParadeClockTick(CpuContext* ctx) {
+    using namespace AnimalParadeCheats;
+    if (StopTime() && ctx->lr == kFieldTickReturn) {
+        return;
+    }
+    GuestFunctions::BaseTranslation(0x80107944u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 80107944, AnimalParadeClockTick);
