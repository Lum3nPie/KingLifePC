diff --git a/runtime/src/hle/gx/gx_frame_trace.cpp b/runtime/src/hle/gx/gx_frame_trace.cpp
new file mode 100644
index 0000000..8a02701
--- /dev/null
+++ b/runtime/src/hle/gx/gx_frame_trace.cpp
@@ -0,0 +1,149 @@
+#include "gx_frame_trace.h"
+
+#include "runtime_log.h"
+
+#include <atomic>
+#include <cstdarg>
+#include <chrono>
+#include <cstdio>
+
+namespace GxFrameTrace {
+namespace {
+std::atomic<int> g_framesLeft{0};
+std::atomic<int> g_frame{0};
+std::atomic<int> g_line{0};
+std::atomic<int> g_session{0};
+// A frame of a busy scene can bind thousands of textures; past this many lines the rest of the
+// frame is only counted, so the log stays readable.
+constexpr int kLinesPerFrame = 40000;
+
+// Frame watch: the draws of each frame are counted all the time. A frame with far fewer draws than the
+// recent frames usually has something missing (a character or an object that blinks out for a frame),
+// and it is reported with the time since start-up so it can be matched with what was seen on screen.
+std::atomic<int> g_drawsThisFrame{0};
+constexpr int kWarmUpFrames = 120;
+constexpr int kMaxWatchReports = 300;
+constexpr double kSlowFrameMs = 90.0;
+
+// One F9 press also arms a series of traces, one every couple of seconds, for a problem that has to be
+// caught while the player is busy walking and cannot press F9 again.
+constexpr int kAutoTraces = 10;
+constexpr int kAutoGapFrames = 60;
+std::atomic<int> g_autoTracesLeft{0};
+int g_framesSinceAuto = 0;
+} // namespace
+
+static void StartTrace(int frames) {
+    g_session.fetch_add(1);
+    g_frame.store(0);
+    g_line.store(0);
+    g_framesLeft.store(frames);
+    RT_LOGF(RT_TAG_GX, "[gx-trace] tracing the next %d frames\n", frames);
+}
+
+void Request(int frames) {
+    g_autoTracesLeft.store(kAutoTraces);
+    g_framesSinceAuto = 0;
+    StartTrace(frames);
+}
+
+bool Active() { return g_framesLeft.load(std::memory_order_relaxed) > 0; }
+
+int Frame() { return g_frame.load(); }
+
+int Session() { return g_session.load(); }
+
+void Note(const char* format, ...) {
+    if (!Active()) {
+        return;
+    }
+    const int line = g_line.fetch_add(1);
+    if (line > kLinesPerFrame) {
+        return;
+    }
+    char text[512];
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(text, sizeof(text), format, args);
+    va_end(args);
+    if (line == kLinesPerFrame) {
+        RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d: more than %d lines, the rest is left out\n", g_frame.load(),
+                kLinesPerFrame);
+        return;
+    }
+    RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d: %s\n", g_frame.load(), text);
+}
+
+void CountDraw() { g_drawsThisFrame.fetch_add(1, std::memory_order_relaxed); }
+
+namespace {
+void WatchFrame() {
+    using Clock = std::chrono::steady_clock;
+    static const auto start = Clock::now();
+    static auto lastFrame = start;
+    static double usual = 0.0;
+    static int frames = 0;
+    static int reports = 0;
+    static int lowRunStart = 0;
+    static int lowRunMin = 0;
+
+    const auto now = Clock::now();
+    const double seconds = std::chrono::duration<double>(now - start).count();
+    const double frameMs = std::chrono::duration<double, std::milli>(now - lastFrame).count();
+    lastFrame = now;
+    const int draws = g_drawsThisFrame.exchange(0);
+    ++frames;
+    if (frames <= kWarmUpFrames) {
+        usual = usual == 0.0 ? draws : usual * 0.9 + draws * 0.1;
+        return;
+    }
+
+    // A frame that took far longer than the others (a shader being built, a stall) is reported.
+    if (frameMs > kSlowFrameMs && reports < kMaxWatchReports) {
+        ++reports;
+        RT_LOGF(RT_TAG_GX, "[frame-watch] frame %d at %.2f s: slow frame, %.0f ms since the one before\n", frames,
+                seconds, frameMs);
+    }
+
+    // Frames with far fewer draws than usual are reported once, when the run of them ends, with its length.
+    // A run of a few frames is something missing for a moment; a long run is a different screen (a menu,
+    // a fade), which is also normal.
+    const bool low = draws < usual * 0.75;
+    if (low) {
+        if (lowRunStart == 0) {
+            lowRunStart = frames;
+            lowRunMin = draws;
+        }
+        lowRunMin = draws < lowRunMin ? draws : lowRunMin;
+        return; // a short frame does not pull the usual number down
+    }
+    if (lowRunStart != 0 && reports < kMaxWatchReports) {
+        ++reports;
+        RT_LOGF(RT_TAG_GX,
+                "[frame-watch] frames %d-%d at %.2f s: %d frames with fewer draws (down to %d, the usual is about %d)\n",
+                lowRunStart, frames - 1, seconds, frames - lowRunStart, lowRunMin, static_cast<int>(usual));
+    }
+    lowRunStart = 0;
+    usual = usual * 0.95 + draws * 0.05;
+}
+} // namespace
+
+void EndFrame() {
+    WatchFrame();
+    if (!Active() && g_autoTracesLeft.load() > 0 && ++g_framesSinceAuto >= kAutoGapFrames) {
+        g_framesSinceAuto = 0;
+        g_autoTracesLeft.fetch_sub(1);
+        StartTrace(3);
+    }
+    if (!Active()) {
+        return;
+    }
+    RT_LOGF(RT_TAG_GX, "[gx-trace] frame %d ends (%d lines)\n", g_frame.load(), g_line.load());
+    g_frame.fetch_add(1);
+    g_line.store(0);
+    if (g_framesLeft.fetch_sub(1) == 1) {
+        RT_LOGF(RT_TAG_GX, "[gx-trace] done\n");
+    }
+}
+
+} // namespace GxFrameTrace
