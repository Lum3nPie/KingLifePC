+// Character shadows of My Life as a King (WFCPGD): resolution and soft edges (F10 > Graphics).
+//
+// The world renderer (System 0x802B1B78 + 0x1730) keeps one shadow map at +0x5190, built by
+// 0x800B1D88: +0x04/+0x06 its size (1 << 9 = 512 square), +0x08 the A8 texture the shadows are
+// copied to, +0x0C a falloff texture made on the CPU, +0x58/+0x5C the half extents of its
+// orthographic light camera (16 x 16 world units, near 20, far 80), +0x84 the shadow colour.
+// Each frame 0x800B235C (from 0x80038B68) draws the shadow casters flat into the top-left 512 x 512
+// of the EFB, and 0x800B256C (first thing of the scene draw, 0x80038BF4) copies that corner to the A8
+// texture with clear; the ground then projects it under the characters (0x800B2228 / 0x800B1720).
+//
+// In the port that corner is drawn at the picture's internal resolution, with hard aliased edges.
+// Here the casters are drawn into an offscreen target of their own instead, at the chosen size, and
+// copied to the game's texture right away, blurred when soft shadows are on. The game's own copy that
+// follows is skipped (its corner of the EFB was never drawn into).
+#include "hle_stubs.h"
+#include "memory.h"
+#include "gx/gx_internal.h"
+
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "runtime_log.h"
+
+#include <dolphin/gx/GXAurora.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+extern "C" void GX__SetTexCopySrc_8016f478(uint32_t l, uint32_t t, uint32_t w, uint32_t h);
+extern "C" void GX__SetTexCopyDst_8016f4dc(uint32_t w, uint32_t h, uint32_t f, uint32_t m);
+extern "C" void GX__CopyTex_8016fd74(uint32_t da, uint32_t c);
+extern "C" void GX__InvalidateTexAll_80171110();
+extern "C" void GX__InitTexObj_801707f8(uint32_t oa, uint32_t da, uint32_t w, uint32_t h, uint32_t f, uint32_t ws,
+                                        uint32_t wt, uint32_t m);
+extern "C" void GX__InitTexObjLOD_80170a4c(uint32_t oa, uint32_t mif, uint32_t maf, float mil, float mal, float lb,
+                                           uint32_t bc, uint32_t el, uint32_t ma);
+
+namespace {
+constexpr uint32_t kDrawShadowMap = 0x800B235Cu;
+constexpr uint32_t kGxCtfA8 = 0x27u;
+// Blur sigma at 100% softness, in texels of the game's 512 map (16 world units across 512).
+constexpr float kMaxSoftnessTexels = 3.0f;
+
+std::atomic<int> g_resolution{4096};  // pixels across; 0 = the picture's own scale
+std::atomic<float> g_softness{0.0f};  // percent; 0 = hard
+std::atomic<uint32_t> g_skipCopyDest{0};
+int g_loggedResolution = -1;
+float g_loggedSoftness = -1.0f;
+} // namespace
+
+void LifeKing_HLE_SetShadowResolution(int pixels) {
+    g_resolution.store(std::clamp(pixels, 0, 8192), std::memory_order_relaxed);
+}
+
+void LifeKing_HLE_SetShadowSoftness(float percent) {
+    if (!std::isfinite(percent)) percent = 0.0f;
+    g_softness.store(std::clamp(percent, 0.0f, 100.0f), std::memory_order_relaxed);
+}
+
+bool LifeKing_HLE_SkipShadowCopy(uint32_t dest) {
+    if (dest == 0) {
+        return false;
+    }
+    uint32_t expected = dest;
+    return g_skipCopyDest.compare_exchange_strong(expected, 0u, std::memory_order_relaxed);
+}
+
+// --- Two cascades --------------------------------------------------------------------------------
+// The game's one shadow map covers a square of +-16 world units around the point the camera looks at
+// (half extents at map +0x58 x, +0x5C y; 0x800B2070 sets its orthographic light camera up, centred on
+// r6, worked out just before the call at 0x800365C0). Shadows past it were missing, at the sides with
+// a wider view and far away always, and one map large enough for everything made the near shadows
+// blocky. So there are two maps, both seen by the same light camera, only framed differently:
+//   - near: the game's own square (times the field of view scale above 100%), sharp as before;
+//   - far: 6 times larger, moved forward so it runs from just behind the camera to far in front of it,
+//     with the near square cleared out of it so the two never darken the same ground twice.
+// The far map is the game's own (texture at map +0x08, texture object +0x10, light camera slot r7 of
+// 0x800B1720). The near map is ours: a second texture and texture object (made with the map,
+// 0x800B1D88), and the light camera framed for it copied into camera 31 of the scene (ScnRoot +0xF8 +
+// 0x10C * i; 30 if the light is camera 31): the scene hands all its cameras to nw4r's slots before it
+// draws (0x801C6558 -> G3DState 0x8034CD60), and the game's projection callback (0x800B0FC0, mapping
+// 0x20) turns that slot into the lookup matrix. Every ground material the game gives a
+// shadow (0x800B1720: one texture coordinate, two textures, three TEV stages ending in
+// lerp(previous, shadow colour, shadow)) gets the same once more for the near map, so the two blend in
+// turn. LIFEKING_SHADOW_CASCADES=0 keeps one large map instead.
+namespace {
+constexpr uint32_t kSetupShadowCamera = 0x800B2070u;
+constexpr uint32_t kCreateShadowMap = 0x800B1D88u;
+constexpr uint32_t kAddShadowToMaterial = 0x800B1720u;
+constexpr uint32_t kGameNewArray = 0x8009210Cu;  // operator new[](size, align, heap)
+constexpr float kFarReach = 6.0f;
+constexpr float kFarForward = 0.6f;  // the far square's centre, in half extents ahead of the camera
+constexpr uint32_t kCameraDataWords = 0x10C / 4;
+constexpr uint8_t kMaterialShadowMark = 0xC3;  // what 0x800B1720 leaves at the material's TEV + 0x1F
+
+// Test switches while the two maps are being made to work: LIFEKING_SHADOW_CASCADES=1 turns them on
+// (one large map otherwise), LIFEKING_SHADOW_TEST adds up 1 (no hole in the far map), 2 (no second
+// series on the materials), 4 (no near map drawn).
+bool CascadesOn() {
+    static const bool on = [] {
+        const char* value = std::getenv("LIFEKING_SHADOW_CASCADES");
+        const bool enabled = value != nullptr && std::strcmp(value, "1") == 0;
+        RT_LOGF("lifeking", "shadows: %s\n", enabled ? "two cascades (LIFEKING_SHADOW_CASCADES=1, test)"
+                                                     : "one large map (LIFEKING_SHADOW_CASCADES=1 for two)");
+        return enabled;
+    }();
+    return on;
+}
+
+int CascadeTest() {
+    static const int mask = [] {
+        const char* value = std::getenv("LIFEKING_SHADOW_TEST");
+        const int bits = value != nullptr ? std::atoi(value) : 0;
+        if (bits != 0) RT_LOGF("lifeking", "shadows: test %d (1 no hole, 2 no second series, 4 no near map)\n", bits);
+        return bits;
+    }();
+    return mask;
+}
+
+// The first frames with two maps: what they were set to (for the log).
+int g_cascadeLogFrames = 3;
+
+struct Cascades {
+    uint32_t nearImage = 0;    // guest texture buffer of the near map
+    uint32_t nearTexObj = 0;   // its GXTexObj
+    uint32_t scratchDest = 0;  // copy destinations for the clearing copies, one per size (+0, +0x20, +0x40)
+    uint32_t farFalloffTexObj = 0;  // a flat falloff for the far map (see LifeKing_AddShadowToMaterial)
+    uint32_t nearSlot = 31;    // the scene camera that carries the near framing
+    uint32_t cameraData = 0;   // the light camera's nw4r CameraData this frame
+    uint32_t nearCamera[kCameraDataWords] = {};
+    uint32_t farCamera[kCameraDataWords] = {};
+    bool valid = false;        // both framings were set up at least once
+    uint32_t materials = 0, materialsFull = 0;
+};
+Cascades g_cascades;
+
+bool IsGuestPointer(uint32_t address) {
+    return (address >= 0x80000000u && address < 0x81800000u) || (address >= 0x90000000u && address < 0x94000000u);
+}
+
+void SaveCamera(uint32_t* out, uint32_t data) {
+    for (uint32_t i = 0; i < kCameraDataWords; ++i) out[i] = Memory::Read32(data + i * 4u);
+}
+
+void LoadCamera(uint32_t data, const uint32_t* in) {
+    for (uint32_t i = 0; i < kCameraDataWords; ++i) Memory::Write32(data + i * 4u, in[i]);
+}
+
+// A float of a saved CameraData (the words are kept as the guest has them, read with Read32).
+float Word(const uint32_t* camera, uint32_t offset) {
+    float value;
+    std::memcpy(&value, &camera[offset / 4u], sizeof(value));
+    return value;
+}
+
+// Copies a rectangle of the map (in its texels) with clear: that clears it.
+// Each kind of rectangle has a destination of its own: a copy texture changing size every call would be
+// made anew every time.
+void ClearMapRect(uint32_t x0, uint32_t y0, uint32_t x1, uint32_t y1, uint32_t kind) {
+    if (x1 <= x0 || y1 <= y0 || g_cascades.scratchDest == 0) return;
+    GX__SetTexCopySrc_8016f478(x0, y0, x1 - x0, y1 - y0);
+    GX__SetTexCopyDst_8016f4dc(x1 - x0, y1 - y0, kGxCtfA8, 0);
+    GX__CopyTex_8016fd74(g_cascades.scratchDest + kind * 0x20u, 1);
+}
+} // namespace
+
+// Makes the shadow map (0x800B1D88), then the near map's texture beside it.
+extern "C" void LifeKing_CreateShadowMap(CpuContext* ctx) {
+    const uint32_t map = ctx->gpr[3];
+    GuestFunctions::BaseTranslation(kCreateShadowMap)(ctx);
+    if (!CascadesOn() || map == 0 || g_cascades.nearTexObj != 0) return;
+    const uint32_t width = Memory::Read16(map + 0x04u), height = Memory::Read16(map + 0x06u);
+    if (width == 0 || height == 0 || width > 1024 || height > 1024) return;
+    const uint32_t imageSize = (width * height + 31u) & ~31u;  // I8, as the game's
+    const CpuContext saved = *ctx;
+    ctx->gpr[3] = 2u * imageSize + 0x80u;  // near map, flat falloff, their texture objects, scratch
+    ctx->gpr[4] = 0x20u;
+    ctx->gpr[5] = 1u;
+    GuestFunctions::BaseTranslation(kGameNewArray)(ctx);
+    const uint32_t block = ctx->gpr[3];
+    *ctx = saved;
+    if (!IsGuestPointer(block)) {
+        RT_LOGF("lifeking", "shadows: no memory for the near map, one map only\n");
+        return;
+    }
+    g_cascades.nearImage = block;
+    const uint32_t falloffImage = block + imageSize;
+    g_cascades.nearTexObj = block + 2u * imageSize;
+    g_cascades.farFalloffTexObj = block + 2u * imageSize + 0x20u;
+    g_cascades.scratchDest = block + 2u * imageSize + 0x40u;
+    // The game's falloff (made by 0x800B1D88 at map +0x0C) grows down the map's rows, 6 * sqrt(row): a
+    // shadow's strength depends on where in the square it falls, from 0 at the top to 135 / 255 at the
+    // bottom. Over the far square that made distant shadows faint, so the far map gets the bottom's.
+    const uint32_t middle = static_cast<uint32_t>(6.0 * std::sqrt(static_cast<double>(height - 1u)));
+    const uint32_t fill = middle * 0x01010101u;
+    for (uint32_t i = 0; i < imageSize; i += 4u) Memory::Write32(falloffImage + i, fill);
+    GX__InitTexObj_801707f8(g_cascades.farFalloffTexObj, falloffImage, width, height, 1, 0, 0, 0);
+    GX__InitTexObjLOD_80170a4c(g_cascades.farFalloffTexObj, 1, 1, 0.0f, 0.0f, 0.0f, 0, 0, 0);
+    g_cascades.nearSlot = Memory::Read32(map + 0x88u) == 31u ? 30u : 31u;  // +0x88: the light's camera
+    GX__InitTexObj_801707f8(g_cascades.nearTexObj, g_cascades.nearImage, width, height, 1, 0, 0, 0);
+    GX__InitTexObjLOD_80170a4c(g_cascades.nearTexObj, 1, 1, 0.0f, 0.0f, 0.0f, 0, 0, 0);
+    RT_LOGF("lifeking", "shadows: near map %ux%u at %08X\n", width, height, block);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800B1D88, LifeKing_CreateShadowMap);
+
+// Gives a ground material its shadow (0x800B1720: r3 the material, r4/r5 the map's two texture
+// objects, r6 the shadow colour, r7 the light camera's slot), then once more for the near map.
+extern "C" void LifeKing_AddShadowToMaterial(CpuContext* ctx) {
+    if (!CascadesOn() || g_cascades.nearTexObj == 0 || (CascadeTest() & 2) != 0) {
+        GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+        return;
+    }
+    const uint32_t material = Memory::Read32(ctx->gpr[3]);
+    const uint32_t tevOffset = IsGuestPointer(material) ? Memory::Read32(material + 0x28u) : 0;
+    const uint32_t tev = tevOffset != 0 ? material + tevOffset : 0;
+    if (tev == 0) {
+        GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+        return;
+    }
+    const uint8_t mark = Memory::Read8(tev + 0x1Fu);
+    if (mark == kMaterialShadowMark) {
+        // The TEV is shared with a material that already got its series: the game then only gives
+        // this material its own parts (texture coordinate, textures, stage count) and checks that the
+        // TEV has its stage count + 3 stages (TEV +0xC; the material's count is at +0x16). With both
+        // series the TEV has + 6, so for the game's series the TEV count shows + 3, then + 6.
+        const uint8_t tevStages = Memory::Read8(tev + 0x0Cu);
+        const uint8_t ownStages = Memory::Read8(material + 0x16u);
+        if (tevStages == ownStages + 3u) {
+            GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);  // one series only
+            return;
+        }
+        if (tevStages != ownStages + 6u) {
+            return;  // this material already has its parts
+        }
+        const uint32_t textures = Memory::Read32(material + 0x2Cu);
+        if (textures + 3u > 7u) {
+            return;  // cannot happen with a TEV that has both, but never assert
+        }
+        const CpuContext shared = *ctx;
+        Memory::Write8(tev + 0x0Cu, static_cast<uint8_t>(ownStages + 3u));
+        ctx->gpr[5] = g_cascades.farFalloffTexObj;
+        GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+        const CpuContext afterShared = *ctx;
+        Memory::Write8(tev + 0x0Cu, tevStages);
+        *ctx = shared;
+        Memory::Write32(material + 0x2Cu, textures + 2u);
+        ctx->gpr[4] = g_cascades.nearTexObj;
+        ctx->gpr[7] = g_cascades.nearSlot;
+        GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+        Memory::Write32(material + 0x2Cu, textures);
+        *ctx = afterShared;
+        ++g_cascades.materials;
+        return;
+    }
+    const CpuContext saved = *ctx;
+    ctx->gpr[5] = g_cascades.farFalloffTexObj;
+    GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+    if (Memory::Read8(tev + 0x1Fu) != kMaterialShadowMark) {
+        return;  // the game could not add it (too many stages already)
+    }
+    // 0x800B1720 puts its two textures at the material's texture count (ResMat +0x2C) and the one
+    // after, without counting them (it asserts that those texture slots are still free). The near
+    // map's two go two further: the count is raised by 2 for that call and put back.
+    const uint32_t textures = Memory::Read32(material + 0x2Cu);
+    if (textures + 3u > 7u) {
+        ++g_cascades.materialsFull;
+        if (g_cascades.materialsFull <= 8) {
+            RT_LOGF("lifeking", "shadows: material %08X uses %u textures, no room for the near map\n",
+                    material, textures);
+        }
+        return;
+    }
+    const CpuContext after = *ctx;
+    *ctx = saved;
+    Memory::Write8(tev + 0x1Fu, mark);
+    Memory::Write32(material + 0x2Cu, textures + 2u);
+    ctx->gpr[4] = g_cascades.nearTexObj;
+    ctx->gpr[7] = g_cascades.nearSlot;
+    GuestFunctions::BaseTranslation(kAddShadowToMaterial)(ctx);
+    Memory::Write32(material + 0x2Cu, textures);
+    const bool both = Memory::Read8(tev + 0x1Fu) == kMaterialShadowMark;
+    Memory::Write8(tev + 0x1Fu, kMaterialShadowMark);
+    *ctx = after;
+    ++g_cascades.materials;
+    if (!both) {
+        ++g_cascades.materialsFull;
+        if (g_cascades.materialsFull <= 8) {
+            RT_LOGF("lifeking", "shadows: material %08X has no room for the near map; far map only there\n",
+                    material);
+        }
+    }
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800B1720, LifeKing_AddShadowToMaterial);
+
+// --- Shadow distance (one map) -------------------------------------------------------------------
+// F10 Shadow distance: Near keeps the game's square (times the field of view scale above 100%, for the
+// sides), Medium makes it 3 times larger and Far 6 times, both moved forward so they run from just
+// behind the camera to far in front of it. A larger square spreads the same map over more ground, so
+// each shadow gets fewer texels. The game's falloff (map +0x0C, filled by 0x800B1D88 with 6 * sqrt(row)
+// along its bytes) makes a shadow's strength depend on where in the square it falls; stretched over a
+// larger square it left distant shadows faint, so Medium and Far fill it with its strongest value
+// (135 / 255) and Near puts the game's back.
+namespace {
+constexpr float kShadowReach[] = {1.0f, 3.0f, 6.0f};
+std::atomic<int> g_shadowDistance{1};
+int g_falloffLevel = -1;  // what the game's falloff texture holds now
+
+void FillFalloff(uint32_t map, int level) {
+    const uint32_t width = Memory::Read16(map + 0x04u), height = Memory::Read16(map + 0x06u);
+    const uint32_t image = Memory::Read32(map + 0x0Cu);
+    if (!IsGuestPointer(image) || width == 0 || height == 0 || width > 1024 || height > 1024) return;
+    const uint32_t size = width * height;
+    for (uint32_t i = 0; i < size; i += 4u) {
+        uint32_t word = 0;
+        for (uint32_t b = 0; b < 4u; ++b) {
+            const uint32_t row = (i + b) / width;
+            const uint32_t value = level == 0 ? static_cast<uint32_t>(6.0 * std::sqrt(static_cast<double>(row)))
+                                              : static_cast<uint32_t>(6.0 * std::sqrt(static_cast<double>(height - 1u)));
+            word = (word << 8) | (value & 0xFFu);
+        }
+        Memory::Write32(image + i, word);
+    }
+    GX__InvalidateTexAll_80171110();
+    g_falloffLevel = level;
+}
+} // namespace
+
+void LifeKing_HLE_SetShadowDistance(int level) {
+    g_shadowDistance.store(std::clamp(level, 0, 2), std::memory_order_relaxed);
+}
+
+// Sets the light camera up (0x800B2070: r3 the map, r4 the scene, r5 the camera, r6 the centre), once
+// for each map.
+extern "C" void LifeKing_SetupShadowCamera(CpuContext* ctx) {
+    const uint32_t map = ctx->gpr[3];
+    const uint32_t centre = ctx->gpr[6];
+    const uint32_t data = ctx->gpr[5] != 0 ? Memory::Read32(ctx->gpr[5]) : 0;
+    if (map == 0 || centre == 0 || !IsGuestPointer(data)) {
+        GuestFunctions::BaseTranslation(kSetupShadowCamera)(ctx);
+        return;
+    }
+    const float fov = std::max(GX_HLE_FieldOfViewScale(), 1.0f);
+    const float x = Memory::ReadFloat32(map + 0x58u), y = Memory::ReadFloat32(map + 0x5Cu);
+    float oldCentre[3];
+    for (uint32_t i = 0; i < 3; ++i) oldCentre[i] = Memory::ReadFloat32(centre + i * 4u);
+    const bool cascades = CascadesOn() && g_cascades.nearTexObj != 0;
+    const CpuContext saved = *ctx;
+
+    if (cascades) {
+        Memory::WriteFloat32(map + 0x58u, x * fov);
+        Memory::WriteFloat32(map + 0x5Cu, y * fov);
+        GuestFunctions::BaseTranslation(kSetupShadowCamera)(ctx);
+        SaveCamera(g_cascades.nearCamera, data);
+        // The scene camera that hands the near framing to the ground's lookup (r4: the scene).
+        const uint32_t scene = saved.gpr[4];
+        if (IsGuestPointer(scene)) {
+            LoadCamera(scene + 0xF8u + 0x10Cu * g_cascades.nearSlot, g_cascades.nearCamera);
+        }
+        *ctx = saved;
+    }
+
+    // The far one: larger, and moved forward. The main camera: the renderer is map - 0x5190, its camera
+    // the one numbered at +0x5218, its nw4r CameraData at camera +0xC (position +0x74, target +0x8C).
+    const int level = cascades ? 2 : std::clamp(g_shadowDistance.load(std::memory_order_relaxed), 0, 2);
+    if (!cascades && level != g_falloffLevel) FillFalloff(map, level);
+    const float reach = cascades ? kFarReach : kShadowReach[level];
+    const float wideX = x * fov * reach, wideY = y * fov * reach;
+    Memory::WriteFloat32(map + 0x58u, wideX);
+    Memory::WriteFloat32(map + 0x5Cu, wideY);
+    const uint32_t renderer = map - 0x5190u;
+    const uint32_t camera = renderer + Memory::Read32(renderer + 0x5218u) * 0x22Cu + 0xA84u;
+    const uint32_t mainData = Memory::Read32(camera + 0xCu);
+    if (level > 0 && IsGuestPointer(mainData)) {
+        const float px = Memory::ReadFloat32(mainData + 0x74u), pz = Memory::ReadFloat32(mainData + 0x7Cu);
+        const float dx = Memory::ReadFloat32(mainData + 0x8Cu) - px;
+        const float dz = Memory::ReadFloat32(mainData + 0x94u) - pz;
+        const float length = std::sqrt(dx * dx + dz * dz);
+        if (std::isfinite(length) && length > 1e-4f) {
+            const float ahead = std::min(wideX, wideY) * kFarForward;
+            Memory::WriteFloat32(centre + 0u, px + dx / length * ahead);
+            Memory::WriteFloat32(centre + 8u, pz + dz / length * ahead);
+        }
+    }
+    GuestFunctions::BaseTranslation(kSetupShadowCamera)(ctx);
+    if (cascades) {
+        SaveCamera(g_cascades.farCamera, data);
+        g_cascades.cameraData = data;
+        g_cascades.valid = true;
+    }
+
+    Memory::WriteFloat32(map + 0x58u, x);
+    Memory::WriteFloat32(map + 0x5Cu, y);
+    for (uint32_t i = 0; i < 3; ++i) Memory::WriteFloat32(centre + i * 4u, oldCentre[i]);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800B2070, LifeKing_SetupShadowCamera);
+
+extern "C" void LifeKing_DrawShadowMap(CpuContext* ctx) {
+    g_skipCopyDest.store(0, std::memory_order_relaxed);
+    const uint32_t map = ctx->gpr[3];
+    const int resolution = g_resolution.load(std::memory_order_relaxed);
+    const float softness = g_softness.load(std::memory_order_relaxed);
+    const uint32_t width = map != 0 ? Memory::Read16(map + 0x04u) : 0;
+    const uint32_t height = map != 0 ? Memory::Read16(map + 0x06u) : 0;
+    const uint32_t dest = map != 0 ? Memory::Read32(map + 0x08u) : 0;
+    const uint32_t cameraData = ctx->gpr[7] != 0 ? Memory::Read32(ctx->gpr[7]) : 0;
+    // The framings last set up: while the game is paused it draws the map without setting the light up,
+    // and the near map and the hole have to stay, or both maps shade the near square.
+    const bool cascades = g_cascades.valid && cameraData == g_cascades.cameraData && g_cascades.nearImage != 0;
+    // Two maps need the offscreen path; without a resolution of its own it is drawn at the picture's.
+    const bool own = (resolution > 0 || softness > 0 || cascades) && width >= 16 && height >= 16 && width <= 640 &&
+                     height <= 528 && dest != 0;
+    if (!own) {
+        GuestFunctions::BaseTranslation(kDrawShadowMap)(ctx);
+        return;
+    }
+
+    // The offscreen size: the chosen one across the larger side, or 0 for the EFB's own scale.
+    const uint32_t larger = std::max(width, height);
+    const uint32_t targetWidth = resolution > 0 ? static_cast<uint32_t>(resolution) * width / larger : 0;
+    const uint32_t targetHeight = resolution > 0 ? static_cast<uint32_t>(resolution) * height / larger : 0;
+    const float blurPercent = softness;
+    const float blurTexels = kMaxSoftnessTexels * blurPercent / 100.0f;
+    if (resolution != g_loggedResolution || blurPercent != g_loggedSoftness) {
+        g_loggedResolution = resolution;
+        g_loggedSoftness = blurPercent;
+        RT_LOGF("lifeking", "shadow map %ux%u drawn at %s, soft %.2f%% (blur %.2f texels)%s\n", width, height,
+                resolution > 0 ? std::to_string(resolution).c_str() : "picture scale", blurPercent, blurTexels,
+                cascades ? ", near and far maps" : "");
+    }
+
+    const CpuContext saved = *ctx;
+    EnsureAuroraFrameActive();
+    if (cascades) LoadCamera(cameraData, g_cascades.farCamera);
+    GxWorker::Run([=] { GXCreateFrameBufferLogical(targetWidth, targetHeight, width, height); });
+    GuestFunctions::BaseTranslation(kDrawShadowMap)(ctx);
+    if (cascades) {
+        // Clear the near square out of the far map. Both cameras look the same way, so it is where the
+        // far camera sees the near camera, near half extents wide (in the far map's texels).
+        const uint32_t* farCam = g_cascades.farCamera;
+        const uint32_t* nearCam = g_cascades.nearCamera;
+        float nv[12], fv[12];
+        for (uint32_t i = 0; i < 12; ++i) {
+            nv[i] = Word(nearCam, i * 4u);
+            fv[i] = Word(farCam, i * 4u);
+        }
+        // The near camera's position: -R^T t of its view matrix.
+        float p[3];
+        for (int c = 0; c < 3; ++c) p[c] = -(nv[0 * 4 + c] * nv[3] + nv[1 * 4 + c] * nv[7] + nv[2 * 4 + c] * nv[11]);
+        const float fx = fv[0] * p[0] + fv[1] * p[1] + fv[2] * p[2] + fv[3];
+        const float fy = fv[4] * p[0] + fv[5] * p[1] + fv[6] * p[2] + fv[7];
+        const float farX = Word(farCam, 0xC8u), farY = Word(farCam, 0xBCu);  // right, top
+        const float nearX = Word(nearCam, 0xC8u), nearY = Word(nearCam, 0xBCu);
+        if (farX > 0.0f && farY > 0.0f && nearX > 0.0f && nearY > 0.0f && std::isfinite(fx) && std::isfinite(fy)) {
+            const float w = static_cast<float>(width), h = static_cast<float>(height);
+            const float cx = (0.5f + 0.5f * fx / farX) * w, cy = (0.5f - 0.5f * fy / farY) * h;
+            const float hw = nearX / farX * 0.5f * w, hh = nearY / farY * 0.5f * h;
+            const auto texel = [](float v, float size) {
+                return static_cast<uint32_t>(std::clamp(v, 0.0f, size));
+            };
+            const uint32_t x0 = texel(std::ceil(cx - hw), w), y0 = texel(std::ceil(cy - hh), h);
+            const uint32_t x1 = texel(std::floor(cx + hw), w), y1 = texel(std::floor(cy + hh), h);
+            if (g_cascadeLogFrames > 0) {
+                --g_cascadeLogFrames;
+                RT_LOGF("lifeking", "shadows: far %.1fx%.1f near %.1fx%.1f, near camera at %.2f,%.2f,%.2f seen at "
+                        "%.2f,%.2f by the far one, hole %u,%u..%u,%u of %ux%u, near slot %u\n",
+                        farX, farY, nearX, nearY, p[0], p[1], p[2], fx, fy, x0, y0, x1, y1, width, height,
+                        g_cascades.nearSlot);
+            }
+            // Rounded inwards: a texel outwards would leave a ring with no shadow at all.
+            if ((CascadeTest() & 1) == 0) {
+                GxWorker::Run([] { GXSetCopyOverride(0.0f, GX_TRUE); });
+                ClearMapRect(x0, y0, x1, y1, 0);
+            }
+        }
+    }
+    // The game's own copy (0x800B256C): its corner, as A8, with clear and without the copy filter.
+    GxWorker::Run([=] { GXSetCopyOverride(blurTexels, GX_TRUE); });
+    GX__SetTexCopySrc_8016f478(0, 0, width, height);
+    GX__SetTexCopyDst_8016f4dc(width, height, kGxCtfA8, 0);
+    GX__CopyTex_8016fd74(dest, 1);
+    GxWorker::Run([] {
+        GXSetCopyOverride(0.0f, GX_FALSE);
+        GXRestoreFrameBuffer();
+    });
+
+    if (cascades && (CascadeTest() & 4) == 0) {
+        // The near map: the same light camera, framed as the game frames it.
+        *ctx = saved;
+        LoadCamera(cameraData, g_cascades.nearCamera);
+        // A clear one-texel border, as outside its square the near map is sampled at its edge (clamp):
+        // the camera's scissor (CameraData +0xF4 x, +0xF8 y, +0xFC width, +0x100 height, set by
+        // 0x801C1EC0) keeps the casters one texel in, and the copy with clear of the frame before left
+        // that edge empty. Copies that clear a strip each cost a whole pass at this size.
+        const uint32_t sx = Memory::Read32(cameraData + 0xF4u), sy = Memory::Read32(cameraData + 0xF8u);
+        const uint32_t sw = Memory::Read32(cameraData + 0xFCu), sh = Memory::Read32(cameraData + 0x100u);
+        if (sw > 2u && sh > 2u && sw <= width && sh <= height) {
+            Memory::Write32(cameraData + 0xF4u, sx + 1u);
+            Memory::Write32(cameraData + 0xF8u, sy + 1u);
+            Memory::Write32(cameraData + 0xFCu, sw - 2u);
+            Memory::Write32(cameraData + 0x100u, sh - 2u);
+        }
+        // Half the size: it covers a sixth of the far map's ground, so it is still three times as fine.
+        const uint32_t nearWidth = targetWidth / 2u, nearHeight = targetHeight / 2u;
+        GxWorker::Run([=] { GXCreateFrameBufferLogical(nearWidth, nearHeight, width, height); });
+        GuestFunctions::BaseTranslation(kDrawShadowMap)(ctx);
+        GxWorker::Run([=] { GXSetCopyOverride(blurTexels, GX_TRUE); });
+        GX__SetTexCopySrc_8016f478(0, 0, width, height);
+        GX__SetTexCopyDst_8016f4dc(width, height, kGxCtfA8, 0);
+        GX__CopyTex_8016fd74(g_cascades.nearImage, 1);
+        GxWorker::Run([] {
+            GXSetCopyOverride(0.0f, GX_FALSE);
+            GXRestoreFrameBuffer();
+        });
+        LoadCamera(cameraData, g_cascades.farCamera);
+    }
+    g_skipCopyDest.store(dest, std::memory_order_relaxed);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800B235C, LifeKing_DrawShadowMap);
diff --git a/runtime/src/hle/lifeking_title.cpp b/runtime/src/hle/lifeking_title.cpp
new file mode 100644
index 0000000..ca50342
--- /dev/null
+++ b/runtime/src/hle/lifeking_title.cpp
@@ -0,0 +1,41 @@
+// Boot screens of My Life as a King (WFCPGD), as Liara wants them.
+//
+// The game's logo thread (0x800D0FA8, started by 0x800D0F30) runs a small state machine, one step
+// per call of 0x800D125C (r3 the state: +0x04 milliseconds slept per step, +0x08 timer, +0x0C step,
+// +0x10 "a button may skip", +0x14 strap pages shown, +0x24 Square Enix logo pane), while the main
+// thread loads the game:
+//   0x0A..0x1F  the wrist strap warning (strapImage_<language>_LZ.bin, pages A and B, faded in/out)
+//   0x28..0x29  fade out, strap hidden (0x8009C560 with 0, 0)
+//   0x32..0x3D  the Square Enix logo
+//   0x3E..0x3F  waits for the loading to end, then fades out and ends the thread
+// The strap warning is skipped: from step 0x0A (the first after the start) the machine goes straight
+// to 0x29, which waits for the fader (idle: nothing was faded in), hides the strap (never shown) and
+// goes on with the Square Enix logo as before.
+#include "hle_stubs.h"
+#include "memory.h"
+
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "runtime_log.h"
+
+#include <cstdint>
+
+namespace {
+constexpr uint32_t kLogoThreadStep = 0x800D125Cu;
+constexpr uint32_t kStepStrapStart = 0x0Au;
+constexpr uint32_t kStepStrapHidden = 0x29u;
+bool g_strapSkipLogged = false;
+} // namespace
+
+extern "C" void LifeKing_LogoThreadStep(CpuContext* ctx) {
+    const uint32_t state = ctx->gpr[3];
+    if (state != 0 && Memory::Read32(state + 0x0Cu) == kStepStrapStart) {
+        Memory::Write32(state + 0x0Cu, kStepStrapHidden);
+        if (!g_strapSkipLogged) {
+            g_strapSkipLogged = true;
+            RT_LOGF("lifeking", "boot: wrist strap screen skipped\n");
+        }
+    }
+    GuestFunctions::BaseTranslation(kLogoThreadStep)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800D125C, LifeKing_LogoThreadStep);
diff --git a/runtime/src/hle/lifeking_ui_scale.cpp b/runtime/src/hle/lifeking_ui_scale.cpp
new file mode 100644
index 0000000..730ef36
--- /dev/null
+++ b/runtime/src/hle/lifeking_ui_scale.cpp
@@ -0,0 +1,616 @@
+// F10 "UI scale" for My Life as a King (WFCPGD): one size per kind of on-screen element.
+//
+// The game draws all its 2D interface with nw4r::lyt: a few layouts (menu_eu.arc: common, menu_build,
+// menu_report, menu_room, map...) whose panes the scripts look up by name (MenuPane(menu, "com_clk_nul"),
+// rootPaneName = "com_inf_win"...) and move, show and animate. Every frame each pane's matrix is rebuilt
+// by nw4r::lyt::Pane::CalculateMtx (0x801CF6A8, r3 pane, r4 DrawInfo), which then does the same for its
+// children (vtable +0x10; the game's own pane classes 0x80093714 and 0x800C0854 call it first too).
+//
+// Pane fields used (this nw4r build): +0x0C parent, +0x2C/+0x30 translate x/y, +0x44/+0x48 scale x/y,
+// +0x84 global matrix (3x4), +0xBC name (16 chars). DrawInfo: +0x04 view matrix (3x4), +0x34 view rect
+// (left, top, right, bottom; y up). The game's UI projection is x -320..320 (4:3) or -422..422 (16:9),
+// y -224..224 (0x800C2C94).
+//
+// For the root pane of each element of a category, the wrapper scales it around its anchor for the
+// length of the call: the translate moves towards the anchor by the scale and the pane's own scale is
+// multiplied, so the whole element (children included) shrinks while its anchored edge stays where it
+// was. The anchor is a screen corner or edge (taken from the view rect and brought into the parent's
+// space through the parent's matrix), the screen centre, or the pane's own position (speech bubbles,
+// gauges over characters, which follow a character). Translate and scale are put back after, so the
+// game and its scripts never see them changed, and a change in F10 shows on the next frame.
+#include "hle_stubs.h"
+#include "memory.h"
+
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "runtime_log.h"
+
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+#include <unordered_map>
+
+namespace {
+
+enum Category : int {
+    kClock,
+    kNotifications,
+    kDialogue,
+    kSystemMessages,
+    kKeyboard,
+    kMenus,
+    kHelpBar,
+    kTitles,
+    kGauges,
+    kRoomBanner,
+    kCategoryCount,
+};
+
+struct CategoryInfo {
+    const char* key;    // [ui_scale] key
+    const char* label;  // F10 label
+    const char* hint;   // F10 tooltip
+};
+
+constexpr CategoryInfo kCategories[kCategoryCount] = {
+    {"clock", "Clock and resources", "The clock in the top-left corner, with crystals, gil and happiness. Stays in its corner."},
+    {"notifications", "Notifications", "The messages that slide in at the top right. Stay against the right edge."},
+    {"dialogue", "Dialogue boxes", "Speech bubbles (they keep pointing at who talks) and event message windows."},
+    {"system_messages", "System messages", "Save, load and confirmation windows. Stay centred."},
+    {"keyboard", "Keyboard", "The name entry keyboard. Stays centred."},
+    {"menus", "Menus", "Command menus, building menu and hints, title menu, options. Keep their side of the screen."},
+    {"help_bar", "Help bar", "The help line at the bottom of the screen. Stays against the bottom edge."},
+    {"titles", "Chapter titles and boss bar", "Chapter titles (bottom right) and the boss gauge (bottom)."},
+    {"gauges", "Over characters", "Icons over characters (!, smiley, speech...) and their HP and experience gauges."},
+    {"room_banner", "Room name banner", "The sign at the top of a room (\"The Settlement of...\" in the castle). Stays against the top edge."},
+};
+
+// Where an element is kept, per axis.
+enum Anchor : int8_t {
+    kMin = -1,    // left edge / bottom edge
+    kMid = 0,     // screen centre
+    kMax = 1,     // right edge / top edge
+    kSelf = 2,    // the pane's own position (follows a character)
+    kAuto = 3,    // the third of the screen the pane is in (left/centre/right, bottom/centre/top)
+    kBox = 4,     // the centre of the pane's own box (size and origin): shrinks in place, centred
+};
+
+
+struct PaneRule {
+    const char* name;  // pane name; a trailing '*' matches a prefix
+    Category category;
+    Anchor x;
+    Anchor y;
+    // With kSelf: the anchor is this far from the pane's position, in its own units (the tip of a
+    // talk window's tail, which must stay where it points whatever the scale).
+    float selfX = 0.0f;
+    float selfY = 0.0f;
+    // When the scripts leave the pane at its layout x (fromX), it is moved to toX, toY (toX 0: never),
+    // at every scale, 100% included.
+    float fromX = 0.0f;
+    float toX = 0.0f;
+    float toY = 0.0f;
+};
+
+// Root panes of each element (common.brlyt unless noted). A pane under one already scaled is left
+// alone, so naming a child too never scales it twice.
+constexpr PaneRule kRules[] = {
+    {"com_clk_nul", kClock, kMin, kMax},          // clock (origin top-left, at the corner)
+    {"com_clk_inf", kClock, kMin, kMax},          // crystals / gil / happiness under it
+    {"com_inf_win", kNotifications, kMax, kMax},  // info window, slides in at the right
+    {"com_bna", kNotifications, kMid, kMax},
+    {"com_tlk", kDialogue, kSelf, kSelf},         // speech bubble over the talking actor (origin bottom)
+    {"com_evt", kDialogue, kMid, kMid},           // event message window
+    {"rom_tlk_nul", kDialogue, kSelf, kSelf},     // chancellor's window (menu_report): its tail is at its origin
+    {"com_sys", kSystemMessages, kMid, kMid},
+    {"com_sys_2", kSystemMessages, kMid, kMid},
+    {"com_dat_nul_01", kSystemMessages, kMid, kMid},
+    {"com_dat_sys_nul", kSystemMessages, kMid, kMid},
+    {"com_scr", kSystemMessages, kMid, kMid},
+    {"ecom_sys", kSystemMessages, kMid, kMid},    // e-commerce.brlyt
+    {"ecom_alt", kSystemMessages, kMid, kMid},
+    {"bom_sys_nul", kSystemMessages, kMid, kMid}, // menu_room
+    {"ttl_dat_nul_01", kSystemMessages, kMid, kMid},  // menu_title: save slots
+    {"ttl_sys_nul", kSystemMessages, kMid, kMid},
+    {"key_nul", kKeyboard, kMid, kMid},
+    // Talk window under the speaker (Chime in the middle: report, Frog Board...): anchored on the tip
+    // of its tail (com_men_hge_TR1, 26x31 centred at -29,-18; menu_window_hgTR points up-right).
+    {"com_men_nul_1", kMenus, kSelf, kSelf, -21.0f, -2.5f},
+    // Talk window beside the speaker (Chime's report, the chancellor's costume talk, the signboard...)
+    // and the medal window: anchored on the tip of their tail (bui_men_hge_LT2 at 14,20 and
+    // ntc_men_hge_LT at 14,8, 26x31 from their top centre), so it keeps pointing at the speaker.
+    // In the rooms (Frog Board, shops, guild...) the speaker stands at the left (MenuRoom.setActorPos,
+    // x -230 in 3D) and the scripts leave com_men_nul_2 at its layout place (-220, -70), so in 16:9 its
+    // tail lands on the speaker's arm. It is moved so the tail's tip (about 0,+18 from the pane) is at
+    // the speaker's mouth level, just right of the face (Liara: on Chime's mouth, face not hidden).
+    {"com_men_nul_*", kMenus, kSelf, kSelf, 1.0f, 5.0f, -220.0f, -150.0f, 15.0f},
+    {"ntc_men_nul", kMenus, kSelf, kSelf, 1.0f, -7.0f},
+    {"bui_men_nul", kMenus, kAuto, kAuto},
+    {"bui_hin_nul", kMenus, kAuto, kAuto},
+    {"opn_win_nul", kMenus, kMid, kMid},          // options
+    // menu_title's menu (ttl_men_nul) is placed by TitlePaneFixup.
+    {"com_hlp", kHelpBar, kMid, kMin},
+    {"com_cha", kTitles, kMax, kMin},             // chapter title, origin bottom-right
+    {"com_bos_nul", kTitles, kMid, kMin},
+    {"com_hpt_nul", kGauges, kSelf, kSelf},
+    {"com_exp_nul", kGauges, kSelf, kSelf},
+    {"bom_sig_nul", kRoomBanner, kMid, kMax},     // room sign (menu_room), drawn at the top
+    {"rom_sig_nul", kRoomBanner, kMid, kMax},     // castle sign (menu_report)
+    // The tutorial hand (com_fin_L / com_fin_R), placed by the scripts next to the clock or the info
+    // window: it follows the element it points at (same category and anchor), see the wrapper.
+    {"com_fin_*", kCategoryCount, kAuto, kAuto},
+};
+constexpr size_t kRuleCount = sizeof(kRules) / sizeof(kRules[0]);
+
+constexpr uint32_t kPaneCalculateMtx = 0x801CF6A8u;
+
+std::atomic<float> g_scale[kCategoryCount] = {1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f, 1.0f};
+static_assert(kCategoryCount == 10, "one 1.0f per category above");
+std::atomic<bool> g_anyScaled{false};
+int g_scaledDepth = 0;            // > 0 while inside a scaled pane (game thread only)
+bool g_logged[kRuleCount] = {};
+
+float ReadF32(uint32_t address) {
+    const uint32_t bits = Memory::Read32(address);
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+void WriteF32(uint32_t address, float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    Memory::Write32(address, bits);
+}
+
+int FindRule(uint32_t pane) {
+    char name[17];
+    for (uint32_t i = 0; i < 16; i += 4) {
+        const uint32_t word = Memory::Read32(pane + 0xBCu + i);
+        name[i] = static_cast<char>(word >> 24);
+        name[i + 1] = static_cast<char>(word >> 16);
+        name[i + 2] = static_cast<char>(word >> 8);
+        name[i + 3] = static_cast<char>(word);
+    }
+    name[16] = '\0';
+    const std::string_view paneName(name, std::strlen(name));
+    for (size_t i = 0; i < kRuleCount; ++i) {
+        const std::string_view rule(kRules[i].name);
+        if (!rule.empty() && rule.back() == '*') {
+            if (paneName.substr(0, rule.size() - 1) == rule.substr(0, rule.size() - 1)) return static_cast<int>(i);
+        } else if (paneName == rule) {
+            return static_cast<int>(i);
+        }
+    }
+    return -1;
+}
+
+// x and y of the 3x4 matrix at address (rows of 4 floats) applied to a point.
+struct Affine2D {
+    float a, b, tx, c, d, ty;  // x' = a x + b y + tx, y' = c x + d y + ty
+};
+
+Affine2D ReadAffine(uint32_t matrix) {
+    return {ReadF32(matrix + 0x00u), ReadF32(matrix + 0x04u), ReadF32(matrix + 0x0Cu),
+            ReadF32(matrix + 0x10u), ReadF32(matrix + 0x14u), ReadF32(matrix + 0x1Cu)};
+}
+
+float Pick(Anchor anchor, float low, float high, float position) {
+    switch (anchor) {
+    case kMin: return low;
+    case kMax: return high;
+    case kAuto: {
+        const float third = (high - low) / 3.0f;
+        if (position < low + third) return low;
+        if (position > high - third) return high;
+        return (low + high) * 0.5f;
+    }
+    default: return (low + high) * 0.5f;
+    }
+}
+
+} // namespace
+
+int LifeKing_HLE_UiScaleCategoryCount() { return kCategoryCount; }
+const char* LifeKing_HLE_UiScaleCategoryKey(int category) {
+    return category >= 0 && category < kCategoryCount ? kCategories[category].key : "";
+}
+const char* LifeKing_HLE_UiScaleCategoryLabel(int category) {
+    return category >= 0 && category < kCategoryCount ? kCategories[category].label : "";
+}
+const char* LifeKing_HLE_UiScaleCategoryHint(int category) {
+    return category >= 0 && category < kCategoryCount ? kCategories[category].hint : "";
+}
+
+void LifeKing_HLE_SetUiScale(int category, float scale) {
+    if (category < 0 || category >= kCategoryCount || !std::isfinite(scale)) return;
+    g_scale[category].store(scale, std::memory_order_relaxed);
+    bool any = false;
+    for (const auto& value : g_scale) any = any || value.load(std::memory_order_relaxed) != 1.0f;
+    g_anyScaled.store(any, std::memory_order_relaxed);
+}
+
+namespace {
+
+// The help line's dark band (com_hlp_bas, 640 wide in common.brlyt) is as wide as a 4:3 screen; in
+// 16:9 the UI screen is 844 wide and the band stopped short of both sides. Its width is set to the
+// whole screen (in its own space, so it stays right whatever the help bar's scale). Not put back: the
+// width is read when the pane is drawn, after this call.
+void StretchHelpBand(uint32_t pane) {
+    const float halfWidth = GX_HLE_UiOrthoHalfWidth();
+    if (!(halfWidth > 0.0f)) return;
+    const uint32_t parent = Memory::Read32(pane + 0x0Cu);
+    if (parent == 0) return;
+    const float parentScale = ReadF32(parent + 0x84u);  // x scale of the parent's global matrix
+    const float ownScale = ReadF32(pane + 0x44u);
+    if (!(parentScale > 0.0f) || !(ownScale > 0.0f)) return;
+    const float width = 2.0f * halfWidth / (parentScale * ownScale) + 4.0f;
+    if (width > ReadF32(pane + 0x4Cu)) WriteF32(pane + 0x4Cu, width);
+}
+
+bool IsNamed(uint32_t pane, const char* name) {
+    char buffer[17];
+    for (uint32_t i = 0; i < 16; ++i) buffer[i] = static_cast<char>(Memory::Read8(pane + 0xBCu + i));
+    buffer[16] = '\0';
+    return std::strcmp(buffer, name) == 0;
+}
+
+// 3D models in menus (script MenuModel: the house of the building menu): their pane (vtable
+// 0x8028149C, model object at +0xD8, drawn by 0x800C1FC0) is placed on screen by the scripts in screen
+// units, not through the pane tree, so a shrunk menu left the house where it was. For each model
+// inside a scaled element, the element's anchor and scale are kept for its draw (LifeKing_DrawMenuModel).
+constexpr uint32_t kModelPaneVtable = 0x8028149Cu;
+struct ScreenRemap {
+    float anchorX, anchorY, scale;  // view space
+};
+std::unordered_map<uint32_t, ScreenRemap> g_modelRemaps;
+ScreenRemap g_currentRemap{0.0f, 0.0f, 1.0f};
+uint32_t g_frame = 0;
+uint32_t g_mapShownFrame = 0xFFFFFFF0u;  // last frame the quest map (map_bas) was drawn
+uint32_t g_reportShownFrame = 0xFFFFFFF0u;  // last frame the castle's report room (rom_bg_nul) was drawn
+
+void NoteModelPane(uint32_t pane, bool scaled) {
+    if (Memory::Read32(pane) != kModelPaneVtable) return;
+    const uint32_t model = Memory::Read32(pane + 0xD8u);
+    if (model == 0) return;
+    if (scaled) g_modelRemaps[model] = g_currentRemap;
+    else g_modelRemaps.erase(model);
+}
+
+// Title screen (menu_title.brlyt), whatever the UI scale (Liara). The UI screen is a 4:3 one (x
+// -320..320) shown on a 16:9 picture, so the game logo (tittle_img) looked a third too wide: its width
+// is brought back to 3/4, around its own centre, so it keeps its 4:3 shape. The copyright line
+// (ar_tex, "(C) 2008 SQUARE ENIX...") is drawn at half size, kept against the bottom edge of the
+// screen. The title menu (ttl_men_nul, its window ttl_men_win 80 below it) is kept halfway between
+// the logo and the copyright line, at any "Menus" scale: its window's centre is put there and the
+// menu shrinks around it. Like the scale above, only for the length of the call.
+constexpr float kTitleLogoWidth = 0.75f;
+constexpr float kCopyrightScale = 0.5f;
+constexpr float kTitleMenuWindowY = -80.0f;  // ttl_men_win in ttl_men_nul
+// Bottom of the logo: tittle_img at y 60, 248 high, scaled 0.9 in height by the script (MenuTitle).
+constexpr float kLogoBottom = 60.0f - 248.0f * 0.9f * 0.5f;
+// Top of the copyright line: ar_tex at y -184, 18 high, brought to half size against the bottom (-224).
+constexpr float kCopyrightTop = -224.0f + (-184.0f + 224.0f) * kCopyrightScale + 18.0f * kCopyrightScale * 0.5f;
+constexpr float kTitleMenuCentreY = (kLogoBottom + kCopyrightTop) * 0.5f;
+
+bool TitlePaneFixup(CpuContext* ctx) {
+    const uint32_t pane = ctx->gpr[3];
+    const uint32_t head = Memory::Read32(pane + 0xBCu);
+    float scaleX = 1.0f, scaleY = 1.0f;
+    bool toBottom = false;
+    if (head == 0x74697474u /* "titt" */ && IsNamed(pane, "tittle_img")) {
+        scaleX = kTitleLogoWidth;
+    } else if (head == 0x61725F74u /* "ar_t" */ && IsNamed(pane, "ar_tex")) {
+        scaleX = scaleY = kCopyrightScale;
+        toBottom = true;
+    } else if (head == 0x74746C5Fu /* "ttl_" */ && IsNamed(pane, "ttl_men_nul")) {
+        const float scale = g_scale[kMenus].load(std::memory_order_relaxed);
+        const float ty = ReadF32(pane + 0x30u);
+        const float sx = ReadF32(pane + 0x44u), sy = ReadF32(pane + 0x48u);
+        WriteF32(pane + 0x30u, kTitleMenuCentreY - kTitleMenuWindowY * sy * scale);
+        WriteF32(pane + 0x44u, sx * scale);
+        WriteF32(pane + 0x48u, sy * scale);
+        ++g_scaledDepth;
+        GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+        --g_scaledDepth;
+        WriteF32(pane + 0x30u, ty);
+        WriteF32(pane + 0x44u, sx);
+        WriteF32(pane + 0x48u, sy);
+        return true;
+    } else {
+        return false;
+    }
+    const uint32_t drawInfo = ctx->gpr[4];
+    const float tx = ReadF32(pane + 0x2Cu), ty = ReadF32(pane + 0x30u);
+    const float sx = ReadF32(pane + 0x44u), sy = ReadF32(pane + 0x48u);
+    float newTx = tx, newTy = ty;
+    if (toBottom) {
+        float left = ReadF32(drawInfo + 0x34u), top = ReadF32(drawInfo + 0x38u);
+        float right = ReadF32(drawInfo + 0x3Cu), bottom = ReadF32(drawInfo + 0x40u);
+        if (!(std::isfinite(left) && std::isfinite(right) && std::isfinite(top) && std::isfinite(bottom) &&
+              right > left && top != bottom)) {
+            left = -320.0f; right = 320.0f; top = 224.0f; bottom = -224.0f;
+        }
+        const uint32_t parent = Memory::Read32(pane + 0x0Cu);
+        const Affine2D m = ReadAffine(parent != 0 ? parent + 0x84u : drawInfo + 0x04u);
+        const float det = m.a * m.d - m.b * m.c;
+        if (std::fabs(det) > 1e-12f) {
+            const float dx = (left + right) * 0.5f - m.tx, dy = std::fmin(top, bottom) - m.ty;
+            const float lx = (m.d * dx - m.b * dy) / det;
+            const float ly = (-m.c * dx + m.a * dy) / det;
+            newTx = lx + (tx - lx) * scaleX;
+            newTy = ly + (ty - ly) * scaleY;
+        }
+    }
+    WriteF32(pane + 0x2Cu, newTx);
+    WriteF32(pane + 0x30u, newTy);
+    WriteF32(pane + 0x44u, sx * scaleX);
+    WriteF32(pane + 0x48u, sy * scaleY);
+    GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+    WriteF32(pane + 0x2Cu, tx);
+    WriteF32(pane + 0x30u, ty);
+    WriteF32(pane + 0x44u, sx);
+    WriteF32(pane + 0x48u, sy);
+    return true;
+}
+
+} // namespace
+
+extern "C" void LifeKing_PaneCalculateMtx(CpuContext* ctx) {
+    if (TitlePaneFixup(ctx)) return;
+    // com_men_nul_2 goes on even with nothing scaled: its rule may move it (see kRules).
+    const bool roomTalk = Memory::Read32(ctx->gpr[3] + 0xBCu) == 0x636F6D5Fu /* "com_" */ &&
+                          IsNamed(ctx->gpr[3], "com_men_nul_2");
+    if (g_scaledDepth > 0 || (!g_anyScaled.load(std::memory_order_relaxed) && !roomTalk)) {
+        NoteModelPane(ctx->gpr[3], g_scaledDepth > 0);
+        // The band is a child of the help bar, so it is reached here (inside it, or with no scale).
+        if (Memory::Read32(ctx->gpr[3] + 0xBCu) == 0x636F6D5Fu /* "com_" */ && IsNamed(ctx->gpr[3], "com_hlp_bas")) {
+            StretchHelpBand(ctx->gpr[3]);
+        }
+        GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+        return;
+    }
+    const uint32_t pane = ctx->gpr[3];
+    const uint32_t drawInfo = ctx->gpr[4];
+    const int ruleIndex = FindRule(pane);
+    if (ruleIndex < 0) {
+        NoteModelPane(pane, false);
+        GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+        return;
+    }
+    PaneRule rule = kRules[ruleIndex];
+
+    // The screen, in view space.
+    float left = ReadF32(drawInfo + 0x34u), top = ReadF32(drawInfo + 0x38u);
+    float right = ReadF32(drawInfo + 0x3Cu), bottom = ReadF32(drawInfo + 0x40u);
+    const bool rectOk = std::isfinite(left) && std::isfinite(right) && std::isfinite(top) && std::isfinite(bottom) &&
+                        right > left && top != bottom;
+    if (!rectOk) {
+        left = -320.0f; right = 320.0f; top = 224.0f; bottom = -224.0f;
+    }
+    const float yLow = std::fmin(top, bottom), yHigh = std::fmax(top, bottom);
+
+    // The parent's space (where translate lives) from view space.
+    const uint32_t parent = Memory::Read32(pane + 0x0Cu);
+    const Affine2D m = ReadAffine(parent != 0 ? parent + 0x84u : drawInfo + 0x04u);
+    const float det = m.a * m.d - m.b * m.c;
+    const float tx = ReadF32(pane + 0x2Cu), ty = ReadF32(pane + 0x30u);
+    // The x the pane is scaled from (the rule may move a pane the scripts left at its layout x).
+    float baseTx = tx;
+    const float px = m.a * tx + m.b * ty + m.tx;  // where the pane is on screen
+    const float py = m.c * tx + m.d * ty + m.ty;
+
+    if (rule.category == kCategoryCount) {
+        // The tutorial hand: in the top third it points at the clock (left) or the info window
+        // (right); elsewhere, or on the quest map (which is not scaled), it is left alone.
+        // Nor in the castle's reports (Liara): the hand stays at the game's size there.
+        const bool onMap = g_frame - g_mapShownFrame <= 2u || g_frame - g_reportShownFrame <= 2u;
+        if (!onMap && py > yHigh - (yHigh - yLow) / 3.0f) {
+            rule = px < (left + right) * 0.5f ? PaneRule{rule.name, kClock, kMin, kMax}
+                                               : PaneRule{rule.name, kNotifications, kMax, kMax};
+        } else {
+            GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+            return;
+        }
+    }
+    const float scale = g_scale[rule.category].load(std::memory_order_relaxed);
+    float baseTy = ty;
+    const bool moved = rule.toX != 0.0f && std::fabs(tx - rule.fromX) < 0.01f;
+    if (moved) {
+        baseTx = rule.toX;
+        baseTy = rule.toY;
+    }
+    if (scale == 1.0f || std::fabs(det) <= 1e-12f) {
+        if (moved) {
+            WriteF32(pane + 0x2Cu, baseTx);
+            WriteF32(pane + 0x30u, baseTy);
+        }
+        GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+        if (moved) {
+            WriteF32(pane + 0x2Cu, tx);
+            WriteF32(pane + 0x30u, ty);
+        }
+        return;
+    }
+
+    const float sx = ReadF32(pane + 0x44u), sy = ReadF32(pane + 0x48u);
+    float newTx = tx, newTy = ty;
+    {
+        // The centre of the pane's box, for kBox: from its origin (+0xBA: column + 3 * row, column 0 left,
+        // row 0 top) and size (+0x4C, +0x50), in the parent's space.
+        const uint8_t origin = Memory::Read8(pane + 0xBAu);
+        const float boxX = baseTx + (1.0f - static_cast<float>(origin % 3u)) * 0.5f * ReadF32(pane + 0x4Cu) * sx;
+        const float boxY = baseTy - (1.0f - static_cast<float>(origin / 3u)) * 0.5f * ReadF32(pane + 0x50u) * sy;
+        const float bx = m.a * boxX + m.b * boxY + m.tx;
+        const float by = m.c * boxX + m.d * boxY + m.ty;
+        const float selfX = baseTx + rule.selfX * sx, selfY = baseTy + rule.selfY * sy;
+        const float qx = m.a * selfX + m.b * selfY + m.tx;  // the kSelf point on screen
+        const float qy = m.c * selfX + m.d * selfY + m.ty;
+        const float ax = rule.x == kSelf ? qx : rule.x == kBox ? bx : Pick(rule.x, left, right, px);
+        const float ay = rule.y == kSelf ? qy : rule.y == kBox ? by : Pick(rule.y, yLow, yHigh, py);
+        g_currentRemap = {ax, ay, scale};
+        // Back into the parent's space.
+        const float dx = ax - m.tx, dy = ay - m.ty;
+        const float lx = (m.d * dx - m.b * dy) / det;
+        const float ly = (-m.c * dx + m.a * dy) / det;
+        newTx = lx + (baseTx - lx) * scale;
+        newTy = ly + (baseTy - ly) * scale;
+        if (!g_logged[ruleIndex]) {
+            g_logged[ruleIndex] = true;
+            RT_LOGF("lifeking", "ui scale %s (%s) x%.2f: rect %.0f,%.0f..%.0f,%.0f%s, parent %s scale %.2f,%.2f, "
+                    "at %.0f,%.0f on screen, anchor %.0f,%.0f, ui screen half width %.0f\n",
+                    rule.name, kCategories[rule.category].key, scale, left, yHigh, right, yLow,
+                    rectOk ? "" : " (default)", parent != 0 ? "pane" : "view", m.a, m.d, px, py, ax, ay,
+                    GX_HLE_UiOrthoHalfWidth());
+        }
+    }
+
+    WriteF32(pane + 0x2Cu, newTx);
+    WriteF32(pane + 0x30u, newTy);
+    WriteF32(pane + 0x44u, sx * scale);
+    WriteF32(pane + 0x48u, sy * scale);
+    ++g_scaledDepth;
+    GuestFunctions::BaseTranslation(kPaneCalculateMtx)(ctx);
+    --g_scaledDepth;
+    WriteF32(pane + 0x2Cu, tx);
+    WriteF32(pane + 0x30u, ty);
+    WriteF32(pane + 0x44u, sx);
+    WriteF32(pane + 0x48u, sy);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 801CF6A8, LifeKing_PaneCalculateMtx);
+
+// --- Icons over characters ---------------------------------------------------------------------------
+// The "!", smiley and other icons over characters are 3D models (script ActorIcon), scaled by the
+// scripts through WorldEngine::setObjectScale (0x8003A438: r3 engine, r4 object id, f1-f3 x/y/z) right
+// after each is placed (setObjectPosition 0x80035A48, same registers), 1 normally and 3 in the top
+// view. The data patch (make_fps60_scripts.py) makes ActorIcon.setScale pass -x, which marks the call
+// as an icon's: the scale is made positive again and multiplied by the "Over characters" setting.
+// The icons are centred on their position (icon.brres: the bubble is -0.5..0.5 high), so a smaller
+// one is moved down by what it lost, which keeps its bottom (the point over the head) in place.
+// A change in F10 is applied to the icons already shown at the next frame (LifeKing_UiScaleFrame).
+namespace {
+constexpr uint32_t kSetObjectScale = 0x8003A438u;
+constexpr uint32_t kSetObjectPosition = 0x80035A48u;
+constexpr double kIconHalfHeight = 0.5;
+struct IconState {
+    float asked = 1.0f;  // the scale the scripts asked for
+    double x = 0.0, y = 0.0, z = 0.0;
+    bool placed = false;
+};
+uint32_t g_worldEngine = 0;
+std::unordered_map<uint32_t, IconState> g_icons;  // object id -> icon
+float g_iconAppliedScale = 1.0f;
+struct LastPosition {
+    uint32_t id = 0xFFFFFFFFu;
+    double x = 0.0, y = 0.0, z = 0.0;
+} g_lastPosition;
+
+double IconY(const IconState& icon, float scale) {
+    return icon.y - kIconHalfHeight * icon.asked * (1.0 - scale);
+}
+
+void CallSetObjectPosition(CpuContext* ctx, uint32_t id, const IconState& icon, float scale) {
+    const CpuContext saved = *ctx;
+    ctx->gpr[3] = g_worldEngine;
+    ctx->gpr[4] = id;
+    ctx->fpr[1].d = icon.x;
+    ctx->fpr[2].d = IconY(icon, scale);
+    ctx->fpr[3].d = icon.z;
+    GuestFunctions::BaseTranslation(kSetObjectPosition)(ctx);
+    *ctx = saved;
+}
+} // namespace
+
+extern "C" void LifeKing_SetObjectPosition(CpuContext* ctx) {
+    const uint32_t id = ctx->gpr[4];
+    g_lastPosition = {id, ctx->fpr[1].d, ctx->fpr[2].d, ctx->fpr[3].d};
+    const auto it = g_icons.find(id);
+    if (it != g_icons.end()) {
+        IconState& icon = it->second;
+        icon.x = ctx->fpr[1].d;
+        icon.y = ctx->fpr[2].d;
+        icon.z = ctx->fpr[3].d;
+        icon.placed = true;
+        ctx->fpr[2].d = IconY(icon, g_scale[kGauges].load(std::memory_order_relaxed));
+    }
+    GuestFunctions::BaseTranslation(kSetObjectPosition)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 80035A48, LifeKing_SetObjectPosition);
+
+extern "C" void LifeKing_SetObjectScale(CpuContext* ctx) {
+    const uint32_t id = ctx->gpr[4];
+    if (ctx->fpr[1].d >= 0.0) {
+        g_icons.erase(id);  // that id is not (or no longer) an icon
+        GuestFunctions::BaseTranslation(kSetObjectScale)(ctx);
+        return;
+    }
+    const float asked = static_cast<float>(-ctx->fpr[1].d);
+    const float scale = g_scale[kGauges].load(std::memory_order_relaxed);
+    g_worldEngine = ctx->gpr[3];
+    IconState& icon = g_icons[id];
+    icon.asked = asked;
+    if (g_lastPosition.id == id) {  // placed just before (ActorIcon: setPosition, then setScale)
+        icon.x = g_lastPosition.x;
+        icon.y = g_lastPosition.y;
+        icon.z = g_lastPosition.z;
+        icon.placed = true;
+    }
+    ctx->fpr[1].d = asked * scale;
+    ctx->fpr[2].d = ctx->fpr[2].d * scale;
+    ctx->fpr[3].d = ctx->fpr[3].d * scale;
+    GuestFunctions::BaseTranslation(kSetObjectScale)(ctx);
+    if (icon.placed) CallSetObjectPosition(ctx, id, icon, scale);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 8003A438, LifeKing_SetObjectScale);
+
+void LifeKing_UiScaleFrame(CpuContext* ctx) {
+    ++g_frame;
+    const float scale = g_scale[kGauges].load(std::memory_order_relaxed);
+    if (scale == g_iconAppliedScale) return;
+    g_iconAppliedScale = scale;
+    if (g_worldEngine == 0 || g_icons.empty()) return;
+    const CpuContext saved = *ctx;
+    for (const auto& [id, icon] : g_icons) {
+        ctx->gpr[3] = g_worldEngine;
+        ctx->gpr[4] = id;
+        ctx->fpr[1].d = ctx->fpr[2].d = ctx->fpr[3].d = icon.asked * scale;
+        GuestFunctions::BaseTranslation(kSetObjectScale)(ctx);
+        *ctx = saved;
+        if (icon.placed) CallSetObjectPosition(ctx, id, icon, scale);
+    }
+}
+
+// --- 3D models drawn in menus ------------------------------------------------------------------------
+// The rooms (the castle with Chime and the chancellor, the signboards, shops...) draw their characters
+// as 3D models attached to a pane (script MenuModel), with a camera of their own: the model pane's draw
+// 0x800C1FC0 updates and draws a g3d scene. The F10 field of view is meant for the world camera and
+// made them look stretched, so the game's own field of view is kept for the length of that draw.
+// Inside a shrunk menu, the model also follows the menu on screen (see NoteModelPane).
+extern "C" void LifeKing_DrawMenuModel(CpuContext* ctx) {
+    const auto it = g_modelRemaps.find(ctx->gpr[3]);
+    const float halfWidth = GX_HLE_UiOrthoHalfWidth();
+    const bool remap = it != g_modelRemaps.end() && it->second.scale != 1.0f && halfWidth > 0.0f;
+    if (remap) GX_HLE_SetScreenRemap(true, it->second.anchorX / halfWidth, it->second.anchorY / 224.0f, it->second.scale);
+    GX_HLE_SuppressFieldOfView(true);
+    GuestFunctions::BaseTranslation(0x800C1FC0u)(ctx);
+    GX_HLE_SuppressFieldOfView(false);
+    if (remap) GX_HLE_SetScreenRemap(false, 0.0f, 0.0f, 1.0f);
+}
+
+// nw4r::lyt::Pane::Draw (0x801CF9A0), which draws only visible panes: tells when the quest map is
+// on screen (map_bas, map.brlyt), for the tutorial hand.
+extern "C" void LifeKing_PaneDraw(CpuContext* ctx) {
+    const uint32_t pane = ctx->gpr[3];
+    if (Memory::Read32(pane + 0xBCu) == 0x6D61705Fu /* "map_" */ && (Memory::Read8(pane + 0xBBu) & 1u) != 0 &&
+        IsNamed(pane, "map_bas")) {
+        g_mapShownFrame = g_frame;
+    } else if (Memory::Read32(pane + 0xBCu) == 0x726F6D5Fu /* "rom_" */ && (Memory::Read8(pane + 0xBBu) & 1u) != 0 &&
+               IsNamed(pane, "rom_bg_nul")) {
+        g_reportShownFrame = g_frame;
+    }
+    GuestFunctions::BaseTranslation(0x801CF9A0u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 801CF9A0, LifeKing_PaneDraw);
+FOREIGN_GAME_WRAPPER(WFCPGD, 800C1FC0, LifeKing_DrawMenuModel);
