+#pragma once
+
+// Shared by the three source files of the Harvest Moon: Animal Parade mod "romance_any_gender":
+// romance_any_gender.cpp (who can fall in love with the player, and the testing panel),
+// romance_adoption.cpp (the Harvest Goddess's adoption scene and the wedding for couples of the
+// same sex, and the mod's copies of the love message packs) and romance_lines.cpp (the lines of
+// those packs fixed for couples of the same sex).
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace RomanceAnyGender {
+
+inline constexpr const char* kMod = "romance_any_gender";
+
+// Whether Config.toml [mods] turns the mod on.
+bool Enabled();
+
+// Testing (F10 > Mods), each read at the next start:
+// - kTestProposalKey: a candidate's confession starts at its spot by the lighthouse at any hour.
+// - kTestAdoptionKey: going to bed at home plays a preview of the adoption scene with the
+//   candidate chosen in the panel in the spouse's place, in any game and changing nothing in it.
+//   That candidate's question event (L000015) loses its conditions but its own "done" flag, and
+//   romance_adoption.cpp sends it to the preview.
+// - kTestSceneKey (a number): with kTestAdoptionKey on, the bedtime preview plays the scene of this
+//   event instead (as the mod would send it for the player's sex), to look at any love scene, the
+//   Harvest Goddess's and the Harvest King's for example, without playing up to it. 0 is the
+//   adoption preview. A number in UserData\Cache\Mods\romance_any_gender\test_scene.txt
+//   comes first, read at every bedtime.
+inline constexpr const char* kTestProposalKey = "romance_any_gender_test_proposal";
+inline constexpr const char* kTestAdoptionKey = "romance_any_gender_test_adoption";
+inline constexpr const char* kTestSceneKey = "romance_any_gender_test_scene";
+
+// The candidate the adoption preview shows: the one chosen in the testing panel (F10 > Mods) when
+// the game started. The panel keeps the choice in UserData\Cache\Mods\romance_any_gender\
+// test_candidate.txt.
+uint32_t AdoptionPreviewCharacter();
+
+// The player's sex as the game keeps it in variable 0x23.
+inline constexpr int kMan = 0;
+inline constexpr int kWoman = 1;
+
+// The sex the original game pairs a character with, or -1 for anyone who is not a candidate:
+// a man marries characters 1-8, the Harvest Goddess (52) or the Witch Princess (59); a woman
+// characters 9-16, the Harvest King (60) or the Wizard (61).
+int NaturalPartnerSex(uint32_t character);
+
+// The disc's text files (.db) are blocks of "{", lines of "key  value", "}".
+std::string ReadFile(const std::filesystem::path& path);
+std::vector<std::string> Blocks(const std::string& text);
+long Number(const std::string& block, const char* key);  // a block's number for key, or -1
+
+// The disc's other files are big-endian.
+uint32_t ReadBigEndian32(const std::string& data, size_t at);
+void PutBigEndian32(std::string& data, size_t at, uint32_t value);
+
+// romance_lines.cpp: the love message pack `name` (love<name>.mpc, "Selr" for example) of
+// msglang/<language>/<folder>/ with the lines a couple of the same sex sees fixed for them; the
+// pack as it is when it is not one of those. `fixed` grows by the fixes made.
+std::string WithSameSexLines(const std::string& pack, const std::string& language, const std::string& folder,
+                             const std::string& name, int& fixed);
+
+// The game's state in memory:
+// - The state is the structure at *(0x806B3B80).
+// - Event flags are one byte each, at state + 0x118 + flag (read by 0x80111754).
+// - Game variables are at state + 0x1398 + an offset from the table at 0x8050AA10 (0x80110148).
+//   Variable 0x23 is the player's sex, variable 85 how many times the house was built up.
+// - Each villager's values are at state + (character - 1) * 0x400 + 0x1B98 + an offset from the
+//   table at 0x8050AA24 (0x801118E8). Value 0 says the player has met them, value 1 is the heart
+//   points: 900 is the proposal's minimum, 1000 the most (0x8010A2E4 caps it there).
+inline constexpr uint32_t kGameState = 0x806B3B80u;
+inline constexpr uint32_t kVariableTable = 0x8050AA10u;
+uint32_t TableOffset(uint32_t table, uint32_t entry);  // what 0x80150134 works out
+uint32_t VariableAddress(uint32_t variable);
+
+} // namespace RomanceAnyGender
