+// LifeKing: opt-in sampling profiler. Set LIFEKING_PROFILE=1: a host thread samples, every
+// millisecond, the instruction pointer of the main thread (where the guest fibers run) and of the
+// threads that register themselves (GX worker, AX mix worker). A sample taken while the thread sits
+// in a PerfStats::WaitScope is filed under that wait instead of its address. Samples are grouped per
+// presented frame: frames whose busy time reaches kHeavyMs go to the "heavy" sections, the others to
+// "normal". %TEMP%\lifeking_profile.txt is rewritten every ~5 s and at exit; samples outside the exe
+// are written as @module+offset. port/lk-tools/symbolize_profile.py turns it into function names.
+#include "perf_stats.h"
+
+#if defined(_WIN32)
+#include <windows.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+constexpr double kHeavyMs = 20.0;
+constexpr uint64_t kWaitTag = 0xFFFF000000000000ull;
+
+struct Target {
+    std::string name;
+    HANDLE handle = nullptr;
+    std::atomic<int> waitSlot{-1};
+};
+
+struct Sample {
+    uint32_t target;
+    uint64_t key;     // rip, or kWaitTag | kind
+    uint64_t caller;  // rip outside the exe: first return address into the exe's code found on the stack
+};
+
+bool g_active = false;
+uint64_t g_base = 0;
+std::mutex g_mutex;
+std::vector<Target*> g_targets;
+std::vector<Sample> g_pending;
+// [heavy][target] -> key -> count
+std::map<uint64_t, uint32_t> g_counts[2][8];
+// [heavy][target] -> caller -> count, for the samples outside the exe that are not waits
+std::map<uint64_t, uint32_t> g_callers[2][8];
+uint64_t g_textBegin = 0;
+uint64_t g_textEnd = 0;
+
+void FindExeCode() {
+    const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(g_base);
+    const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(g_base + dos->e_lfanew);
+    const IMAGE_SECTION_HEADER* section = IMAGE_FIRST_SECTION(nt);
+    for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i, ++section) {
+        if ((section->Characteristics & IMAGE_SCN_MEM_EXECUTE) == 0) continue;
+        const uint64_t begin = g_base + section->VirtualAddress;
+        const uint64_t end = begin + section->Misc.VirtualSize;
+        if (g_textBegin == 0 || begin < g_textBegin) g_textBegin = begin;
+        if (end > g_textEnd) g_textEnd = end;
+    }
+}
+
+bool InExeCode(uint64_t address) { return address >= g_textBegin && address < g_textEnd; }
+
+// Stack of a suspended thread of this process: the first word pointing into the exe's code is taken
+// as the caller (a heuristic, but leaf DLL routines such as memmove sit right above it).
+uint64_t FindCaller(uint64_t rsp) {
+    if (rsp == 0 || (rsp & 7) != 0) return 0;
+    MEMORY_BASIC_INFORMATION info;
+    if (VirtualQuery(reinterpret_cast<void*>(rsp), &info, sizeof(info)) == 0 || info.State != MEM_COMMIT) return 0;
+    const uint64_t limit = reinterpret_cast<uint64_t>(info.BaseAddress) + info.RegionSize;
+    const auto* word = reinterpret_cast<const uint64_t*>(rsp);
+    for (int i = 0; i < 512 && reinterpret_cast<uint64_t>(word + 1) <= limit; ++i, ++word) {
+        if (InExeCode(*word)) return *word;
+    }
+    return 0;
+}
+uint64_t g_frames[2] = {0, 0};
+
+const char* WaitName(int kind) {
+    switch (kind) {
+    case 0: return "wait:vi-pacing";
+    case 1: return "wait:gx-worker";
+    case 2: return "wait:audio-mix";
+    case 3: return "wait:idle";
+    default: return "wait:?";
+    }
+}
+
+void Dump() {
+    char path[MAX_PATH];
+    const DWORD n = GetTempPathA(MAX_PATH, path);
+    if (n == 0 || n > MAX_PATH - 32) return;
+    std::strcat(path, "lifeking_profile.txt");
+    FILE* f = std::fopen(path, "w");
+    if (!f) return;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    std::fprintf(f, "# image base 0x%llx\n", static_cast<unsigned long long>(g_base));
+    std::fprintf(f, "# frames heavy %llu normal %llu (heavy = busy >= %.0f ms)\n",
+                 static_cast<unsigned long long>(g_frames[1]), static_cast<unsigned long long>(g_frames[0]), kHeavyMs);
+    for (int heavy = 1; heavy >= 0; --heavy) {
+        for (size_t t = 0; t < g_targets.size(); ++t) {
+            std::fprintf(f, "[%s %s]\n", g_targets[t]->name.c_str(), heavy ? "heavy" : "normal");
+            for (const auto& [key, count] : g_counts[heavy][t]) {
+                if ((key & kWaitTag) == kWaitTag) {
+                    std::fprintf(f, "%s %u\n", WaitName(static_cast<int>(key & 0xFF)), count);
+                    continue;
+                }
+                HMODULE module = nullptr;
+                if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                       reinterpret_cast<LPCSTR>(key), &module) &&
+                    module != nullptr && reinterpret_cast<uint64_t>(module) != g_base) {
+                    char modPath[MAX_PATH];
+                    const DWORD len = GetModuleFileNameA(module, modPath, MAX_PATH);
+                    const char* base = modPath;
+                    for (DWORD i = 0; i < len; ++i) {
+                        if (modPath[i] == '\\' || modPath[i] == '/') base = modPath + i + 1;
+                    }
+                    std::fprintf(f, "@%s+%llx %u\n", len ? base : "?",
+                                 static_cast<unsigned long long>(key - reinterpret_cast<uint64_t>(module)), count);
+                    continue;
+                }
+                std::fprintf(f, "%llx %u\n", static_cast<unsigned long long>(key - g_base), count);
+            }
+            for (const auto& [caller, count] : g_callers[heavy][t]) {
+                std::fprintf(f, "^%llx %u\n", static_cast<unsigned long long>(caller ? caller - g_base : 0), count);
+            }
+        }
+    }
+    std::fclose(f);
+}
+
+void AddTarget(const char* name, HANDLE handle) {
+    auto* target = new Target;
+    target->name = name;
+    target->handle = handle;
+    PerfStats::t_profileWaitSlot = &target->waitSlot;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_targets.size() >= 8) return;
+    g_targets.push_back(target);
+}
+
+HANDLE CurrentThreadHandle() {
+    HANDLE handle = nullptr;
+    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &handle,
+                    THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT, FALSE, 0);
+    return handle;
+}
+
+struct Starter {
+    Starter() {
+        const char* env = std::getenv("LIFEKING_PROFILE");
+        if (env == nullptr || env[0] == '0') return;
+        g_base = reinterpret_cast<uint64_t>(GetModuleHandleA(nullptr));
+        g_active = true;
+        FindExeCode();
+        AddTarget("main", CurrentThreadHandle());
+        g_pending.reserve(4096);
+        std::atexit(Dump);
+        std::thread([] {
+            unsigned ticks = 0;
+            std::vector<Sample> local;
+            for (;;) {
+                Sleep(1);
+                if (++ticks % 5000 == 0) Dump();  // also written while running: the window may be killed
+                std::vector<Target*> targets;
+                {
+                    std::lock_guard<std::mutex> lock(g_mutex);
+                    targets = g_targets;
+                }
+                local.clear();
+                for (uint32_t t = 0; t < targets.size(); ++t) {
+                    Target* target = targets[t];
+                    const int wait = target->waitSlot.load(std::memory_order_relaxed);
+                    if (wait >= 0) {
+                        local.push_back({t, kWaitTag | static_cast<uint64_t>(wait), 0});
+                        continue;
+                    }
+                    if (SuspendThread(target->handle) == static_cast<DWORD>(-1)) continue;
+                    CONTEXT ctx;
+                    std::memset(&ctx, 0, sizeof(ctx));
+                    ctx.ContextFlags = CONTEXT_CONTROL;
+                    const bool ok = GetThreadContext(target->handle, &ctx) != FALSE;
+                    const uint64_t caller = ok && !InExeCode(ctx.Rip) ? FindCaller(ctx.Rsp) : 0;
+                    ResumeThread(target->handle);
+                    if (ok) local.push_back({t, ctx.Rip, caller});
+                }
+                std::lock_guard<std::mutex> lock(g_mutex);
+                g_pending.insert(g_pending.end(), local.begin(), local.end());
+                if (g_pending.size() > 200000) g_pending.clear();  // no frames presented (loading)
+            }
+        }).detach();
+    }
+} g_starter;
+
+} // namespace
+
+namespace LifeKingProfiler {
+bool Active() noexcept { return g_active; }
+
+void RegisterCurrentThread(const char* name) noexcept {
+    if (!g_active) return;
+    AddTarget(name, CurrentThreadHandle());
+}
+
+void OnFrame(double busyMs) noexcept {
+    if (!g_active) return;
+    const int heavy = busyMs >= kHeavyMs ? 1 : 0;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    ++g_frames[heavy];
+    for (const Sample& s : g_pending) {
+        ++g_counts[heavy][s.target][s.key];
+        if ((s.key & kWaitTag) != kWaitTag && !InExeCode(s.key)) ++g_callers[heavy][s.target][s.caller];
+    }
+    g_pending.clear();
+}
+} // namespace LifeKingProfiler
+
+#else
+namespace LifeKingProfiler {
+bool Active() noexcept { return false; }
+void RegisterCurrentThread(const char*) noexcept {}
+void OnFrame(double) noexcept {}
+} // namespace LifeKingProfiler
+#endif
