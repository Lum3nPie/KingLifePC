+        const uint8_t op = Memory::Read8(listAddr + at);
+        if (op == 0) { ++at; continue; }
+        if (op < 0x80 || op > 0xB8) break;
+        const uint32_t count = Memory::Read16(listAddr + at + 1);
+        at += 3;
