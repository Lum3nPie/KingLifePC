diff --git a/runtime/include/controller_button_names.h b/runtime/include/controller_button_names.h
index ab61c03..c3e8f09 100644
--- a/runtime/include/controller_button_names.h
+++ b/runtime/include/controller_button_names.h
@@ -98,11 +98,64 @@ inline std::string TrimToken(std::string_view token) {
     return std::string(token.substr(begin, end - begin + 1));
 }
 
+// The names other programs write for a button (RecompLauncher's chips: "A", "LB", "D-Pad Up"; the
+// PlayStation ones: "Cross", "L1"), each with the name above it stands for. They are read
+// without regard to case, spaces, dashes or underscores; the game writes the names above.
+struct ButtonAlias {
+    const char* alias;
+    const char* configName;
+};
+
+inline constexpr ButtonAlias kButtonAliases[] = {
+    {"a", "south"},           {"cross", "south"},          {"b", "east"},
+    {"circle", "east"},       {"x", "west"},               {"square", "west"},
+    {"y", "north"},           {"triangle", "north"},       {"lb", "left_shoulder"},
+    {"l1", "left_shoulder"},  {"rb", "right_shoulder"},    {"r1", "right_shoulder"},
+    {"lt", "left_trigger"},   {"l2", "left_trigger"},      {"rt", "right_trigger"},
+    {"r2", "right_trigger"},  {"ls", "left_stick"},        {"l3", "left_stick"},
+    {"rs", "right_stick"},    {"r3", "right_stick"},       {"select", "back"},
+    {"view", "back"},         {"share", "back"},           {"create", "back"},
+    {"options", "start"},     {"menu", "start"},           {"home", "guide"},
+    {"dpadup", "dpad_up"},    {"dpaddown", "dpad_down"},   {"dpadleft", "dpad_left"},
+    {"dpadright", "dpad_right"},
+};
+
+// "D-Pad Up" -> "dpadup": lower case, letters and digits only.
+inline std::string AliasKey(std::string_view name) {
+    std::string key;
+    for (const char c : name) {
+        if (c >= 'A' && c <= 'Z') {
+            key += static_cast<char>(c - 'A' + 'a');
+        } else if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) {
+            key += c;
+        }
+    }
+    return key;
+}
+
 inline const NativeButtonItem* FindNativeButton(std::string_view configName) {
-    const std::string name = TrimToken(configName.substr(0, configName.find('@')));
-    const auto it = std::find_if(kNativeButtons.begin(), kNativeButtons.end(),
-                                 [&](const NativeButtonItem& item) { return name == item.configName; });
-    return it == kNativeButtons.end() ? nullptr : &*it;
+    std::string name = TrimToken(configName.substr(0, configName.find('@')));
+    auto find = [&](const std::string& wanted) {
+        const auto it = std::find_if(kNativeButtons.begin(), kNativeButtons.end(),
+                                     [&](const NativeButtonItem& item) { return wanted == item.configName; });
+        return it == kNativeButtons.end() ? nullptr : &*it;
+    };
+    if (const NativeButtonItem* item = find(name)) {
+        return item;
+    }
+    const std::string key = AliasKey(name);
+    for (const ButtonAlias& alias : kButtonAliases) {
+        if (key == alias.alias) {
+            return find(alias.configName);
+        }
+    }
+    // The game's own names written another way ("Left Shoulder", "DPAD_UP").
+    for (const NativeButtonItem& item : kNativeButtons) {
+        if (key == AliasKey(item.configName)) {
+            return &item;
+        }
+    }
+    return nullptr;
 }
 
 // Falls back to the "unmapped" entry so callers always have a label to draw.
diff --git a/runtime/include/game_mods.h b/runtime/include/game_mods.h
new file mode 100644
index 0000000..34af5c1
--- /dev/null
+++ b/runtime/include/game_mods.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// Game mods: optional changes to a game, each with a switch in Config.toml [mods] (off unless its
+// line says true). A mod can change the game's code with FOREIGN_GAME_WRAPPER (hle_stubs.h) and its
+// files with a disc overlay: a folder shaped like the disc's files/ that the DVD layer reads on top
+// of the disc. Mods never ship the game's files; they make their copies from the player's own disc.
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace GameMods {
+
+// A mod's files for this run: write them under Folder(mod), then register it.
+std::filesystem::path Folder(const std::string& mod);
+void RegisterDiscOverlay(std::filesystem::path root);
+
+// Every enabled mod prepares its files the first time this is called (the DVD layer calls it while
+// it looks for overlays), so a mod's preparation runs once and before the disc is read.
+const std::vector<std::filesystem::path>& DiscOverlayRoots();
+
+// A mod's part of the F10 menu (a "Mods" menu appears when any mod has one available).
+struct SettingsPanel {
+    const char* name;
+    bool (*available)();
+    void (*draw)();
+};
+void RegisterSettingsPanel(SettingsPanel panel);
+bool HasSettings();
+void DrawSettings();
+
+// A game's cheats in the F10 menu (a "Cheats" menu appears when any game has one available). Kept
+// apart from the mods' menu so that cheats are never mixed in with the mods.
+void RegisterCheatsPanel(SettingsPanel panel);
+bool HasCheats();
+void DrawCheats();
+
+// A mod that uses the right stick itself (the free camera): the game then never gets it as the
+// D-pad.
+void SetRightStickTaken(bool taken);
+
+bool RightStickTaken();
+
+// A mod's preparation: registered at startup by each mod's source file.
+using PrepareFn = void (*)();
+struct Registration {
+    Registration(PrepareFn prepare);
+};
+
+} // namespace GameMods
