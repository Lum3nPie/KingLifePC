+// ---------------------------------------------------------------------------------------------
+// A game other than Mario Kart Wii
+// ---------------------------------------------------------------------------------------------
+// Such a game has no EGG screens to resize, and the ones seen so far only draw a 4:3 picture: they
+// never ask the console whether the TV is 16:9. So the choice is made outside the game. "Wide" lets
+// the frame take the shape of the window and has aurora undo the stretch that would cause
+// (AuroraSetWidePicture), which shows more of the scene at the sides. "Original" keeps the 4:3
+// picture and puts bars beside it.
+std::atomic_bool g_requestedWidePicture{true};
+
+void ApplyForeignPicture() {
+    static int applied = -1;
+    const int requested = g_requestedWidePicture.load(std::memory_order_acquire) ? 1 : 0;
+    if (applied == requested) {
+        return;
+    }
+    applied = requested;
+    // LifeKing: My Life as a King asks SCGetAspectRatio and draws its own 16:9 picture (anamorphic),
+    // keeping HUD pieces just outside the frame for their slide-in. Widening the picture would show
+    // them, and stretching it to the window distorts it, so the frame stays 16:9 whatever the window
+    // or screen shape, with black bars on the sides or top and bottom (aurora's 16:9 policy).
+    const char* gameId = GuestRegion::CurrentFacts().gameId;
+    if (gameId != nullptr && std::strcmp(gameId, "WFCPGD") == 0) {
+        AuroraSetViewportPolicy(AURORA_VIEWPORT_16_9);
+        VIUnlockAspectRatio();
+        AuroraSetWidePicture(0.0f);
+        return;
+    }
+    if (requested != 0) {
+        AuroraSetViewportPolicy(AURORA_VIEWPORT_STRETCH);
+        VIUnlockAspectRatio();
+        AuroraSetWidePicture(4.0f / 3.0f);
+    } else {
+        AuroraSetViewportPolicy(AURORA_VIEWPORT_FIT);
+        VILockAspectRatio(4, 3);
+        AuroraSetWidePicture(0.0f);
+    }
+}
+
 } // namespace
 
 
+void SetWidePicture(bool enabled) {
+    g_requestedWidePicture.store(enabled, std::memory_order_release);
+}
+
+float WidePictureAspectScale(float requestedAspect) {
+    if (!GuestRegion::IsForeignGame() || !g_requestedWidePicture.load(std::memory_order_acquire)) {
+        return 1.0f;
+    }
+    // Only the cameras made for the TV picture: 4:3, or close to it for a picture a little taller or
+    // shorter. A shadow or a reflection has its own shape and must stay as the game made it.
+    if (!(requestedAspect > 1.2f && requestedAspect < 1.5f)) {
+        return 1.0f;
+    }
+    // The shape of the frame being drawn, not of the window: after the window grows, the frame keeps
+    // its old size for a moment, and aurora fits the flat drawings (the clock, the text boxes) to the
+    // frame. A camera that followed the window got ahead of them for that moment, so a 3D piece of the
+    // clock (the pink pinwheel) sat apart from the rest of it until the frame caught up.
+    u32 width = 0;
+    u32 height = 0;
+    AuroraGetFrameBufferSize(&width, &height);
+    if (width == 0 || height == 0) {
+        AuroraGetSurfaceSize(&width, &height);  // before the first frame is made
+    }
+    if (width == 0 || height == 0) {
+        return 1.0f;
+    }
+    const float scale = (static_cast<float>(width) / static_cast<float>(height)) / (4.0f / 3.0f);
+    return scale > 1.01f ? scale : 1.0f;
+}
