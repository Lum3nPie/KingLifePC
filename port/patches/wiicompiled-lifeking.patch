+// For the frame trace: what a vertex array holds, read as three big-endian floats per entry. A model the
+// game skins on the CPU is drawn from arrays it filled itself; the first entries and the range of the first
+// few hundred show at a glance whether that skinning produced sane numbers (a model a few units wide has
+// values of that size) or garbage (huge, NaN, all zero).
+static void TraceArrayValues(const char* what, uint32_t base, uint32_t stride) {
+    if (base == 0 || stride < 12) return;
+    float lo = 1e30f, hi = -1e30f;
+    uint32_t nan = 0;
+    for (uint32_t i = 0; i < 512; ++i) {
+        for (uint32_t c = 0; c < 3; ++c) {
+            const uint32_t bits = Memory::Read32(base + i * stride + c * 4);
+            float v;
+            std::memcpy(&v, &bits, sizeof(v));
+            if (v != v) { ++nan; continue; }
+            if (v < lo) lo = v;
+            if (v > hi) hi = v;
+        }
+    }
+    float first[9];
+    for (uint32_t k = 0; k < 9; ++k) {
+        const uint32_t bits = Memory::Read32(base + (k / 3) * stride + (k % 3) * 4);
+        std::memcpy(&first[k], &bits, sizeof(float));
+    }
+    GxFrameTrace::Note("  %s: first entries (%g %g %g) (%g %g %g) (%g %g %g); range of the first 512 entries %g..%g, %u NaN",
+                       what, first[0], first[1], first[2], first[3], first[4], first[5], first[6], first[7],
+                       first[8], lo, hi, nan);
+}
+
+// For the frame trace: every entry of a position array, once per array in the first traced frame, so a
+// model can be redrawn from the log and a vertex that came out wrong can be told from one that did not.
+static void TraceArrayDump(uint32_t base, uint32_t stride) {
+    static int dumpedSession = -1;
+    static std::vector<uint32_t> dumpedBases;
+    if (GxFrameTrace::Frame() != 0 || base == 0 || stride < 12) return;
+    if (dumpedSession != GxFrameTrace::Session()) {
+        dumpedSession = GxFrameTrace::Session();
+        dumpedBases.clear();
+    }
+    for (const uint32_t seen : dumpedBases) {
+        if (seen == base) return;
+    }
+    dumpedBases.push_back(base);
+    for (uint32_t i = 0; i < 256; ++i) {
+        float v[3];
+        for (uint32_t c = 0; c < 3; ++c) {
+            const uint32_t bits = Memory::Read32(base + i * stride + c * 4);
+            std::memcpy(&v[c], &bits, sizeof(float));
+        }
+        GxFrameTrace::Note("  pos 0x%08X #%u %g %g %g", base, i, v[0], v[1], v[2]);
+    }
+}
+
+// For the frame trace: reads the draw commands at the start of a display list whose attributes are all
+// indices (the way the game draws its CPU-skinned parts) and counts how many of the positions it points
+// at are still zero in the array. A part whose skinning did not write some of its vertices would show up
+// here as references to zero positions, which is what a vertex pulled to the origin looks like.
+static void TraceDisplayListIndices(uint32_t listAddr, uint32_t nbytes, uint32_t posBase, uint32_t posStride) {
+    uint32_t vertexBytes = 0;
+    uint32_t posOffset = 0;
