+
+// For the frame trace: the vertex layout a display list is drawn with, as the worker applies it (each
+// present attribute as name:type, 1 direct, 2 index8, 3 index16, with n3/n9 for the normal), and the
+// format of its first draw when the list starts with one.
+static void TraceDisplayListLayout(uint32_t listAddr, uint32_t nbytes) {
+    static const char* const kNames[] = {"PNMTX", "T0MTX", "T1MTX", "T2MTX", "T3MTX", "T4MTX", "T5MTX",
+                                         "T6MTX", "T7MTX", "POS", "NRM", "CLR0", "CLR1", "TEX0",
+                                         "TEX1", "TEX2", "TEX3", "TEX4", "TEX5", "TEX6", "TEX7"};
