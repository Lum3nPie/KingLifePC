+// Harvest Moon: Animal Parade mod "romance_any_gender": every marriage candidate can fall in love
+// with the player, whether the player is a man or a woman. Off unless Config.toml says
+//   [mods]
+//   romance_any_gender = true
+//
+// How the game decides who can be your partner, and what this mod changes:
+//
+// - The player's sex is game variable 0x23 (0 man, 1 woman), read through 0x801071A8.
+// - The candidates are characters 1-8, the Harvest Goddess (52) and the Witch Princess (59) for a
+//   man, and characters 9-16, the Harvest King (60) and the Wizard (61) for a woman.
+// - Each candidate's heart events start from event/trig_love.db, a text file on the disc. Every
+//   event there has `attr "man"` or `attr "woman"`, and the event only starts for a player of that
+//   sex (checked at 0x8012E07C). The mod writes a copy of the file without that line for every
+//   event of a candidate (those event/varSet_love*.db gives to one), so they start for either sex.
+// - Several functions ask "is this character my candidate?" by the player's sex. The mod wraps
+//   them so they answer for the character instead: a character's natural partner is the sex the
+//   original game pairs them with, and while one of these functions runs for a candidate, the
+//   player's sex reads as that partner's.
+//
+// The dialogue needs nothing new: the disc has every candidate's love text in a version for a male
+// and for a female player (msglang/<language>/male and female), and the game picks the folder by
+// the player's sex.
+//
+// A couple of the same sex adopts their children instead: that part is romance_adoption.cpp.
+
+#include "romance_any_gender.h"
+
+#include "game_mods.h"
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_config.h"
+
+#include <imgui.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <regex>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace RomanceAnyGender {
+
+bool Enabled() {
+    static const bool enabled = RuntimeConfigFile::ModEnabled(kMod);
+    return enabled;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Who pairs with whom in the original game.
+
+// The sex the original game pairs a character with, or -1 for anyone who is not a candidate.
+int NaturalPartnerSex(uint32_t character) {
+    if ((character >= 1 && character <= 8) || character == 52 || character == 59) {
+        return kMan;
+    }
+    if ((character >= 9 && character <= 16) || character == 60 || character == 61) {
+        return kWoman;
+    }
+    return -1;
+}
+
+// ---------------------------------------------------------------------------------------------
+// The disc's text files (.db): blocks of "{", lines of "key  value", "}".
+
+std::string ReadFile(const std::filesystem::path& path) {
+    std::ifstream file(path, std::ios::binary);
+    std::ostringstream text;
+    text << file.rdbuf();
+    return text.str();
+}
+
+std::vector<std::string> Blocks(const std::string& text) {
+    std::vector<std::string> blocks;
+    size_t at = 0;
+    while ((at = text.find('{', at)) != std::string::npos) {
+        const size_t end = text.find('}', at);
+        if (end == std::string::npos) {
+            break;
+        }
+        blocks.push_back(text.substr(at, end + 1 - at));
+        at = end + 1;
+    }
+    return blocks;
+}
+
+long Number(const std::string& block, const char* key) {
+    const std::regex pattern(std::string("\\b") + key + "\\s+\"?(-?\\d+)");
+    std::smatch match;
+    return std::regex_search(block, match, pattern) ? std::stol(match[1]) : -1;
+}
+
+void PutBigEndian32(std::string& data, size_t at, uint32_t value) {
+    for (int i = 0; i < 4; ++i) {
+        data[at + i] = static_cast<char>(value >> (24 - 8 * i));
+    }
+}
+
+uint32_t ReadBigEndian32(const std::string& data, size_t at) {
+    return (uint32_t(uint8_t(data[at])) << 24) | (uint32_t(uint8_t(data[at + 1])) << 16) |
+           (uint32_t(uint8_t(data[at + 2])) << 8) | uint32_t(uint8_t(data[at + 3]));
+}
+
+// ---------------------------------------------------------------------------------------------
+// The game's state in memory (see romance_any_gender.h).
+
+uint32_t TableOffset(uint32_t table, uint32_t entry) {
+    const uint32_t base = Memory::Read32(Memory::Read32(table + 0xC) + 4) + Memory::Read32(table);
+    return Memory::Read32(base + 4 * entry) - Memory::Read32(base);
+}
+
+uint32_t VariableAddress(uint32_t variable) {
+    return Memory::Read32(kGameState) + 0x1398 + TableOffset(kVariableTable, variable);
+}
+
+} // namespace RomanceAnyGender
+
+using namespace RomanceAnyGender;
+
+namespace {
+
+// While a wrapped function runs for a candidate, the player's sex reads as this (-1: the real one).
+thread_local int t_playerSexSeenAs = -1;
+
+// Runs the game's own function at `address` as if the player were the character's natural partner.
+void RunAsNaturalPartner(uint32_t address, uint32_t character, CpuContext* ctx) {
+    const int previous = t_playerSexSeenAs;
+    const int partner = NaturalPartnerSex(character);
+    if (partner >= 0) {
+        t_playerSexSeenAs = partner;
+    }
+    GuestFunctions::BaseTranslation(address)(ctx);
+    t_playerSexSeenAs = previous;
+}
+
+} // namespace
+
+// 0x801071A8: the player's sex (game variable 0x23).
+extern "C" void AnimalParadePlayerSex(CpuContext* ctx) {
+    GuestFunctions::BaseTranslation(0x801071A8u)(ctx);
+    if (t_playerSexSeenAs >= 0) {
+        ctx->gpr[3] = static_cast<uint32_t>(t_playerSexSeenAs);
+    }
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 801071A8, AnimalParadePlayerSex);
+
+// 0x801DA2EC (character in r3): whether the character is in love with the player, read from that
+// character's own event flag; the original only looks at the flags of the player's candidates.
+extern "C" void AnimalParadeCandidateInLove(CpuContext* ctx) {
+    if (!Enabled()) {
+        GuestFunctions::BaseTranslation(0x801DA2ECu)(ctx);
+        return;
+    }
+    RunAsNaturalPartner(0x801DA2ECu, ctx->gpr[3], ctx);
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 801DA2EC, AnimalParadeCandidateInLove);
+
+// 0x801DA5BC (character in r3): whether the character can still be courted - not married to a
+// rival, the player not married, and a candidate for the player. The talk menu uses it to offer
+// the courting choices.
+extern "C" void AnimalParadeCanCourt(CpuContext* ctx) {
+    if (!Enabled()) {
+        GuestFunctions::BaseTranslation(0x801DA5BCu)(ctx);
+        return;
+    }
+    RunAsNaturalPartner(0x801DA5BCu, ctx->gpr[3], ctx);
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 801DA5BC, AnimalParadeCanCourt);
+
+// 0x8010F0B0 (character in r3): whether the character is one of the eight villagers the player can
+// marry (1-8 for a man, 9-16 for a woman). It reads variable 0x23 itself, so it is answered here.
+extern "C" void AnimalParadeIsVillageCandidate(CpuContext* ctx) {
+    if (!Enabled()) {
+        GuestFunctions::BaseTranslation(0x8010F0B0u)(ctx);
+        return;
+    }
+    const uint32_t character = ctx->gpr[3];
+    ctx->gpr[3] = (character >= 1 && character <= 16) ? 1u : 0u;
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 8010F0B0, AnimalParadeIsVillageCandidate);
+
+// 0x80181FF4 (character in r3, role in r4: 1 wife, 2 husband): the row of the costume table (the
+// "COS" file) for the spouse's clothes. The table only has each candidate in the role the original
+// gives them, so a spouse in the other role finds nothing; the mod then looks in that role.
+extern "C" void AnimalParadeSpouseCostume(CpuContext* ctx) {
+    const uint32_t character = ctx->gpr[3];
+    const uint32_t role = ctx->gpr[4];
+    GuestFunctions::BaseTranslation(0x80181FF4u)(ctx);
+    if (Enabled() && ctx->gpr[3] == 0xFFFFFFFFu && (role == 1 || role == 2)) {
+        ctx->gpr[3] = character;
+        ctx->gpr[4] = 3 - role;
+        GuestFunctions::BaseTranslation(0x80181FF4u)(ctx);
+    }
+}
+FOREIGN_GAME_WRAPPER(RBIEE9, 80181FF4, AnimalParadeSpouseCostume);
+
+namespace {
+
+// ---------------------------------------------------------------------------------------------
+// The copy of event/trig_love.db.
+
+// The events that belong to a candidate: those whose messages (varSet_love*.db) are a candidate's,
+// plus the Harvest Goddess's and the Harvest King's, whose events have no messages listed there.
+std::set<long> CandidateEvents(const std::filesystem::path& eventFolder) {
+    std::set<long> events;
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            const long character = Number(block, "chara0");
+            if (character >= 0 && NaturalPartnerSex(static_cast<uint32_t>(character)) >= 0) {
+                events.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    for (long event = 2815; event <= 2861; ++event) {
+        events.insert(event);  // the Harvest Goddess (for a man in the original)
+    }
+    for (long event = 3069; event <= 3115; ++event) {
+        events.insert(event);  // the Harvest King (for a woman in the original)
+    }
+    return events;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Testing: an easy confession. With [mods] romance_any_gender_test_proposal = true (F10 > Mods) a
+// candidate's confession, the event whose messages are L000003a (GIL_L000003a for Gill), starts at
+// any hour of the day instead of only in the evening. It is a "panel" event: it starts when the
+// player steps on its spot by the lighthouse (param/field/info/fld_info04.pBin names the spot
+// L000003a), and that spot stays. The confession has to play for real: it is what makes the
+// candidate the player's sweetheart, and without it the proposal is turned down.
+//
+// The proposal (L000005) is left as in the original: giving the candidate a Blue Feather (item
+// 1269). Its scene starts with the player holding the feather out, and started any other way
+// (talking with empty hands, at bedtime, on leaving the house) the screen stayed black.
+
+// The candidates' confession events.
+std::set<long> ConfessionEvents(const std::filesystem::path& eventFolder) {
+    std::set<long> events;
+    static const std::regex confession("msg0_0\\s+\"[A-Z]+_L000003a\"");
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            const long character = Number(block, "chara0");
+            if (character >= 0 && NaturalPartnerSex(static_cast<uint32_t>(character)) >= 0 &&
+                std::regex_search(block, confession)) {
+                events.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    return events;
+}
+
+// The confession's test trigger: its own spot by the lighthouse, at any hour of the day.
+std::string EasyConfessionTrigger(const std::string& block) {
+    static const std::regex start("timeS\\s+-?\\d+");
+    static const std::regex end("timeE\\s+-?\\d+");
+    return std::regex_replace(std::regex_replace(block, start, "timeS  6"), end, "timeE  22");
+}
+
+struct Candidate {
+    uint32_t id;
+    const char* name;
+};
+
+// The candidates by the game's numbers (the msg names of varSet_love*.db: GIL, WONG for Jin, TAO for
+// Toby, OSE for Owen, JULI for Julius, CHYA for Chase, CLVN for Calvin...).
+constexpr Candidate kCandidates[] = {
+    {9, "Gill"}, {10, "Jin"}, {11, "Toby"}, {12, "Owen"}, {13, "Luke"}, {14, "Julius"}, {15, "Chase"},
+    {16, "Calvin"}, {1, "Renee"}, {2, "Kathy"}, {3, "Maya"}, {4, "Selena"}, {5, "Phoebe"},
+    {6, "Candace"}, {7, "Anissa"}, {8, "Luna"},
+};
+
+// The candidate chosen in the panel (an index in kCandidates), kept in a file of the mod's folder
+// so the next start knows it.
+std::filesystem::path TestCandidateFile() { return GameMods::Folder(kMod) / "test_candidate.txt"; }
+
+int SavedTestCandidate() {
+    std::ifstream file(TestCandidateFile());
+    int chosen = 0;
+    if (!(file >> chosen) || chosen < 0 || chosen >= static_cast<int>(std::size(kCandidates))) {
+        chosen = 0;
+    }
+    return chosen;
+}
+
+std::atomic<int> g_chosenCandidate{0};   // in the panel now
+std::atomic<int> g_previewCandidate{0};  // when the game started: the preview's
+
+// Testing the adoption: the chosen candidate's question about a child (L000015, as GIL_L000015).
+std::set<long> ChildQuestionEvents(const std::filesystem::path& eventFolder, uint32_t chosen) {
+    std::set<long> events;
+    static const std::regex question("msg0_0\\s+\"[A-Z]+_L000015\"");
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            const long character = Number(block, "chara0");
+            if (character == static_cast<long>(chosen) && std::regex_search(block, question)) {
+                events.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    return events;
+}
+
+// prm_love.epc with every condition of these events turned into their own first one, the event's
+// "done" flag at 0, so they only need that flag (never set while testing).
+std::string OnlyOwnFlag(std::string data, const std::set<long>& events) {
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        if (events.count(static_cast<long>(ReadBigEndian32(data, row))) == 0) {
+            continue;
+        }
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        size_t own = 0;
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            if (own == 0 && ReadBigEndian32(data, at) == 0 && ReadBigEndian32(data, at + 20) == 0) {
+                own = at;
+            }
+        }
+        for (uint32_t c = 0; own != 0 && c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            data.replace(block + 0x14 + 24 * size_t(c), 24, data.substr(own, 24));
+        }
+    }
+    return data;
+}
+
+void PrepareFiles() {
+    if (!Enabled() || ::GuestRegion::ForeignGameAddress("RBIEE9", 1u) == 0) {
+        return;
+    }
+    const std::filesystem::path eventFolder = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "event";
+    const std::string original = ReadFile(eventFolder / "trig_love.db");
+    if (original.empty()) {
+        std::fprintf(stderr, "[mod %s] no event/trig_love.db on the disc; the mod is off\n", kMod);
+        return;
+    }
+    const std::set<long> events = CandidateEvents(eventFolder);
+    const bool testProposal = RuntimeConfigFile::ModEnabled(kTestProposalKey);
+    const std::set<long> confessions = ConfessionEvents(eventFolder);
+    const bool testAdoption = RuntimeConfigFile::ModEnabled(kTestAdoptionKey);
+
+    // Copy the file, leaving out the attr line of every candidate event.
+    const std::regex attrLine("[ \\t]*attr[ \\t]+\"(man|woman)\"[ \\t]*\\r?\\n");
+    std::string copy;
+    size_t at = 0;
+    int opened = 0;
+    while (true) {
+        const size_t start = original.find('{', at);
+        const size_t end = start == std::string::npos ? std::string::npos : original.find('}', start);
+        if (end == std::string::npos) {
+            copy += original.substr(at);
+            break;
+        }
+        copy += original.substr(at, start - at);
+        std::string block = original.substr(start, end + 1 - start);
+        if (events.count(Number(block, "evtNo")) != 0) {
+            const std::string before = block;
+            block = std::regex_replace(block, attrLine, "");
+            opened += block != before ? 1 : 0;
+        }
+        if (testProposal && confessions.count(Number(block, "evtNo")) != 0) {
+            block = EasyConfessionTrigger(block);
+        }
+        copy += block;
+        at = end + 1;
+    }
+
+    const std::filesystem::path root = GameMods::Folder(kMod);
+    std::error_code ec;
+    std::filesystem::create_directories(root / "event", ec);
+    std::ofstream(root / "event" / "trig_love.db", std::ios::binary | std::ios::trunc) << copy;
+    std::filesystem::remove(root / "event" / "prm_love.epc", ec);
+    if (testProposal) {
+        std::fprintf(stderr, "[mod %s] test: %zu confessions start at the lighthouse at any hour\n", kMod,
+                     confessions.size());
+    }
+    if (testAdoption) {
+        g_previewCandidate = g_chosenCandidate = SavedTestCandidate();
+        const uint32_t chosen = kCandidates[g_previewCandidate.load()].id;
+        const std::string conditions =
+            OnlyOwnFlag(ReadFile(eventFolder / "prm_love.epc"), ChildQuestionEvents(eventFolder, chosen));
+        std::fprintf(stderr, "[mod %s] test: the adoption scene plays at bedtime with %s\n", kMod,
+                     kCandidates[g_previewCandidate.load()].name);
+        if (!conditions.empty()) {
+            std::ofstream(root / "event" / "prm_love.epc", std::ios::binary | std::ios::trunc) << conditions;
+        }
+    }
+    GameMods::RegisterDiscOverlay(root);
+    std::fprintf(stderr, "[mod %s] on: %d candidate events start for either sex\n", kMod, opened);
+}
+
+const GameMods::Registration kRegistration(PrepareFiles);
+
+// ---------------------------------------------------------------------------------------------
+// Testing: F10 > Mods > "Ready to propose" puts the loaded game where the player can propose to a
+// candidate, without playing the weeks it takes, so the mod can be tried. It writes the game's
+// state directly; save in the game afterwards to keep it.
+//
+// What the proposal checks are the conditions of each candidate's proposal event in
+// event/prm_love.epc (for example Gill's 1797); where the game keeps them is described in
+// romance_any_gender.h. The Blue Feather is item 1269 (0x4F5); the gift code at 0x801D5E1C reads
+// the item the player holds from the player's object, *(0x80501D58 + 0x50), at + 0x650.
+
+constexpr uint32_t kVillagerTable = 0x8050AA24u;
+constexpr uint32_t kPlayerObject = 0x80501D58u + 0x50u;
+constexpr uint32_t kBlueFeather = 1269;
+
+uint32_t VillagerValueAddress(uint32_t character, uint32_t value) {
+    return Memory::Read32(kGameState) + (character - 1) * 0x400 + 0x1B98 + TableOffset(kVillagerTable, value);
+}
+
+// The event flags a candidate's heart events before the proposal expect to be set: every flag that
+// one of those events needs to be 1 in its conditions (prm_love.epc). That leaves the confession
+// (L000003a) to play: its own flag is only asked for by the proposal, and the confession scene is
+// what makes the candidate the player's sweetheart, which the proposal checks. A candidate's events
+// are the ones varSet_love*.db gives that character's messages; their message names count up, and
+// number 5 (GIL_L000005 for Gill) is the proposal, so these are L000000 to L000004. The file is
+// "EVTP", a count and {event, offset, size} rows, then each event's "EVCD" block: a count at 8 and
+// from 0x14 conditions of six numbers; {0, flag, -1, 0, 0, value} asks for a flag.
+//
+// It also gives the flags to clear: the ones the confession (L000003a) and the proposal (L000005)
+// need to be 0, their own "already seen", so both play again in a game where they were marked.
+std::vector<uint32_t> HeartEventFlags(uint32_t character, std::vector<uint32_t>& toClear) {
+    const std::filesystem::path eventFolder = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "event";
+    std::set<long> events;
+    std::set<long> replayed;
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(eventFolder / name))) {
+            static const std::regex beforeProposal("msg0_0\\s+\"[A-Z]+_L00000[0-4]");
+            static const std::regex toReplay("msg0_0\\s+\"[A-Z]+_L00000(3a|5)\"");
+            if (Number(block, "chara0") != static_cast<long>(character)) {
+                continue;
+            }
+            if (std::regex_search(block, beforeProposal)) {
+                events.insert(Number(block, "evtNo"));
+            }
+            if (std::regex_search(block, toReplay)) {
+                replayed.insert(Number(block, "evtNo"));
+            }
+        }
+    }
+    std::set<uint32_t> flags;
+    std::set<uint32_t> cleared;
+    const std::string data = ReadFile(eventFolder / "prm_love.epc");
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        const long event = static_cast<long>(ReadBigEndian32(data, row));
+        if (events.count(event) == 0 && replayed.count(event) == 0) {
+            continue;
+        }
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            if (ReadBigEndian32(data, at) != 0) {
+                continue;
+            }
+            if (events.count(event) != 0 && ReadBigEndian32(data, at + 20) == 1) {
+                flags.insert(ReadBigEndian32(data, at + 4));
+            }
+            if (replayed.count(event) != 0 && ReadBigEndian32(data, at + 20) == 0) {
+                cleared.insert(ReadBigEndian32(data, at + 4));
+            }
+        }
+    }
+    for (const uint32_t flag : flags) {
+        cleared.erase(flag);
+    }
+    toClear.assign(cleared.begin(), cleared.end());
+    return {flags.begin(), flags.end()};
+}
+
+// Gives the player a Blue Feather the way the game's scenes give items (command 0x306, 0x8010D8A0):
+// {item, count} pairs of 16 bits in a queue of 30 at 0x80502180 + 0x9C, which the game moves into
+// the rucksack at once (an empty slot is item -1). The proposal asks for one in the rucksack
+// ({10, 1269, 0, >=, 0, 1} in prm_love.epc): a feather only in the hands is given as a plain gift.
+// Then it puts the feather in the player's hands; false while the player is not on screen.
+bool HoldBlueFeather() {
+    constexpr uint32_t kGivenItems = 0x80502180u + 0x9Cu;
+    for (uint32_t slot = 0; slot < 30; ++slot) {
+        const uint32_t at = kGivenItems + 4 * slot;
+        if (static_cast<int16_t>(Memory::Read16(at)) == -1) {
+            Memory::Write16(at, static_cast<uint16_t>(kBlueFeather));
+            Memory::Write16(at + 2, 1);
+            break;
+        }
+    }
+    const uint32_t player = Memory::Read32(kPlayerObject);
+    if (player == 0 || !Memory::Contains(player + 0x650, 4)) {
+        return false;
+    }
+    Memory::Write32(player + 0x650, kBlueFeather);
+    return true;
+}
+
+// "Finish the story": the story's events are event/trig_main.db, with `attr "main1"` and "main2" for
+// its first two parts (ringing the bells) and "main3" for what comes after; the part the game is in
+// is entry 0 of the story table, state + 0x1798 + offset (table 0x8050AAB0, read by 0x80112308), and
+// 0x8012E07C compares it (0, 1, 2) with those attrs. The button sets every event flag the first two
+// parts' conditions (prm_main.epc) look at, as if all of it had happened, and moves the story on to
+// the third part. Small flag numbers (below 1400) are counters shared with the rest of the game and
+// are left alone, as are flags the conditions want at 2 or more. It also marks every villager as met.
+constexpr uint32_t kStoryTable = 0x8050AAB0u;
+
+std::vector<uint32_t> StoryFlags() {
+    const std::filesystem::path eventFolder = RuntimeConfigFile::ResolvedDvdRoot() / "files" / "event";
+    std::set<long> events;
+    static const std::regex firstParts("attr\\s+\"main[12]\"");
+    for (const std::string& block : Blocks(ReadFile(eventFolder / "trig_main.db"))) {
+        if (std::regex_search(block, firstParts)) {
+            events.insert(Number(block, "evtNo"));
+        }
+    }
+    std::set<uint32_t> flags;
+    const std::string data = ReadFile(eventFolder / "prm_main.epc");
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        if (events.count(static_cast<long>(ReadBigEndian32(data, row))) == 0) {
+            continue;
+        }
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            const uint32_t flag = ReadBigEndian32(data, at + 4);
+            if (ReadBigEndian32(data, at) == 0 && ReadBigEndian32(data, at + 20) <= 1 && flag >= 1400) {
+                flags.insert(flag);
+            }
+        }
+    }
+    return {flags.begin(), flags.end()};
+}
+
+bool GameLoaded() {
+    const uint32_t state = Memory::Read32(kGameState);
+    return state != 0 && Memory::Contains(state, 0x1000);
+}
+
+void DrawTestPanel() {
+    int chosen = g_chosenCandidate.load();
+    static std::string result;
+    ImGui::TextWrapped("For testing the mod. Load a game, choose a candidate and press Ready to propose: "
+                       "all hearts, the heart events up to the confession, the house built up and a Blue "
+                       "Feather in your hands. Then save in the game. It changes that game's progress.");
+    if (ImGui::BeginCombo("Candidate", kCandidates[chosen].name)) {
+        for (int i = 0; i < static_cast<int>(std::size(kCandidates)); ++i) {
+            if (ImGui::Selectable(kCandidates[i].name, i == chosen)) {
+                chosen = i;
+                g_chosenCandidate = i;
+                std::ofstream(TestCandidateFile(), std::ios::trunc) << i;
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::BeginDisabled(!GameLoaded());
+    if (ImGui::Button("Ready to propose")) {
+        const uint32_t character = kCandidates[chosen].id;
+        Memory::Write32(VillagerValueAddress(character, 1), 1000);
+        std::vector<uint32_t> toClear;
+        const std::vector<uint32_t> flags = HeartEventFlags(character, toClear);
+        const uint32_t state = Memory::Read32(kGameState);
+        for (const uint32_t flag : flags) {
+            Memory::Write8(state + 0x118 + flag, 1);
+        }
+        for (const uint32_t flag : toClear) {
+            Memory::Write8(state + 0x118 + flag, 0);
+        }
+        // Flag 1270: the player already has a sweetheart. Every candidate's date and confession
+        // invitations need it at 0 (prm_love.epc), and the confession sets it again for this one.
+        Memory::Write8(state + 0x118 + 1270, 0);
+        const uint32_t house = VariableAddress(85);
+        if (static_cast<int32_t>(Memory::Read32(house)) < 1) {
+            Memory::Write32(house, 1);
+        }
+        const bool feather = HoldBlueFeather();
+        result = std::string(kCandidates[chosen].name) + ": 10 hearts, " + std::to_string(flags.size()) +
+                 " heart event flags set (the confession still to come), house built up" +
+                 (feather ? ", Blue Feather in your hands. Save, then give it to them."
+                          : ". Save; then, on the farm or in town, press Hold a Blue Feather and give it to them.");
+        std::fprintf(stderr, "[mod %s] test: %s\n", kMod, result.c_str());
+    }
+    ImGui::SameLine();
+    if (ImGui::Button("Hold a Blue Feather")) {
+        result = HoldBlueFeather()
+            ? "A Blue Feather in the rucksack and the player's hands (it may not show). Give it to the candidate."
+            : "The player is not on screen.";
+        std::fprintf(stderr, "[mod %s] test: %s\n", kMod, result.c_str());
+    }
+    static bool s_atHome = RuntimeConfigFile::ModEnabled(kTestProposalKey);
+    if (ImGui::Checkbox("Confession at any hour (next start)", &s_atHome)) {
+        RuntimeConfigFile::SetModEnabled(kTestProposalKey, s_atHome);
+    }
+    ImGui::TextDisabled("The confession starts at its spot in front of the lighthouse at any hour. Then propose "
+                        "as in the game: give the candidate the Blue Feather.");
+    static bool s_adoption = RuntimeConfigFile::ModEnabled(kTestAdoptionKey);
+    if (ImGui::Checkbox("Adoption scene at bedtime (next start)", &s_adoption)) {
+        RuntimeConfigFile::SetModEnabled(kTestAdoptionKey, s_adoption);
+    }
+    ImGui::TextDisabled("Go to bed at home: a preview of the Harvest Goddess's adoption scene plays with the "
+                        "candidate chosen above when the game started, in any game. It changes nothing in the "
+                        "game.");
+    if (RuntimeConfigFile::ModEnabled(kTestAdoptionKey)) {
+        ImGui::TextDisabled("Preview now: %s.", kCandidates[g_previewCandidate.load()].name);
+    }
+    if (ImGui::Button("Finish the story (all bells rung)")) {
+        const std::vector<uint32_t> flags = StoryFlags();
+        const uint32_t state = Memory::Read32(kGameState);
+        for (const uint32_t flag : flags) {
+            Memory::Write8(state + 0x118 + flag, 1);
+        }
+        Memory::Write32(state + 0x1798 + TableOffset(kStoryTable, 0), 2);
+        // Everyone met, so the game stops asking for introductions: a villager's value 0 says the
+        // player has met them (0x8010A2E4 adds no hearts while it is 0). Villagers are 1 to 63.
+        int met = 0;
+        for (uint32_t character = 1; character <= 63; ++character) {
+            const uint32_t address = VillagerValueAddress(character, 0);
+            if (Memory::Read32(address) == 0) {
+                Memory::Write32(address, 1);
+                ++met;
+            }
+        }
+        result = std::to_string(flags.size()) + " story flags set, story moved to its last part, " +
+                 std::to_string(met) + " villagers met. Save, sleep and see who is in town.";
+        std::fprintf(stderr, "[mod %s] test: %s\n", kMod, result.c_str());
+    }
+    ImGui::EndDisabled();
+    if (!result.empty()) {
+        ImGui::TextWrapped("%s", result.c_str());
+    }
+}
+
+const bool kPanel = (GameMods::RegisterSettingsPanel({"Romance for everyone (testing)", Enabled, DrawTestPanel}), true);
+
+} // namespace
+
+uint32_t RomanceAnyGender::AdoptionPreviewCharacter() {
+    return kCandidates[g_previewCandidate.load()].id;
+}
diff --git a/runtime/src/hle/game_mods/romance_any_gender.h b/runtime/src/hle/game_mods/romance_any_gender.h
