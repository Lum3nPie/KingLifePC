+std::u16string Utf16(const std::string& text) {
+    std::u16string out;
+    for (size_t i = 0; i < text.size();) {
+        const uint8_t byte = static_cast<uint8_t>(text[i]);
+        uint32_t code = byte;
+        size_t length = 1;
+        if (byte >= 0xF0) {
+            code = byte & 0x07;
+            length = 4;
+        } else if (byte >= 0xE0) {
+            code = byte & 0x0F;
+            length = 3;
+        } else if (byte >= 0xC0) {
+            code = byte & 0x1F;
+            length = 2;
+        }
+        for (size_t k = 1; k < length && i + k < text.size(); ++k) {
+            code = (code << 6) | (static_cast<uint8_t>(text[i + k]) & 0x3F);
+        }
+        out.push_back(static_cast<char16_t>(code));
+        i += length;
+    }
+    return out;
+}
+
+// One message as the packs keep it, "MSGB": its line breaks, pages (split by %g%), longest line
+// and the most line breaks in a page, then the text in UTF-16. A name (%A%, %0D%) counts as 8.
+std::string MessageEntry(const std::string& text) {
+    const std::u16string utf16 = Utf16(text);
+    uint32_t breaks = 0;
+    uint32_t pages = 1;
+    uint32_t longest = 0;
+    uint32_t pageBreaks = 0;
+    uint32_t mostPageBreaks = 0;
+    uint32_t line = 0;
+    for (size_t i = 0; i < text.size(); ++i) {
+        if (text[i] == '\n') {
+            ++breaks;
+            ++pageBreaks;
+            line = 0;
+        } else if (text[i] == '%') {
+            const size_t close = text.find('%', i + 1);
+            const std::string code = text.substr(i + 1, close - i - 1);
+            if (code == "g") {
+                ++pages;
+                mostPageBreaks = std::max(mostPageBreaks, pageBreaks);
+                pageBreaks = 0;
+            } else if (code == "A" || code == "0D" || code == "1D") {
+                line += 8;
+            }
+            i = close;
+        } else if ((static_cast<uint8_t>(text[i]) & 0xC0) != 0x80) {
+            ++line;
+        }
+        longest = std::max(longest, line);
+    }
+    mostPageBreaks = std::max(mostPageBreaks, pageBreaks);
+    std::string entry;
+    const uint32_t header[8] = {0x4D534742u, 0x01000001u, breaks, pages, longest, mostPageBreaks, 0x20,
+                                static_cast<uint32_t>(2 * utf16.size())};
+    entry.resize(0x20);
+    for (int i = 0; i < 8; ++i) {
+        PutBigEndian32(entry, 4 * size_t(i), header[i]);
+    }
+    for (const char16_t unit : utf16) {
+        entry.push_back(static_cast<char>(unit >> 8));
+        entry.push_back(static_cast<char>(unit & 0xFF));
+    }
+    return entry;
+}
+
+// A message pack ("MSGP": a count at 8, the rows {message, offset, size} from 0x14, then the
+// messages from the offset at 0x10) with the Goddess's lines added; empty if it is not a pack or
+// already has them.
+std::string WithGoddessLines(const std::string& pack, bool spanish, bool women) {
+    if (pack.size() < 0x14 || pack.compare(0, 4, "MSGP") != 0) {
+        return {};
+    }
+    const uint32_t count = ReadBigEndian32(pack, 8);
+    const uint32_t data = ReadBigEndian32(pack, 0x10);
+    if (data > pack.size() || 0x14 + 12 * size_t(count) > data) {
+        return {};
+    }
+    std::string rows = pack.substr(0x14, 12 * size_t(count));
+    std::string messages = pack.substr(data);
+    for (uint32_t i = 0; i < count; ++i) {
+        if (ReadBigEndian32(rows, 12 * size_t(i)) == kDoNotBeAfraid) {
+            return {};
+        }
+    }
+    for (const GoddessLine& line : kGoddessLines) {
+        const char* text = spanish ? (women && line.spanishWomen ? line.spanishWomen : line.spanishMen) : line.english;
+        const std::string entry = MessageEntry(text);
+        std::string row(12, '\0');
+        PutBigEndian32(row, 0, line.id);
+        PutBigEndian32(row, 4, static_cast<uint32_t>(messages.size()));
+        PutBigEndian32(row, 8, static_cast<uint32_t>(entry.size()));
+        rows += row;
+        messages += entry;
+    }
+    const uint32_t newCount = count + static_cast<uint32_t>(std::size(kGoddessLines));
+    std::string out = pack.substr(0, 0x14);
+    PutBigEndian32(out, 8, newCount);
+    PutBigEndian32(out, 0xC, 0x14);
+    PutBigEndian32(out, 0x10, 0x14 + 12 * newCount);
+    return out + rows + messages;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Reading what the scene needs from the disc.
+
+// Each event's own "done" flag: the flag its conditions (prm_love.epc) want at 0.
+std::map<long, uint32_t> OwnFlags(const std::string& data) {
+    std::map<long, uint32_t> flags;
+    if (data.size() < 20 || data.compare(0, 4, "EVTP") != 0) {
+        return flags;
+    }
+    const uint32_t count = ReadBigEndian32(data, 8);
+    const size_t blocks = 20 + 12 * size_t(count);
+    for (uint32_t i = 0; i < count && blocks <= data.size(); ++i) {
+        const size_t row = 20 + 12 * size_t(i);
+        const size_t block = blocks + ReadBigEndian32(data, row + 4);
+        const size_t size = ReadBigEndian32(data, row + 8);
+        if (block + size > data.size() || size < 0x14) {
+            continue;
+        }
+        const uint32_t conditions = ReadBigEndian32(data, block + 8);
+        for (uint32_t c = 0; c < conditions && 0x14 + 24 * size_t(c + 1) <= size; ++c) {
+            const size_t at = block + 0x14 + 24 * size_t(c);
+            if (ReadBigEndian32(data, at) == 0 && ReadBigEndian32(data, at + 12) == 0 &&
+                ReadBigEndian32(data, at + 20) == 0) {
+                flags[static_cast<long>(ReadBigEndian32(data, row))] = ReadBigEndian32(data, at + 4);
+                break;
+            }
+        }
+    }
+    return flags;
+}
+
+// The child each spouse asks for when the player lets them choose, from LC_L000015: "is the
+// spouse n" (0x347 1 n) followed by "the child is" (0x382 62 0 sex).
+std::map<uint32_t, int> PreferredSexes(const std::string& data) {
+    std::map<uint32_t, int> sexes;
+    if (data.size() < 0x1C || data.compare(0, 4, "OPAL") != 0) {
+        return sexes;
+    }
+    const uint32_t table = ReadBigEndian32(data, 0xC);
+    const uint32_t code = ReadBigEndian32(data, 0x10);
+    const uint32_t count = ReadBigEndian32(data, 0x14);
+    long spouse = -1;
+    int since = 0;
+    for (uint32_t i = 0; i < count && table + 4 * size_t(i + 1) <= data.size(); ++i) {
+        const size_t at = code + ReadBigEndian32(data, table + 4 * size_t(i));
+        if (at + 24 > data.size()) {
+            break;
+        }
+        const uint32_t command = ReadBigEndian32(data, at) & 0xFFF;
+        if (command == 0x347 && ReadBigEndian32(data, at + 4) == 1) {
+            spouse = static_cast<long>(ReadBigEndian32(data, at + 8));
+            since = 0;
+        } else if (command == 0x382 && spouse >= 0 && since < 6 && ReadBigEndian32(data, at + 4) == kFirstChild) {
+            sexes[static_cast<uint32_t>(spouse)] = static_cast<int>(ReadBigEndian32(data, at + 16));
+            spouse = -1;
+        }
+        ++since;
+    }
+    return sexes;
+}
+
+// A message set file with the ten birth lines added to the question sets (slots 20 to 29).
+std::string WithBirthLines(const std::string& text, const std::map<std::string, std::vector<long>>& sets) {
+    static const std::regex question("msgSet\\s+\"([A-Z]+)_L0000(15|29)\"");
+    const std::string newline = text.find("\r\n") != std::string::npos ? "\r\n" : "\n";
+    std::string out;
+    size_t at = 0;
+    while (true) {
+        const size_t start = text.find('{', at);
+        const size_t end = start == std::string::npos ? std::string::npos : text.find('}', start);
+        if (end == std::string::npos) {
+            out += text.substr(at);
+            break;
+        }
+        out += text.substr(at, start - at);
+        std::string block = text.substr(start, end - start);
+        std::smatch match;
+        if (std::regex_search(block, match, question)) {
+            const std::string own = match[1].str() + "_L0000" + match[2].str();
+            const std::string birth = match[1].str() + (match[2].str() == "15" ? "_L000016" : "_L000030");
+            const auto mine = sets.find(own);
+            const auto births = sets.find(birth);
+            if (mine != sets.end() && births != sets.end() && !mine->second.empty() && !births->second.empty() &&
+                mine->second.size() <= size_t(kAddedSlot)) {
+                while (!block.empty() && (block.back() == ' ' || block.back() == '\t')) {
+                    block.pop_back();
+                }
+                if (block.size() < newline.size() || block.compare(block.size() - newline.size(), newline.size(), newline) != 0) {
+                    block += newline;
+                }
+                for (size_t slot = mine->second.size(); slot < size_t(kAddedSlot); ++slot) {
+                    block += "  msg" + std::to_string(slot) + "  " + std::to_string(mine->second[0]) + newline;
+                }
+                for (int i = 0; i < 10; ++i) {
+                    const size_t from = size_t(kBirthSlotsAdded[i]);
+                    const long id = from < births->second.size() ? births->second[from] : births->second[0];
+                    block += "  msg" + std::to_string(kAddedSlot + i) + "  " + std::to_string(id) + newline;
+                }
+            }
+        }
+        out += block + "}";
+        at = end + 1;
+    }
+    return out;
+}
+
+// A wedding scene (loveGirl/LG_L000007.opb or loveBoy/LB_L000007.opb) whose last shot has the
+// couple side by side instead of one carrying the other. In that shot both are placed (0x086) on
+// the same spot and play motion 0x225; here the player moves `playerShift` along x and the spouse
+// the other way (the vows put them about one unit apart along x), the player plays 0x8D (the
+// player's cheer earlier in the scene) and the spouse 0x33F (the spouse's, which candidates of
+// both sexes play). Empty if the scene is not as expected.
+std::string WeddingSideBySide(std::string data, float playerShift) {
+    if (data.size() < 0x1C || data.compare(0, 4, "OPAL") != 0) {
+        return {};
+    }
+    const uint32_t table = ReadBigEndian32(data, 0xC);
+    const uint32_t code = ReadBigEndian32(data, 0x10);
+    const uint32_t count = ReadBigEndian32(data, 0x14);
+    if (table + 4 * size_t(count) > data.size()) {
+        return {};
+    }
+    size_t lastPlace[2] = {0, 0};  // the player's and the spouse's last 0x086 so far
+    int changed = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+        const size_t at = code + ReadBigEndian32(data, table + 4 * size_t(i));
+        if (at + 12 > data.size()) {
+            return {};
+        }
+        const uint32_t command = ReadBigEndian32(data, at) & 0xFFF;
+        const uint32_t who = ReadBigEndian32(data, at + 4);
+        const int which = who == kPlayer ? 0 : who == kSpouse ? 1 : -1;
+        if (which < 0) {
+            continue;
+        }
+        if (command == 0x086) {
+            lastPlace[which] = at;
+        } else if (command == 0x08B && ReadBigEndian32(data, at + 8) == 0x225 && lastPlace[which] != 0) {
+            PutBigEndian32(data, at + 8, which == 0 ? 0x8D : 0x33F);
+            // 0x086: who, then x and z, each after the word 0x02000000.
+            const size_t x = lastPlace[which] + 12;
+            const uint32_t bits = ReadBigEndian32(data, x);
+            float value;
+            std::memcpy(&value, &bits, 4);
+            PutBigEndian32(data, x, Bits(value + (which == 0 ? playerShift : -playerShift)));
+            ++changed;
+        }
+    }
+    return changed == 2 ? data : std::string();
+}
+
+// A Harvest King's birth scene (loveGod/GOD_L000016.opb or GOD_L000030.opb) for a man. Before the
+// fade the player feels ill; after it the game has him in bed, as the one who gave birth, and the
+// King comes to the bedside with the baby. For a man the copy changes:
+// - the player's motion 0x93 (holding the belly) becomes 0x8D (the player's cheer), wherever the
+//   scene loads (0x08F) or plays (0x08B: who, motion, 1, the motion after it) it, and the drops of
+//   sweat over him (0x28D: a number, who, effect 0x6D) become effect 0x74, the yellow sparkles of
+//   glad surprise;
+// - after the fade nobody goes to the bed. The scene is staged like the mod's own Goddess scene
+//   in the same house (BuildScene): the player stands where he stood before the fade (0x087 into
+//   the bed becomes x 13.835, z 3.383, turned 90 to face -x), the King and the baby stand in
+//   front of him where the King stood before (0x086 at x 12.516, z 3.650 and x 12.5, z 3.7, turned
+//   272.8 to face him), the lying motion 0x128 becomes the cheer, and every shot after the fade is
+//   kWholeRoom, the shot from beside the two that shows them face to face. (Tried in the game: any
+//   spot near the bed left the player on it or hidden behind the King in the original shots.)
+// Empty if the scene is not as expected.
+std::string KingBirthForMen(std::string data) {
+    if (data.size() < 0x1C || data.compare(0, 4, "OPAL") != 0) {
+        return {};
+    }
+    constexpr uint32_t kKing = 60;
+    const uint32_t table = ReadBigEndian32(data, 0xC);
+    const uint32_t code = ReadBigEndian32(data, 0x10);
+    const uint32_t count = ReadBigEndian32(data, 0x14);
+    if (table + 4 * size_t(count) > data.size()) {
+        return {};
+    }
+    // A float argument is two words, 0x02000000 and its bits: the n-th float after "who" is at
+    // at + 12 + 8n.
+    const auto putFloat = [&](size_t at, int n, float value) {
+        if (at + 16 + 8 * size_t(n) <= data.size() && ReadBigEndian32(data, at + 8 + 8 * size_t(n)) == 0x02000000u) {
+            PutBigEndian32(data, at + 12 + 8 * size_t(n), Bits(value));
+        }
+    };
+    int cheers = 0, placed = 0, stood = 0;
+    bool afterFade = false;
+    for (uint32_t i = 0; i < count; ++i) {
+        const size_t at = code + ReadBigEndian32(data, table + 4 * size_t(i));
+        if (at + 12 > data.size()) {
+            return {};
+        }
+        const uint32_t command = ReadBigEndian32(data, at) & 0xFFF;
+        const uint32_t who = ReadBigEndian32(data, at + 4);
+        const bool baby = who == kFirstChild || who == kSecondChild;
+        if (command == 0x28D && at + 16 <= data.size() && ReadBigEndian32(data, at + 8) == kPlayer &&
+            ReadBigEndian32(data, at + 12) == 0x6D) {
+            PutBigEndian32(data, at + 12, 0x74);
+            continue;
+        }
+        if ((command == 0x08F || command == 0x08B) && who == kPlayer) {
+            for (const size_t word : {at + 8, at + 16}) {
+                if ((word == at + 8 || command == 0x08B) && word + 4 <= data.size() &&
+                    ReadBigEndian32(data, word) == 0x93) {
+                    PutBigEndian32(data, word, 0x8D);
+                    ++cheers;
+                }
+            }
+            // Lying down: the cheer instead, then standing (motion 0).
+            if (command == 0x08B && at + 20 <= data.size() && ReadBigEndian32(data, at + 8) == 0x128) {
+                PutBigEndian32(data, at + 8, 0x8D);
+                PutBigEndian32(data, at + 16, 0x00);
+                ++stood;
+            }
+            continue;
+        }
+        // Into the bed: the fade is over, and the player stays on his feet where he stood.
+        if (command == 0x087 && who == kPlayer) {
+            putFloat(at, 0, 13.835f);
+            putFloat(at, 2, 3.383f);
+            afterFade = true;
+            ++placed;
+            continue;
+        }
+        if (!afterFade) {
+            continue;
+        }
+        if (command == 0x091 && (who == kPlayer || who == kKing || baby)) {
+            putFloat(at, 1, who == kPlayer ? 90.064f : 272.834f);
+        } else if (command == 0x086 && who == kKing) {
+            putFloat(at, 0, 12.516f);
+            putFloat(at, 1, 3.650f);
+        } else if (command == 0x086 && baby) {
+            putFloat(at, 0, 12.500f);
+            putFloat(at, 1, 3.700f);
+        } else if (command == 0x0C2 || command == 0x0C3) {
+            // The camera's position (0x0C2) or aim (0x0C3): three floats from at + 4.
+            const float position[3] = {kWholeRoom.x, kWholeRoom.y, kWholeRoom.z};
+            const float aim[3] = {kWholeRoom.dx, kWholeRoom.dy, kWholeRoom.dz};
+            const float* shot = command == 0x0C2 ? position : aim;
+            for (int n = 0; n < 3; ++n) {
+                if (at + 12 + 8 * size_t(n) <= data.size() && ReadBigEndian32(data, at + 4 + 8 * size_t(n)) == 0x02000000u) {
+                    PutBigEndian32(data, at + 8 + 8 * size_t(n), Bits(shot[n]));
+                }
+            }
+        }
+    }
+    return cheers != 0 && placed == 1 && stood == 1 ? data : std::string();
+}
+
+void PrepareAdoption() {
+    if (!Enabled() || ::GuestRegion::ForeignGameAddress("RBIEE9", 1u) == 0) {
+        return;
+    }
+    const std::filesystem::path files = RuntimeConfigFile::ResolvedDvdRoot() / "files";
+    const std::filesystem::path events = files / "event";
+
+    // The spouses' child events, from the names of their message sets.
+    std::map<uint32_t, Spouse> byCharacter;
+    static const std::regex childEvent("msg0_0\\s+\"[A-Z]+_L0000(15|16|29|30)\"");
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(events / name))) {
+            std::smatch match;
+            const long character = Number(block, "chara0");
+            if (!std::regex_search(block, match, childEvent) || character < 0 ||
+                NaturalPartnerSex(static_cast<uint32_t>(character)) < 0 || character == 52 || character == 60) {
+                continue;
+            }
+            Spouse& spouse = byCharacter[static_cast<uint32_t>(character)];
+            spouse.character = static_cast<uint32_t>(character);
+            const long event = Number(block, "evtNo");
+            const std::string which = match[1].str();
+            (which == "15" ? spouse.askEvent[0] : which == "29" ? spouse.askEvent[1]
+             : which == "16" ? spouse.birthEvent[0] : spouse.birthEvent[1]) = event;
+        }
+    }
+    // The candidates' weddings (their L000007 events).
+    g_weddings.clear();
+    static const std::regex weddingEvent("msg0_0\\s+\"[A-Z]+_L000007\"");
+    for (const char* name : {"varSet_loveM.db", "varSet_loveW.db"}) {
+        for (const std::string& block : Blocks(ReadFile(events / name))) {
+            const long character = Number(block, "chara0");
+            const long event = Number(block, "evtNo");
+            if (std::regex_search(block, weddingEvent) && character >= 1 && character <= 16 && event >= 0) {
+                g_weddings[static_cast<uint32_t>(event)] = static_cast<uint32_t>(character);
+            }
+        }
+    }
+    const std::map<long, uint32_t> flags = OwnFlags(ReadFile(events / "prm_love.epc"));
+    const std::map<uint32_t, int> sexes =
+        PreferredSexes(ReadFile(files / "script" / "love" / "loveCommon" / "LC_L000015.opb"));
+    g_spouses.clear();
+    g_adoptions.clear();
+    for (auto& [character, spouse] : byCharacter) {
+        bool complete = true;
+        for (int child = 0; child < 2; ++child) {
+            const auto ask = flags.find(spouse.askEvent[child]);
+            const auto birth = flags.find(spouse.birthEvent[child]);
+            complete = complete && ask != flags.end() && birth != flags.end();
+            if (complete) {
+                spouse.askFlag[child] = ask->second;
+                spouse.birthFlag[child] = birth->second;
+            }
+        }
+        if (!complete) {
+            std::fprintf(stderr, "[mod %s] adoption: character %u's child events are incomplete; skipped\n", kMod,
+                         character);
+            continue;
+        }
+        const auto sex = sexes.find(character);
+        spouse.preferredSex = sex != sexes.end() ? sex->second : 0;
+        const int preview = static_cast<int>(g_spouses.size());
+        g_spouses.push_back(spouse);
+        for (int child = 0; child < 2; ++child) {
+            g_adoptions[static_cast<uint32_t>(spouse.askEvent[child])] = {character, child, false, preview};
+            g_adoptions[static_cast<uint32_t>(spouse.birthEvent[child])] = {character, child, true, preview};
+        }
+    }
+    if (g_spouses.empty()) {
+        std::fprintf(stderr, "[mod %s] adoption: no child events found; the scene is off\n", kMod);
+        g_weddings.clear();
+        return;
+    }
+
+    const std::filesystem::path root = GameMods::Folder(std::string(kMod) + "_adoption");
+    std::error_code ec;
+    std::filesystem::create_directories(root / "script" / "test" / "sample", ec);
+    std::filesystem::create_directories(root / "event", ec);
+    const std::filesystem::path scenes = root / "script" / "test" / "sample";
+    const auto write = [&](const char* name, const std::string& scene) {
+        std::ofstream(scenes / name, std::ios::binary | std::ios::trunc) << scene;
+    };
+    write("sample_125.opb", BuildScene(Part::kQuestion, 0, true, g_spouses));
+    write("sample_126.opb", BuildScene(Part::kQuestion, 1, true, g_spouses));
+    write("sample_127.opb", BuildScene(Part::kGoddess, 0, true, g_spouses));
+    write("sample_122.opb", BuildScene(Part::kGoddess, 0, false, g_spouses));
+    write("sample_123.opb", BuildScene(Part::kGoddess, 1, true, g_spouses));
+    // The weddings of two brides and of two grooms. The groom stands on the larger x in the vows.
+    const std::filesystem::path love = files / "script" / "love";
+    const std::string brides = WeddingSideBySide(ReadFile(love / "loveGirl" / "LG_L000007.opb"), 0.45f);
+    const std::string grooms = WeddingSideBySide(ReadFile(love / "loveBoy" / "LB_L000007.opb"), -0.45f);
+    if (brides.empty() || grooms.empty()) {
+        std::fprintf(stderr, "[mod %s] wedding: the last shot is not as expected; it stays as is\n", kMod);
+        g_weddings.clear();
+    } else {
+        std::ofstream(scenes / "sample_120.opb", std::ios::binary | std::ios::trunc) << brides;
+        std::ofstream(scenes / "sample_121.opb", std::ios::binary | std::ios::trunc) << grooms;
+    }
+    // The Harvest King's births for a man.
+    const std::string kingFirst = KingBirthForMen(ReadFile(love / "loveGod" / "GOD_L000016.opb"));
+    const std::string kingSecond = KingBirthForMen(ReadFile(love / "loveGod" / "GOD_L000030.opb"));
+    g_kingBirthsForMen = !kingFirst.empty() && !kingSecond.empty();
+    if (g_kingBirthsForMen) {
+        write("sample_118.opb", kingFirst);
+        write("sample_119.opb", kingSecond);
+    } else {
+        std::fprintf(stderr, "[mod %s] the Harvest King's births are not as expected; they stay as is\n", kMod);
+    }
+    g_testAdoption = RuntimeConfigFile::ModEnabled(kTestAdoptionKey);
+    if (g_testAdoption) {
+        for (size_t i = 0; i < g_spouses.size(); ++i) {
+            const std::string name = "sample_" + std::to_string(100 + i) + ".opb";
+            std::ofstream(scenes / name, std::ios::binary | std::ios::trunc)
+                << BuildScene(Part::kPreview, 0, true, g_spouses, g_spouses[i].character);
+        }
+    }
+
+    // The message sets, with the birth lines added to the questions'.
+    std::map<std::string, std::vector<long>> sets;
+    for (const char* name : {"msgSet_loveM.db", "msgSet_loveW.db"}) {
+        static const std::regex setName("msgSet\\s+\"([^\"]+)\"");
+        for (const std::string& block : Blocks(ReadFile(events / name))) {
+            std::smatch match;
+            if (!std::regex_search(block, match, setName)) {
+                continue;
+            }
+            std::vector<long>& ids = sets[match[1].str()];
+            for (int slot = 0;; ++slot) {
+                const long id = Number(block, ("msg" + std::to_string(slot)).c_str());
+                if (id < 0) {
+                    break;
+                }
+                ids.push_back(id);
+            }
+        }
+    }
+    for (const char* name : {"msgSet_loveM.db", "msgSet_loveW.db"}) {
+        const std::string original = ReadFile(events / name);
+        if (!original.empty()) {
+            std::ofstream(root / "event" / name, std::ios::binary | std::ios::trunc) << WithBirthLines(original, sets);
+        }
+    }
+
+    // The Goddess's lines in every love message pack, and the lines a couple of the same sex sees
+    // fixed for them (romance_lines.cpp).
+    int packs = 0;
+    int fixedLines = 0;
+    for (const auto& language : std::filesystem::directory_iterator(files / "msglang", ec)) {
+        for (const char* sex : {"male", "female"}) {
+            const std::filesystem::path folder = language.path() / sex;
+            for (const auto& entry : std::filesystem::directory_iterator(folder, ec)) {
+                const std::string file = entry.path().filename().string();
+                if (file.rfind("love", 0) != 0 || entry.path().extension() != ".mpc") {
+                    continue;
+                }
+                std::string pack = WithGoddessLines(ReadFile(entry.path()), language.path().filename() == "spa",
+                                                    std::string(sex) == "female");
+                if (pack.empty()) {
+                    continue;
+                }
+                const std::string name = entry.path().stem().string().substr(4);  // "loveSelr": "Selr"
+                pack = WithSameSexLines(pack, language.path().filename().string(), sex, name, fixedLines);
+                const std::filesystem::path target = root / "msglang" / language.path().filename() / sex;
+                std::filesystem::create_directories(target, ec);
+                std::ofstream(target / file, std::ios::binary | std::ios::trunc) << pack;
+                ++packs;
+            }
+        }
+    }
+    GameMods::RegisterDiscOverlay(root);
+    std::fprintf(stderr, "[mod %s] adoption: %zu spouses, %d message packs, %d lines fixed, %zu weddings\n", kMod,
+                 g_spouses.size(), packs, fixedLines, g_weddings.size());
+}
+
+const GameMods::Registration kRegistration(PrepareAdoption);
+
+} // namespace
