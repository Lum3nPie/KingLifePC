+// LifeKing: on the console the audio interrupt fires as soon as interrupts are enabled again, even in
+// the middle of a long frame. The runtime only served audio between frames, so a slow frame (Chime,
+// a building going up) left the music short of samples and slowed it down. Serve it here too, at
+// most every 4 ms, never from inside the audio callback itself.
+static void LifeKing_ServeAudioAtInterruptEnable()
+{
+    static thread_local bool inside = false;
+    static std::atomic<int64_t> lastUs{0};
+    if (inside || !::GuestRegion::IsForeignGame()) {
+        return;
+    }
+    const int64_t now = std::chrono::duration_cast<std::chrono::microseconds>(
+                            std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (now - lastUs.load(std::memory_order_relaxed) < 4000) {
+        return;
+    }
+    lastUs.store(now, std::memory_order_relaxed);
+    inside = true;
+    try {
+        Audio_HLE_PollDeferred();
+    } catch (...) {
+        inside = false;
+        throw;
+    }
+    inside = false;
+}
+
 extern "C" int32_t OS__RestoreInterrupts_801a65d4(int32_t level)
 {
     const bool prev = g_interrupts_enabled.exchange(level != 0);
     UpdateCurrentContextInterruptFlag(level != 0);
+    if (level != 0 && !prev) {
+        LifeKing_ServeAudioAtInterruptEnable();
+    }
     return prev ? 1 : 0;
 }
 
@@ -68,6 +100,9 @@ extern "C" int32_t OS__EnableInterrupts_801a65c0()
 {
     const bool prev = g_interrupts_enabled.exchange(true);
     UpdateCurrentContextInterruptFlag(true);
+    if (!prev) {
+        LifeKing_ServeAudioAtInterruptEnable();
+    }
     return prev ? 1 : 0;
 }
 
