+    char layout[192] = {};
+    size_t used = 0;
+    for (int attr = GX_VA_PNMTXIDX; attr <= GX_VA_TEX7 && used < sizeof(layout) - 16; ++attr) {
+        const GXAttrType type = g_hleGxState.vtxDesc[attr];
+        if (type == GX_NONE) continue;
+        used += std::snprintf(layout + used, sizeof(layout) - used, " %s:%d", kNames[attr], static_cast<int>(type));
+        if (attr == GX_VA_NRM) {
+            const bool nbt = g_hleGxState.vtxAttrFmt[vf][attr].cnt != GX_NRM_XYZ;
+            used += std::snprintf(layout + used, sizeof(layout) - used, "/n%d", nbt ? 9 : 3);
+        }
+    }
+    const auto& pos = g_hleGxState.vtxArray[GX_VA_POS];
+    const auto& nrm = g_hleGxState.vtxArray[GX_VA_NRM];
+    const auto& posFmt = g_hleGxState.vtxAttrFmt[vf][GX_VA_POS];
+    GxFrameTrace::Note("  list 0x%08X drawn with format %u layout%s; positions at 0x%08X stride %u type %d "
+                       "frac %u, normals at 0x%08X stride %u",
+                       listAddr, vf, layout, pos.base, pos.stride, static_cast<int>(posFmt.type), posFmt.frac,
+                       nrm.base, nrm.stride);
+    TraceArrayValues("positions", pos.base, pos.stride);
+    TraceArrayDump(pos.base, pos.stride);
+    TraceDisplayListIndices(listAddr, nbytes, pos.base, pos.stride);
+    TraceArrayValues("normals", nrm.base, nrm.stride);
