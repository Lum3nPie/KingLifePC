@@ -0,0 +1,478 @@
+// The on-screen controller (touch_controls.h).
+//
+// Every finger that comes down is given to the control under it and stays with that control until
+// it is lifted: a stick follows the finger even past its edge, the D-pad reads the direction the
+// finger is from its middle, a button is held. A finger that lands on no control is the Wii
+// Remote's pointer: the pointer goes where it is and A is pressed a moment later (so the game sees
+// the pointer arrive before the press), and let go when the finger is lifted.
+//
+// The controls are placed from the screen's short side (`unit`), so they keep their size and stay
+// in the corners on a phone, a tablet or a window of any shape:
+//
+//      [L]                    ≡                    [R]
+//
+//       ✚  D-pad                              x       a b x y
+//                                           y   a
+//                                             b
+//      ( )  left stick                       ( )  right stick
+//                      -   HOME   +
+//
+// The sticks are at the sides, under the D-pad and the buttons, where the thumbs rest.
+//
+// El control en pantalla. Cada dedo se queda con el control donde cayó hasta que se levanta; un
+// dedo fuera de los controles es el puntero del Wii Remote y presiona A.
+
+#include "hle/input/touch_controls.h"
+
+#include "runtime_config.h"
+
+#include <SDL3/SDL_gamepad.h>
+#include <SDL3/SDL_hints.h>
+#include <SDL3/SDL_timer.h>
+#include <imgui.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cfloat>
+#include <cstring>
+#include <cmath>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace TouchControls {
+namespace {
+
+// PAD_BUTTON_* of dolphin/pad.h.
+constexpr uint32_t kPadLeft = 0x0001, kPadRight = 0x0002, kPadDown = 0x0004, kPadUp = 0x0008;
+constexpr uint32_t kPadZ = 0x0010, kPadR = 0x0020, kPadL = 0x0040;
+constexpr uint32_t kPadA = 0x0100, kPadB = 0x0200, kPadX = 0x0400, kPadY = 0x0800;
+constexpr uint32_t kPadStart = 0x1000;
+
+// The pointer's A: pressed this long after the finger lands, and held at least this long.
+constexpr uint64_t kPointerPressDelayMs = 50;
+constexpr uint64_t kPointerShortestPressMs = 80;
+// The pointer stays where the finger left it this long (as a remote held still), then goes away.
+constexpr uint64_t kPointerLingerMs = 1500;
+// With a controller connected, the drawing hides when the screen has not been touched this long.
+constexpr uint64_t kHideWithControllerMs = 10000;
+
+enum class Kind { Stick, DPad, Button, Pointer, Menu };
+
+struct Control {
+    Kind kind;
+    bool rightStick = false;   // for a stick: the C-stick
+    uint32_t buttons = 0;      // for a button: what it holds (HOME is + and - together)
+    const char* label = "";
+    // Where it is: its middle as a fraction of the screen's width and height, moved by some units
+    // (the short side) towards the middle, and its size (a radius) in units.
+    float fx, fy, ux, uy, radius;
+    float hitRadius;           // how far from the middle a finger still lands on it, in units
+    bool wide = false;         // drawn as a rounded box twice as wide (L, R)
+};
+
+// a b x y as on a Classic Controller: a on the right, b at the bottom, x at the top, y on the left.
+const Control kControls[] = {
+    {Kind::Menu, false, 0, "", 0.5f, 0.0f, 0.0f, 0.065f, 0.045f, 0.075f},
+    {Kind::Button, false, kPadL, "L", 0.0f, 0.0f, 0.14f, 0.075f, 0.055f, 0.09f, true},
+    {Kind::Button, false, kPadR, "R", 1.0f, 0.0f, -0.14f, 0.075f, 0.055f, 0.09f, true},
+    {Kind::Button, false, kPadZ, "-", 0.5f, 1.0f, -0.13f, -0.07f, 0.042f, 0.06f},
+    {Kind::Button, false, kPadStart | kPadZ, "HOME", 0.5f, 1.0f, 0.0f, -0.07f, 0.042f, 0.06f},
+    {Kind::Button, false, kPadStart, "+", 0.5f, 1.0f, 0.13f, -0.07f, 0.042f, 0.06f},
+    {Kind::Button, false, kPadA, "a", 1.0f, 1.0f, -0.09f, -0.62f, 0.062f, 0.085f},
+    {Kind::Button, false, kPadB, "b", 1.0f, 1.0f, -0.20f, -0.51f, 0.062f, 0.085f},
+    {Kind::Button, false, kPadX, "x", 1.0f, 1.0f, -0.20f, -0.73f, 0.062f, 0.085f},
+    {Kind::Button, false, kPadY, "y", 1.0f, 1.0f, -0.31f, -0.62f, 0.062f, 0.085f},
+    {Kind::DPad, false, 0, "", 0.0f, 1.0f, 0.21f, -0.62f, 0.13f, 0.18f},
+    {Kind::Stick, false, 0, "", 0.0f, 1.0f, 0.20f, -0.22f, 0.13f, 0.21f},
+    {Kind::Stick, true, 0, "", 1.0f, 1.0f, -0.20f, -0.22f, 0.13f, 0.21f},
+};
+constexpr int kControlCount = static_cast<int>(sizeof(kControls) / sizeof(kControls[0]));
+constexpr int kPointer = -1;
+
+struct Finger {
+    int control = kPointer;
+    float startX = 0, startY = 0;   // where it landed, in screen points
+    float x = 0, y = 0;             // where it is
+    uint64_t downMs = 0;
+};
+
+struct Screen {
+    float width = 0, height = 0, unit = 0;
+};
+
+std::mutex g_mutex;
+std::map<SDL_FingerID, Finger> g_fingers;
+Screen g_screen;
+bool g_menuRequest = false;
+bool g_menuOpen = false;
+uint64_t g_lastTouchMs = 0;
+// The pointer once its finger is gone: where it was, and how long A is still held / it stays.
+struct Pointer {
+    bool known = false;
+    float x = 0, y = 0;
+    uint64_t pressUntilMs = 0;
+    uint64_t visibleUntilMs = 0;
+} g_pointer;
+
+uint64_t NowMs() {
+    return SDL_GetTicks();
+}
+
+float CenterX(const Control& c, const Screen& s) {
+    return c.fx * s.width + c.ux * s.unit;
+}
+float CenterY(const Control& c, const Screen& s) {
+    return c.fy * s.height + c.uy * s.unit;
+}
+
+// The control a finger landing at (x, y) belongs to: the nearest one it is within reach of.
+int ControlAt(float x, float y, const Screen& s) {
+    int best = kPointer;
+    float bestDistance = 0;
+    for (int i = 0; i < kControlCount; ++i) {
+        const Control& c = kControls[i];
+        const float dx = x - CenterX(c, s);
+        const float dy = y - CenterY(c, s);
+        // L and R are wide: measure across them as if they were round.
+        const float distance = std::sqrt((c.wide ? dx * dx / 4 : dx * dx) + dy * dy) / s.unit;
+        if (distance <= c.hitRadius && (best == kPointer || distance < bestDistance)) {
+            best = i;
+            bestDistance = distance;
+        }
+    }
+    return best;
+}
+
+// A stick's push from -1 to 1 on each side (up is positive), as far as the finger is from the
+// stick's middle, at most a full push.
+void StickPush(const Finger& f, const Control& c, const Screen& s, float& x, float& y) {
+    const float range = c.radius * s.unit;
+    x = (f.x - CenterX(c, s)) / range;
+    y = -(f.y - CenterY(c, s)) / range;
+    const float length = std::sqrt(x * x + y * y);
+    if (length > 1.0f) {
+        x /= length;
+        y /= length;
+    }
+}
+
+uint32_t DPadButtons(const Finger& f, const Control& c, const Screen& s) {
+    const float dx = (f.x - CenterX(c, s)) / (c.radius * s.unit);
+    const float dy = (f.y - CenterY(c, s)) / (c.radius * s.unit);
+    // A direction counts once the finger is a third of the way out on that side, so the diagonals
+    // are between two arms.
+    constexpr float kThreshold = 0.33f;
+    uint32_t buttons = 0;
+    if (dx < -kThreshold) buttons |= kPadLeft;
+    if (dx > kThreshold) buttons |= kPadRight;
+    if (dy < -kThreshold) buttons |= kPadUp;
+    if (dy > kThreshold) buttons |= kPadDown;
+    return buttons;
+}
+
+int8_t ToPad(float value) {
+    return static_cast<int8_t>(std::clamp(std::lround(value * 127.0f), -127L, 127L));
+}
+
+void ReleaseAll() {
+    g_fingers.clear();
+    g_pointer.pressUntilMs = 0;
+}
+
+void Press(SDL_FingerID id, float x, float y) {
+    if (g_screen.unit <= 0) {
+        return;
+    }
+    Finger f;
+    f.control = ControlAt(x, y, g_screen);
+    f.startX = f.x = x;
+    f.startY = f.y = y;
+    f.downMs = NowMs();
+    if (g_menuOpen && (f.control == kPointer || kControls[f.control].kind != Kind::Menu)) {
+        // With the settings open only the settings button is the controller's; the rest is the
+        // menu's (SDL turns the finger into the mouse for it).
+        return;
+    }
+    if (f.control != kPointer && kControls[f.control].kind == Kind::Menu) {
+        g_menuRequest = true;
+        return;
+    }
+    if (f.control == kPointer) {
+        // One pointer: a second finger off the controls takes it over.
+        for (auto it = g_fingers.begin(); it != g_fingers.end();) {
+            it = it->second.control == kPointer ? g_fingers.erase(it) : std::next(it);
+        }
+        g_pointer.known = true;
+        g_pointer.x = x;
+        g_pointer.y = y;
+    }
+    g_fingers[id] = f;
+}
+
+void Lift(SDL_FingerID id) {
+    auto it = g_fingers.find(id);
+    if (it == g_fingers.end()) {
+        return;
+    }
+    if (it->second.control == kPointer) {
+        const uint64_t now = NowMs();
+        g_pointer.pressUntilMs = std::max(now, it->second.downMs + kPointerPressDelayMs + kPointerShortestPressMs);
+        g_pointer.visibleUntilMs = now + kPointerLingerMs;
+    }
+    g_fingers.erase(it);
+}
+
+} // namespace
+
+bool Enabled() {
+    static const bool enabled = [] {
+        std::string setting = RuntimeConfigFile::TouchControls("auto");
+        std::transform(setting.begin(), setting.end(), setting.begin(),
+                       [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+        if (setting == "true" || setting == "on" || setting == "1") {
+#if !defined(__ANDROID__)
+            // On a computer the mouse plays the finger, to try the controller out.
+            SDL_SetHint(SDL_HINT_MOUSE_TOUCH_EVENTS, "1");
+#endif
+            return true;
+        }
+        if (setting == "false" || setting == "off" || setting == "0") {
+            return false;
+        }
+#if defined(__ANDROID__)
+        return true;
+#else
+        return false;
+#endif
+    }();
+    return enabled;
+}
+
+State Read() {
+    State state;
+    if (!Enabled()) {
+        return state;
+    }
+    std::lock_guard lock(g_mutex);
+    const uint64_t now = NowMs();
+    bool pointerHeld = false;
+    for (const auto& [id, f] : g_fingers) {
+        if (f.control == kPointer) {
+            pointerHeld = true;
+            if (now >= f.downMs + kPointerPressDelayMs) {
+                state.pointerPressed = true;
+            }
+            continue;
+        }
+        const Control& c = kControls[f.control];
+        switch (c.kind) {
+        case Kind::Button:
+            state.buttons |= c.buttons;
+            break;
+        case Kind::DPad:
+            state.buttons |= DPadButtons(f, c, g_screen);
+            break;
+        case Kind::Stick: {
+            float x = 0, y = 0;
+            StickPush(f, c, g_screen, x, y);
+            if (c.rightStick) {
+                state.substickX = ToPad(x);
+                state.substickY = ToPad(y);
+            } else {
+                state.stickX = ToPad(x);
+                state.stickY = ToPad(y);
+            }
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    if (!pointerHeld && now < g_pointer.pressUntilMs) {
+        state.pointerPressed = true;
+    }
+    if (g_pointer.known && (pointerHeld || now < g_pointer.visibleUntilMs) && g_screen.width > 0 &&
+        g_screen.height > 0) {
+        state.pointerValid = true;
+        state.pointerX = g_pointer.x / g_screen.width * 2.0f - 1.0f;
+        state.pointerY = g_pointer.y / g_screen.height * 2.0f - 1.0f;
+    }
+    return state;
+}
+
+void HandleSdlEvent(const SDL_Event& event) {
+    if (!Enabled()) {
+        return;
+    }
+    std::lock_guard lock(g_mutex);
+    switch (event.type) {
+    case SDL_EVENT_FINGER_DOWN:
+        g_lastTouchMs = NowMs();
+        Press(event.tfinger.fingerID, event.tfinger.x * g_screen.width, event.tfinger.y * g_screen.height);
+        break;
+    case SDL_EVENT_FINGER_MOTION: {
+        g_lastTouchMs = NowMs();
+        auto it = g_fingers.find(event.tfinger.fingerID);
+        if (it != g_fingers.end()) {
+            it->second.x = event.tfinger.x * g_screen.width;
+            it->second.y = event.tfinger.y * g_screen.height;
+            if (it->second.control == kPointer) {
+                g_pointer.x = it->second.x;
+                g_pointer.y = it->second.y;
+            }
+        }
+        break;
+    }
+    case SDL_EVENT_FINGER_UP:
+    case SDL_EVENT_FINGER_CANCELED:
+        Lift(event.tfinger.fingerID);
+        break;
+    case SDL_EVENT_KEY_DOWN:
+        // Android's back button (or gesture) opens and closes the settings.
+        if (!event.key.repeat && event.key.scancode == SDL_SCANCODE_AC_BACK) {
+            g_menuRequest = true;
+        }
+        break;
+    case SDL_EVENT_WINDOW_FOCUS_LOST:
+    case SDL_EVENT_WILL_ENTER_BACKGROUND:
+        ReleaseAll();
+        break;
+    default:
+        break;
+    }
+}
+
+void Draw(bool menuOpen) {
+    if (!Enabled()) {
+        return;
+    }
+    const ImGuiIO& io = ImGui::GetIO();
+    std::unique_lock lock(g_mutex);
+    g_screen.width = io.DisplaySize.x;
+    g_screen.height = io.DisplaySize.y;
+    g_screen.unit = std::min(g_screen.width, g_screen.height);
+    if (menuOpen && !g_menuOpen) {
+        ReleaseAll();
+    }
+    g_menuOpen = menuOpen;
+    if (g_screen.unit <= 0) {
+        return;
+    }
+    const uint64_t now = NowMs();
+    if (SDL_HasGamepad() && now - g_lastTouchMs > kHideWithControllerMs && !menuOpen) {
+        return;
+    }
+
+    // What is held now, to light it up.
+    bool held[kControlCount] = {};
+    for (const auto& [id, f] : g_fingers) {
+        if (f.control != kPointer) {
+            held[f.control] = true;
+        }
+    }
+    const Screen s = g_screen;
+    std::map<int, Finger> fingerOf;
+    for (const auto& [id, f] : g_fingers) {
+        if (f.control != kPointer) fingerOf[f.control] = f;
+    }
+    lock.unlock();
+
+    ImDrawList* draw = ImGui::GetForegroundDrawList();
+    ImFont* font = ImGui::GetFont();
+    const ImU32 fill = IM_COL32(20, 20, 20, 70);
+    const ImU32 fillHeld = IM_COL32(255, 255, 255, 110);
+    const ImU32 edge = IM_COL32(255, 255, 255, 130);
+    const ImU32 ink = IM_COL32(255, 255, 255, 200);
+    const float line = std::max(1.5f, s.unit * 0.004f);
+
+    auto text = [&](ImVec2 middle, const char* label, float size) {
+        const ImVec2 extent = font->CalcTextSizeA(size, FLT_MAX, 0.0f, label);
+        draw->AddText(font, size, ImVec2(middle.x - extent.x / 2, middle.y - extent.y / 2), ink, label);
+    };
+
+    for (int i = 0; i < kControlCount; ++i) {
+        const Control& c = kControls[i];
+        if (menuOpen && c.kind != Kind::Menu) {
+            continue;
+        }
+        const ImVec2 middle(CenterX(c, s), CenterY(c, s));
+        const float r = c.radius * s.unit;
+        switch (c.kind) {
+        case Kind::Menu: {
+            draw->AddCircleFilled(middle, r, held[i] ? fillHeld : fill);
+            draw->AddCircle(middle, r, edge, 0, line);
+            for (int bar = -1; bar <= 1; ++bar) {
+                const float y = middle.y + bar * r * 0.35f;
+                draw->AddLine(ImVec2(middle.x - r * 0.45f, y), ImVec2(middle.x + r * 0.45f, y), ink, line * 1.5f);
+            }
+            break;
+        }
+        case Kind::Button:
+            if (c.wide) {
+                const ImVec2 from(middle.x - r * 2, middle.y - r), to(middle.x + r * 2, middle.y + r);
+                draw->AddRectFilled(from, to, held[i] ? fillHeld : fill, r);
+                draw->AddRect(from, to, edge, r, 0, line);
+            } else {
+                draw->AddCircleFilled(middle, r, held[i] ? fillHeld : fill);
+                draw->AddCircle(middle, r, edge, 0, line);
+            }
+            text(middle, c.label, std::strlen(c.label) > 1 ? r * 0.55f : r * 1.1f);
+            break;
+        case Kind::DPad: {
+            // One cross, as on a controller: a middle square and four arms, the pressed arms
+            // lit, a small arrow in each arm and one outline around the whole cross.
+            uint32_t pressed = 0;
+            if (held[i]) pressed = DPadButtons(fingerOf[i], c, s);
+            const float w = r * 0.34f;   // half the width of an arm
+            const float x = middle.x, y = middle.y;
+            draw->AddRectFilled(ImVec2(x - w, y - w), ImVec2(x + w, y + w), fill);
+            struct Arm { uint32_t bit; float dx, dy; };
+            const Arm arms[] = {{kPadUp, 0, -1}, {kPadDown, 0, 1}, {kPadLeft, -1, 0}, {kPadRight, 1, 0}};
+            for (const Arm& a : arms) {
+                // The arm from the middle square to the tip, and its arrow pointing out.
+                const ImVec2 inner(x + a.dx * w, y + a.dy * w), tip(x + a.dx * r, y + a.dy * r);
+                const ImVec2 from(std::min(inner.x, tip.x) - (a.dx == 0 ? w : 0), std::min(inner.y, tip.y) - (a.dy == 0 ? w : 0));
+                const ImVec2 to(std::max(inner.x, tip.x) + (a.dx == 0 ? w : 0), std::max(inner.y, tip.y) + (a.dy == 0 ? w : 0));
+                draw->AddRectFilled(from, to, (pressed & a.bit) ? fillHeld : fill);
+                const float at = r * 0.66f, size = w * 0.5f;
+                const ImVec2 point(x + a.dx * (at + size * 0.6f), y + a.dy * (at + size * 0.6f));
+                const ImVec2 base(x + a.dx * (at - size * 0.4f), y + a.dy * (at - size * 0.4f));
+                draw->AddTriangleFilled(point, ImVec2(base.x - a.dy * size, base.y + a.dx * size),
+                                        ImVec2(base.x + a.dy * size, base.y - a.dx * size), ink);
+            }
+            const ImVec2 outline[] = {
+                {x - w, y - r}, {x + w, y - r}, {x + w, y - w}, {x + r, y - w}, {x + r, y + w}, {x + w, y + w},
+                {x + w, y + r}, {x - w, y + r}, {x - w, y + w}, {x - r, y + w}, {x - r, y - w}, {x - w, y - w},
+            };
+            draw->AddPolyline(outline, 12, edge, ImDrawFlags_Closed, line);
+            draw->AddCircleFilled(middle, w * 0.45f, IM_COL32(255, 255, 255, 40));
+            break;
+        }
+        case Kind::Stick: {
+            draw->AddCircleFilled(middle, r, fill);
+            draw->AddCircle(middle, r, edge, 0, line);
+            ImVec2 knob = middle;
+            if (held[i]) {
+                float x = 0, y = 0;
+                StickPush(fingerOf[i], c, s, x, y);
+                knob = ImVec2(middle.x + x * r, middle.y - y * r);
+            }
+            draw->AddCircleFilled(knob, r * 0.45f, held[i] ? fillHeld : IM_COL32(255, 255, 255, 60));
+            draw->AddCircle(knob, r * 0.45f, edge, 0, line);
+            break;
+        }
+        default:
+            break;
+        }
+    }
+}
+
+bool TakeMenuRequest() {
+    std::lock_guard lock(g_mutex);
+    const bool request = g_menuRequest;
+    g_menuRequest = false;
+    return request;
+}
+
+} // namespace TouchControls
diff --git a/runtime/src/hle/input/touch_controls.h b/runtime/src/hle/input/touch_controls.h
new file mode 100644
index 0000000..3840c1e
--- /dev/null
+++ b/runtime/src/hle/input/touch_controls.h
@@ -0,0 +1,52 @@
+// The on-screen controller for touch screens (a phone or a tablet with Android): drawn over the
+// game in the layout of a Wii Classic Controller, and read like one more GameCube pad, which the
+// game gets as its Wii Remote and Nunchuk (hle/bluetooth/emulated_remote_host.cpp):
+//
+//   left stick   the Nunchuk's stick           right stick  the C-stick (the D-pad, or the free camera)
+//   D-pad        the D-pad                     a b x y      A, B, 1, 2
+//   L  R         the Nunchuk's Z and C         -  +  HOME   -, +, and HOME
+//   ≡            the settings (as F10)         anywhere else   points there and presses A
+//
+// It is on with [input] touch_controls = true, off with false, and with "auto" (or no line) only
+// where the screen is a touch screen (Android). On a computer it can be tried with the mouse:
+// SDL then turns the mouse into a finger (touch_controls = true).
+//
+// El control en pantalla para pantallas táctiles: se dibuja sobre el juego con la forma de un
+// control Classic de Wii y se lee como un control de GameCube más, que el juego recibe como su Wii
+// Remote y Nunchuk.
+
+#pragma once
+
+#include <SDL3/SDL_events.h>
+
+#include <cstdint>
+
+namespace TouchControls {
+
+// Whether the on-screen controller is in use ([input] touch_controls).
+bool Enabled();
+
+// The controller as the game sees it: GameCube buttons (PAD_BUTTON_*), sticks from -127 to 127,
+// and a finger elsewhere on the screen as the Wii Remote's pointer (from -1 to 1, as the window).
+struct State {
+    uint32_t buttons = 0;
+    int8_t stickX = 0, stickY = 0;
+    int8_t substickX = 0, substickY = 0;
+    bool pointerValid = false;
+    float pointerX = 0.0f, pointerY = 0.0f;
+    bool pointerPressed = false;
+};
+State Read();
+
+// The fingers, from SDL's events (on the thread that runs the window).
+void HandleSdlEvent(const SDL_Event& event);
+
+// Draws the controller over the picture (ImGui, on the thread that runs the window). `menuOpen`
+// says whether the settings are showing: then only the settings button is drawn and fingers work
+// the menu instead.
+void Draw(bool menuOpen);
+
+// The settings button was touched since the last call.
+bool TakeMenuRequest();
+
+} // namespace TouchControls
diff --git a/runtime/src/hle/lifeking_natives.cpp b/runtime/src/hle/lifeking_natives.cpp
new file mode 100644
index 0000000..e8c2218
--- /dev/null
+++ b/runtime/src/hle/lifeking_natives.cpp
@@ -0,0 +1,582 @@
+// Natives for My Life as a King (WiiWare PAL, WFCPGD): functions of its own SDK build that need a
+// host-side answer. Registered only while WFCPGD runs (FOREIGN_GAME_NATIVE, see hle_stubs.h).
+
+#include "hle_stubs.h"
+#include "memory.h"
+
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+extern "C" void OS_HLE_ProcessAlarms(int maxToProcess);
+
+// WUDGetStatus (0x8016F5F4): the game's start-up polls WPADGetStatus() (a tail call to this) in a
+// tight loop until the Bluetooth stack is set up (0x80041A44). On the console the stack advances on
+// alarm interrupts; here alarms and Bluetooth completions only run when something pumps them, so the
+// poll pumps them before reading the status byte (WUD's control block 0x80339580, byte at +0x708).
+extern "C" int32_t LifeKing_WUDGetStatus_HLE()
+{
+    OS_HLE_ProcessAlarms(64);
+    const int8_t status = static_cast<int8_t>(Memory::Read8(0x80339580u + 0x708u));
+    if (status != 3) {
+        std::this_thread::sleep_for(std::chrono::microseconds(500));
+    }
+    return status;
+}
+
+FOREIGN_GAME_NATIVE(WFCPGD, 8016F5F4, LifeKing_WUDGetStatus_HLE, int32_t, (), ());
+
+// GXSetDrawDone (0x8010470C) and GXWaitDrawDone (0x801047A4): Mario Kart Wii never links them, so the
+// runtime has no native; translated, GXWaitDrawDone sleeps until the GPU's finish interrupt, which the
+// runtime never raises. GXDrawDone is exactly the two in a row, so GXSetDrawDone runs the runtime's
+// GXDrawDone (flush, finish, DrawDone set) and GXWaitDrawDone has nothing left to wait for.
+extern "C" void GX__DrawDone_8016eab0();
+extern "C" void LifeKing_GXSetDrawDone_HLE() { GX__DrawDone_8016eab0(); }
+extern "C" void LifeKing_GXWaitDrawDone_HLE() {}
+FOREIGN_GAME_NATIVE(WFCPGD, 8010470C, LifeKing_GXSetDrawDone_HLE, void, (), ());
+FOREIGN_GAME_NATIVE(WFCPGD, 801047A4, LifeKing_GXWaitDrawDone_HLE, void, (), ());
+
+
+// --- 60 Hz mode (LIFEKING_FPS=60, off by default) ---------------------------------------------------
+// The game paces itself to 30 FPS on a 60 Hz TV: its present waits until two VI retraces have passed
+// since the previous frame (0x80091FC8, retrace counter 0x8039DC10 bumped by its post-retrace callback
+// 0x800917DC). Its engine has one frame-rate setting, though: the system object 0x802B1B78 keeps the
+// FPS at +0x10 and the seconds per frame at +0x14, set by 0x80033664 (30 for NTSC/EURGB60, 25 for PAL
+// 50 Hz), and the scripts read them (CGetFPS, CGetSPF, CIsRefreshRate60). The mode waits one retrace,
+// sets the engine to 60 and keeps answering "60 Hz TV" to the scripts.
+#include "guest_abi/cpu_context.h"
+#include "guest_function_imports.h"
+#include "runtime_log.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <algorithm>
+
+// --- Field of view (F10) ------------------------------------------------------------------------------
+namespace {
+float ReadGuestF32(uint32_t address) {
+    const uint32_t bits = Memory::Read32(address);
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+void WriteGuestF32(uint32_t address, float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    Memory::Write32(address, bits);
+}
+} // namespace
+
+// The F10 setting widens the picture where the projection reaches the GPU (gx_transform.cpp), but the
+// game still culls with its own, narrower frustum: at 150% buildings and ground at the edges of a
+// cutscene vanished. nw4r::math::FRUSTUM::Set(r3 out, r4 camera matrix, f1 top, f2 bottom, f3 left,
+// f4 right, f5 near, f6 far) at 0x801DC18C builds the frustum the scene is culled with
+// (ScnRoot::UpdateFrustum 0x801C69FC, for every camera kind: the fovy variant 0x801DC0D8 ends here
+// too) and is rebuilt on every call, so widening its near-plane rectangle by the same scale keeps what
+// is drawn in step with the picture, live. Only a world camera (x scale 2n / (r - l) up to 6), as for
+// the picture.
+extern "C" void LifeKing_CullFrustum(CpuContext* ctx) {
+    const float scale = GX_HLE_FieldOfViewScale();
+    if (scale != 1.0f) {
+        const double n = ctx->fpr[5].d;
+        const double width = ctx->fpr[4].d - ctx->fpr[3].d;
+        const double xScale = width != 0.0 ? 2.0 * n / width : 0.0;
+        if (n > 0.0 && xScale > 0.0 && xScale <= kGX_HLE_WorldCameraMaxScale) {
+            for (int i = 1; i <= 4; ++i) {
+                ctx->fpr[i].d = static_cast<float>(ctx->fpr[i].d * scale);
+            }
+        }
+    }
+    GuestFunctions::BaseTranslation(0x801DC18Cu)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 801DC18C, LifeKing_CullFrustum);
+
+// The game also culls its own objects (0x800369D8, called once a frame by 0x800361F4) with a wedge of
+// its own: a left and a right plane built from the game camera's copy of the frustum it was given
+// (GameCamera::SetFrustum 0x800406F4 keeps t, b, l, r, n, f at +0x80..+0x94; 0x80040840 and 0x800408EC
+// read r at +0x8C, l at +0x88 and n at +0x90). The camera is r3 + [r3 + 0x5004] * 0x22C + 0xA84. That
+// copy is widened for the length of the call and put back after, so nothing else sees it changed.
+extern "C" void LifeKing_CullObjects(CpuContext* ctx) {
+    const float scale = GX_HLE_FieldOfViewScale();
+    const uint32_t self = ctx->gpr[3];
+    const uint32_t camera = self + Memory::Read32(self + 0x5004u) * 0x22Cu + 0xA84u;
+    const float t = ReadGuestF32(camera + 0x80u), b = ReadGuestF32(camera + 0x84u);
+    const float l = ReadGuestF32(camera + 0x88u), r = ReadGuestF32(camera + 0x8Cu), n = ReadGuestF32(camera + 0x90u);
+    const float xScale = r != l ? 2.0f * n / (r - l) : 0.0f;
+    const bool widen = scale != 1.0f && n > 0.0f && xScale > 0.0f && xScale <= kGX_HLE_WorldCameraMaxScale;
+    if (!widen) {
+        GuestFunctions::BaseTranslation(0x800369D8u)(ctx);
+        return;
+    }
+    const float wide[4] = {t * scale, b * scale, l * scale, r * scale};
+    for (uint32_t i = 0; i < 4; ++i) WriteGuestF32(camera + 0x80u + i * 4u, wide[i]);
+    GuestFunctions::BaseTranslation(0x800369D8u)(ctx);
+    // Put the game's values back, unless the game set new ones meanwhile.
+    const float original[4] = {t, b, l, r};
+    for (uint32_t i = 0; i < 4; ++i) {
+        if (ReadGuestF32(camera + 0x80u + i * 4u) == wide[i]) WriteGuestF32(camera + 0x80u + i * 4u, original[i]);
+    }
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800369D8, LifeKing_CullObjects);
+
+namespace {
+bool LifeKing60Hz() {
+    static const bool on = [] {
+        // v0.2: 60 FPS by default; LIFEKING_FPS=30 keeps the original 30 FPS.
+        const char* value = std::getenv("LIFEKING_FPS");
+        const bool enabled = value == nullptr || std::strcmp(value, "30") != 0;
+        RT_LOGF("lifeking", "%s\n", enabled ? "60 FPS mode (LIFEKING_FPS=30 for the original 30)" : "original 30 FPS (LIFEKING_FPS=30)");
+        return enabled;
+    }();
+    return on;
+}
+constexpr uint32_t kRetracesSinceFrame = 0x8039DC10u;
+} // namespace
+
+extern "C" void LifeKing_AnimTraceFrame();
+
+// --- Max detail (F10) -----------------------------------------------------------------------------
+// The engine picks each model's level of detail from four distances (ints at 0x8039D154..0x8039D160,
+// 30/60/80/100 at boot; read live by the LOD checks around 0x800A1FF4). The scripts set them through
+// worldEngine.setLODDistances, System 0x80034BFC (f1-f4, truncated to ints): Setting.setLOD gives
+// 30/60/80/100 when walking, 0/0/0/0 ("always low") in the top view, construction and a few events,
+// and 1000 each ("always high", the game's own mode, which no script uses). With the setting on, the
+// "always high" distances are kept whatever the scripts ask; the scripts' own values are remembered so
+// turning it off puts them back. Applied on the game's thread, at the next frame wait.
+namespace {
+constexpr uint32_t kLodDistances = 0x8039D154u;
+constexpr uint32_t kLodAlwaysHigh = 1000u;
+std::atomic<bool> g_maxDetail{false};
+bool g_maxDetailApplied = false;
+uint32_t g_gameLodDistances[4] = {30u, 60u, 80u, 100u};
+
+void ApplyMaxDetail() {
+    const bool on = g_maxDetail.load(std::memory_order_relaxed);
+    if (on == g_maxDetailApplied) return;
+    if (on) {
+        for (uint32_t i = 0; i < 4; ++i) g_gameLodDistances[i] = Memory::Read32(kLodDistances + i * 4u);
+    }
+    for (uint32_t i = 0; i < 4; ++i) Memory::Write32(kLodDistances + i * 4u, on ? kLodAlwaysHigh : g_gameLodDistances[i]);
+    g_maxDetailApplied = on;
+    RT_LOGF("lifeking", "max detail %s\n", on ? "on" : "off");
+}
+} // namespace
+
+void LifeKing_HLE_SetMaxDetail(bool enabled) { g_maxDetail.store(enabled, std::memory_order_relaxed); }
+
+extern "C" void LifeKing_SetLODDistances(CpuContext* ctx) {
+    GuestFunctions::BaseTranslation(0x80034BFCu)(ctx);
+    if (g_maxDetailApplied) {
+        for (uint32_t i = 0; i < 4; ++i) {
+            g_gameLodDistances[i] = Memory::Read32(kLodDistances + i * 4u);
+            Memory::Write32(kLodDistances + i * 4u, kLodAlwaysHigh);
+        }
+    }
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 80034BFC, LifeKing_SetLODDistances);
+
+constexpr uint32_t kSystem = 0x802B1B78u;          // the engine's system object
+constexpr uint32_t kSixtyBits = 0x42700000u;       // 60.0f
+constexpr uint32_t kSystemSetFrameRate = 0x80033664u;
+
+// Frame wait: with one retrace already gone, the game's own code waits for none more; with none, one.
+// It also keeps the engine at 60 FPS: the system object's constructor writes 30 after the video set-up
+// already chose the rate, so without this CGetFPS() stayed 30 and none of the scripts' own frame-rate
+// conversions (modFrame, the day clock, the cutscene model clock) applied.
+extern "C" void LifeKing_FrameWait(CpuContext* ctx) {
+    LifeKing_AnimTraceFrame();
+    ApplyMaxDetail();
+    LifeKing_UiScaleFrame(ctx);
+    if (LifeKing60Hz()) {
+        if (Memory::Read32(kSystem + 0x10u) != kSixtyBits) {
+            RT_LOGF("lifeking", "engine frame rate was reset; setting 60 again\n");
+            const uint32_t r3 = ctx->gpr[3];
+            const uint32_t lr = ctx->lr;
+            const PPC_FPR f1 = ctx->fpr[1];
+            ctx->gpr[3] = kSystem;
+            ctx->fpr[1].d = 60.0;
+            GuestFunctions::BaseTranslation(kSystemSetFrameRate)(ctx);
+            ctx->gpr[3] = r3;
+            ctx->lr = lr;
+            ctx->fpr[1] = f1;
+        }
+        if (Memory::Read32(kRetracesSinceFrame) == 0) {
+            Memory::Write32(kRetracesSinceFrame, 1);
+        }
+    }
+    GuestFunctions::BaseTranslation(0x80091FC8u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 80091FC8, LifeKing_FrameWait);
+
+// System::SetFrameRate(f1 = fps): 60 instead of the TV's 30 (or 25).
+extern "C" void LifeKing_SetFrameRate(CpuContext* ctx) {
+    if (LifeKing60Hz()) {
+        RT_LOGF("lifeking", "engine frame rate %.0f -> 60\n", ctx->fpr[1].d);
+        ctx->fpr[1].d = 60.0;
+    }
+    GuestFunctions::BaseTranslation(0x80033664u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 80033664, LifeKing_SetFrameRate);
+
+// System::IsRefreshRate60 (fps == 30): still "yes" at 60, so 60 Hz-only paths are kept.
+extern "C" void LifeKing_IsRefreshRate60(CpuContext* ctx) {
+    if (LifeKing60Hz()) {
+        ctx->gpr[3] = 1;
+        return;
+    }
+    GuestFunctions::BaseTranslation(0x8003364Cu)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 8003364C, LifeKing_IsRefreshRate60);
+
+// --- Animation trace (LIFEKING_ANIM_TRACE=1) ------------------------------------------------------
+// Every few seconds, logs how the game drives nw4r::g3d animations: for each of the seven AnmObj
+// UpdateFrame functions (the users of smBaseUpdateRate), how many objects, how many updates per game
+// frame, and the rates (FrameCtrl rate, set by the game) they run at. Used to find which animations
+// the game already slows down itself, so the 60 Hz mode does not slow them twice.
+#include <algorithm>
+#include <chrono>
+#include <climits>
+#include <map>
+
+namespace {
+bool LifeKingAnimTrace() {
+    static const bool on = [] {
+        const char* value = std::getenv("LIFEKING_ANIM_TRACE");
+        return value != nullptr && value[0] != '0';
+    }();
+    return on;
+}
+
+struct AnimKind {
+    uint32_t address;
+    uint32_t rateOffset;
+};
+constexpr AnimKind kAnimKinds[7] = {
+    {0x801B16C8u, 0x1Cu}, {0x801B1F60u, 0x1Cu}, {0x801B2CE4u, 0x1Cu}, {0x801B3710u, 0x1Cu},
+    {0x801B52BCu, 0x1Cu}, {0x801B60E8u, 0x1Cu}, {0x801B6F7Cu, 0x10u},
+};
+
+struct AnimStats {
+    std::map<uint32_t, uint32_t> callsPerObject;  // object -> calls in the window
+    std::map<int, uint32_t> rates;                // rate * 100 -> calls
+    std::map<uint32_t, uint32_t> callers;         // LR -> calls
+};
+AnimStats g_animStats[7];
+uint32_t g_animFrames = 0;
+
+void ReportAnimTrace() {
+    if (++g_animFrames < 300) return;
+    for (int k = 0; k < 7; ++k) {
+        AnimStats& s = g_animStats[k];
+        if (s.callsPerObject.empty()) continue;
+        uint32_t calls = 0, multi = 0;
+        for (const auto& [obj, n] : s.callsPerObject) {
+            calls += n;
+            if (n > g_animFrames + g_animFrames / 4) ++multi;
+        }
+        char line[512];
+        int len = std::snprintf(line, sizeof(line), "anim kind %d (0x%08X): %zu objects, %.2f updates/frame/object, %u updated more than once a frame; rates:",
+                                k, kAnimKinds[k].address, s.callsPerObject.size(),
+                                static_cast<double>(calls) / g_animFrames / s.callsPerObject.size(), multi);
+        std::multimap<uint32_t, int, std::greater<>> byCount;
+        for (const auto& [rate, n] : s.rates) byCount.emplace(n, rate);
+        int shown = 0;
+        for (const auto& [n, rate] : byCount) {
+            if (shown++ == 8 || len >= static_cast<int>(sizeof(line)) - 32) break;
+            len += std::snprintf(line + len, sizeof(line) - len, " %.2f x%u", rate / 100.0, n);
+        }
+        len += std::snprintf(line + len, sizeof(line) - len, "; callers:");
+        std::multimap<uint32_t, uint32_t, std::greater<>> byCaller;
+        for (const auto& [lr, n] : s.callers) byCaller.emplace(n, lr);
+        shown = 0;
+        for (const auto& [n, lr] : byCaller) {
+            if (shown++ == 4 || len >= static_cast<int>(sizeof(line)) - 24) break;
+            len += std::snprintf(line + len, sizeof(line) - len, " %08X x%u", lr, n);
+        }
+        RT_LOGF("lifeking", "%s\n", line);
+        s = AnimStats{};
+    }
+    g_animFrames = 0;
+}
+
+// 60 Hz: model animations step once per frame by FrameCtrl rate * smBaseUpdateRate. Most play at a
+// constant rate (a motion at 1.0), and those get half the step. The locomotion code, though, sets
+// the rate from the actor's speed, which the 60 Hz scripts already halve: halving those again made
+// walking run at a quarter. The game sets every rate each frame through the blend object
+// (AnmObjChrBlend::SetUpdateRate 0x801B4224, which forwards to each child at 0x801B4278), so the
+// call site of the game is what tells them apart: a site that has passed several different rates is
+// speed-driven, and the objects it last set keep the full step.
+constexpr uint32_t kG3dBaseUpdateRate = 0x8039D818u;  // nw4r::g3d::FrameCtrl::smBaseUpdateRate
+constexpr uint32_t kBlendForwardLr = 0x801B4278u;
+struct SiteInfo {
+    float firstRate = 0.0f;
+    uint32_t distinct = 0;  // rates seen that differ from the first (capped)
+};
+std::map<uint32_t, SiteInfo> g_rateSites;      // game call site (LR) -> what it passes
+struct ObjectRate {
+    uint32_t site = 0;
+    float rate = 1.0f;
+};
+std::map<uint32_t, ObjectRate> g_objectSite;   // animation object -> site and rate it was set last
+uint32_t g_blendCaller = 0;                    // site of the blend SetUpdateRate in progress
+uint32_t g_gameFrame = 0;
+uint32_t g_halvedSteps = 0;                    // trace: animation steps halved / kept full
+uint32_t g_fullSteps = 0;
+std::map<uint64_t, uint32_t> g_rateSetters;    // (LR << 16 | rate * 100) -> calls, for the trace
+
+void SetBaseUpdateRate(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    Memory::Write32(kG3dBaseUpdateRate, bits);
+}
+
+void NoteRateSet(uint32_t site, uint32_t obj, float rate) {
+    SiteInfo& info = g_rateSites[site];
+    if (info.distinct == 0 && info.firstRate == 0.0f) {
+        info.firstRate = rate;
+        info.distinct = 1;
+    } else if (rate != info.firstRate && info.distinct < 100) {
+        ++info.distinct;
+    }
+    g_objectSite[obj] = ObjectRate{site, rate};
+    if (LifeKingAnimTrace()) {
+        const int r = static_cast<int>(rate * 100.0f + 0.5f);
+        ++g_rateSetters[(static_cast<uint64_t>(site) << 16) | (static_cast<uint32_t>(r) & 0xFFFF)];
+    }
+}
+
+template <uint32_t Address>
+void LifeKing_AnimSetRate(CpuContext* ctx) {
+    if (LifeKing60Hz()) {
+        const uint32_t site = ctx->lr == kBlendForwardLr && g_blendCaller != 0 ? g_blendCaller : ctx->lr;
+        NoteRateSet(site, ctx->gpr[3], static_cast<float>(ctx->fpr[1].d));
+    }
+    GuestFunctions::BaseTranslation(Address)(ctx);
+}
+
+extern "C" void LifeKing_AnimBlendSetRate(CpuContext* ctx) {
+    const uint32_t outer = g_blendCaller;
+    if (g_blendCaller == 0) g_blendCaller = ctx->lr;  // nested blends keep the game's site
+    if (LifeKing60Hz()) NoteRateSet(g_blendCaller, ctx->gpr[3], static_cast<float>(ctx->fpr[1].d));
+    GuestFunctions::BaseTranslation(0x801B4224u)(ctx);
+    g_blendCaller = outer;
+}
+
+bool SpeedDriven(uint32_t obj) {
+    const auto it = g_objectSite.find(obj);
+    if (it == g_objectSite.end()) return false;
+    // A speed-driven site also plays plain motions at exactly 1.0 (standing): those are halved.
+    if (it->second.rate == 1.0f) return false;
+    const auto site = g_rateSites.find(it->second.site);
+    return site != g_rateSites.end() && site->second.distinct >= 4;
+}
+
+template <int K>
+void LifeKing_AnimUpdate(CpuContext* ctx) {
+    if (LifeKing60Hz()) {
+        const bool full = SpeedDriven(ctx->gpr[3]);
+        ++(full ? g_fullSteps : g_halvedSteps);
+        SetBaseUpdateRate(full ? 1.0f : 0.5f);
+    }
+    if (LifeKingAnimTrace()) {
+        const uint32_t obj = ctx->gpr[3];
+        uint32_t bits = Memory::Read32(obj + kAnimKinds[K].rateOffset);
+        float rate;
+        std::memcpy(&rate, &bits, sizeof(rate));
+        AnimStats& s = g_animStats[K];
+        ++s.callsPerObject[obj];
+        ++s.rates[static_cast<int>(rate * 100.0f + (rate >= 0 ? 0.5f : -0.5f))];
+        ++s.callers[ctx->lr];
+    }
+    GuestFunctions::BaseTranslation(kAnimKinds[K].address)(ctx);
+}
+} // namespace
+
+// CUpdateModels(microseconds) (script binding 0x8004C540 -> System 0x80032E98): the model clock the
+// scripts hand to the engine, which turns it into the animation rates (elapsed / 33.32 ms, 0x800AA4F8).
+struct ModelClock {
+    uint32_t calls = 0;
+    int64_t sum = 0;
+    int32_t min = INT32_MAX;
+    int32_t max = INT32_MIN;
+};
+ModelClock g_modelClock;
+const auto g_traceStart = std::chrono::steady_clock::now();
+
+extern "C" void LifeKing_UpdateModels(CpuContext* ctx) {
+    if (LifeKingAnimTrace()) {
+        const int32_t us = static_cast<int32_t>(ctx->gpr[4]);
+        ++g_modelClock.calls;
+        g_modelClock.sum += us;
+        g_modelClock.min = std::min(g_modelClock.min, us);
+        g_modelClock.max = std::max(g_modelClock.max, us);
+    }
+    GuestFunctions::BaseTranslation(0x80032E98u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 80032E98, LifeKing_UpdateModels);
+
+extern "C" void LifeKing_AnimTraceFrame() {
+    ++g_gameFrame;
+    if (g_objectSite.size() > 8192) g_objectSite.clear();  // freed objects; live ones are set again next frame
+    if (!LifeKingAnimTrace()) return;
+    if (g_animFrames + 1 >= 300) {
+        const double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_traceStart).count();
+        RT_LOGF("lifeking", "t=%.0fs: model clock %u calls/300 frames, us avg %.0f min %d max %d; steps halved %u full %u; engine fps bits %08X\n",
+                t, g_modelClock.calls, g_modelClock.calls ? static_cast<double>(g_modelClock.sum) / g_modelClock.calls : 0.0,
+                g_modelClock.calls ? g_modelClock.min : 0, g_modelClock.calls ? g_modelClock.max : 0, g_halvedSteps, g_fullSteps, Memory::Read32(kSystem + 0x10u));
+        g_modelClock = ModelClock{};
+        g_halvedSteps = g_fullSteps = 0;
+    }
+    if (g_animFrames + 1 >= 300 && !g_rateSetters.empty()) {
+        std::multimap<uint32_t, uint64_t, std::greater<>> byCount;
+        for (const auto& [key, n] : g_rateSetters) byCount.emplace(n, key);
+        char line[512];
+        int len = std::snprintf(line, sizeof(line), "anim rate setters (caller rate xcalls):");
+        int shown = 0;
+        for (const auto& [n, key] : byCount) {
+            if (shown++ == 10 || len >= static_cast<int>(sizeof(line)) - 32) break;
+            len += std::snprintf(line + len, sizeof(line) - len, " %08X %.2f x%u", static_cast<uint32_t>(key >> 16),
+                                 static_cast<int16_t>(key & 0xFFFF) / 100.0, n);
+        }
+        RT_LOGF("lifeking", "%s\n", line);
+        g_rateSetters.clear();
+    }
+    ReportAnimTrace();
+}
+
+extern "C" void LifeKing_AnimSetRate0(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B16B8u>(ctx); }
+extern "C" void LifeKing_AnimSetRate1(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B1EA4u>(ctx); }
+extern "C" void LifeKing_AnimSetRate2(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B2C28u>(ctx); }
+extern "C" void LifeKing_AnimSetRate3(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B3654u>(ctx); }
+extern "C" void LifeKing_AnimSetRate4(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B5200u>(ctx); }
+extern "C" void LifeKing_AnimSetRate5(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B6028u>(ctx); }
+extern "C" void LifeKing_AnimSetRate6(CpuContext* ctx) { LifeKing_AnimSetRate<0x801B6F50u>(ctx); }
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B16B8, LifeKing_AnimSetRate0);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B1EA4, LifeKing_AnimSetRate1);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B2C28, LifeKing_AnimSetRate2);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B3654, LifeKing_AnimSetRate3);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B5200, LifeKing_AnimSetRate4);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B6028, LifeKing_AnimSetRate5);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B6F50, LifeKing_AnimSetRate6);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B4224, LifeKing_AnimBlendSetRate);
+
+extern "C" void LifeKing_AnimUpdate0(CpuContext* ctx) { LifeKing_AnimUpdate<0>(ctx); }
+extern "C" void LifeKing_AnimUpdate1(CpuContext* ctx) { LifeKing_AnimUpdate<1>(ctx); }
+extern "C" void LifeKing_AnimUpdate2(CpuContext* ctx) { LifeKing_AnimUpdate<2>(ctx); }
+extern "C" void LifeKing_AnimUpdate3(CpuContext* ctx) { LifeKing_AnimUpdate<3>(ctx); }
+extern "C" void LifeKing_AnimUpdate4(CpuContext* ctx) { LifeKing_AnimUpdate<4>(ctx); }
+extern "C" void LifeKing_AnimUpdate5(CpuContext* ctx) { LifeKing_AnimUpdate<5>(ctx); }
+extern "C" void LifeKing_AnimUpdate6(CpuContext* ctx) { LifeKing_AnimUpdate<6>(ctx); }
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B16C8, LifeKing_AnimUpdate0);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B1F60, LifeKing_AnimUpdate1);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B2CE4, LifeKing_AnimUpdate2);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B3710, LifeKing_AnimUpdate3);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B52BC, LifeKing_AnimUpdate4);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B60E8, LifeKing_AnimUpdate5);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B6F7C, LifeKing_AnimUpdate6);
+
+// --- SetFrame trace (LIFEKING_ANIM_TRACE=1) ---------------------------------------------------------
+// Who sets animation frames directly (menus, buildings?) and whether they step them by a constant
+// amount each game frame, which at 60 Hz would play twice as fast.
+namespace {
+struct SetFrameObj {
+    uint32_t lastGameFrame = 0;
+    float lastFrame = 0.0f;
+};
+struct SetFrameSite {
+    uint32_t calls = 0;
+    uint32_t steps = 0;  // calls one game frame after the previous one on the same object, frame moved up by (0, 4]
+    double stepSum = 0.0;
+};
+std::map<uint32_t, SetFrameObj> g_setFrameObjs;
+std::map<uint32_t, SetFrameSite> g_setFrameSites;
+uint32_t g_setFrameReportAt = 0;
+
+template <uint32_t Address>
+void LifeKing_AnimSetFrame(CpuContext* ctx) {
+    if (LifeKingAnimTrace()) {
+        const float frame = static_cast<float>(ctx->fpr[1].d);
+        SetFrameObj& obj = g_setFrameObjs[ctx->gpr[3]];
+        SetFrameSite& site = g_setFrameSites[ctx->lr];
+        ++site.calls;
+        const float delta = frame - obj.lastFrame;
+        if (obj.lastGameFrame + 1 == g_gameFrame && delta > 0.0f && delta <= 4.0f) {
+            ++site.steps;
+            site.stepSum += delta;
+        }
+        obj.lastGameFrame = g_gameFrame;
+        obj.lastFrame = frame;
+        if (g_gameFrame >= g_setFrameReportAt + 300) {
+            g_setFrameReportAt = g_gameFrame;
+            std::multimap<uint32_t, uint32_t, std::greater<>> byCalls;
+            for (const auto& [lr, s] : g_setFrameSites) byCalls.emplace(s.calls, lr);
+            char line[512];
+            int len = std::snprintf(line, sizeof(line), "anim SetFrame sites (caller calls steps avgstep):");
+            int shown = 0;
+            for (const auto& [n, lr] : byCalls) {
+                if (shown++ == 8 || len >= static_cast<int>(sizeof(line)) - 40) break;
+                const SetFrameSite& s = g_setFrameSites[lr];
+                len += std::snprintf(line + len, sizeof(line) - len, " %08X %u %u %.2f", lr, s.calls, s.steps,
+                                     s.steps ? s.stepSum / s.steps : 0.0);
+            }
+            RT_LOGF("lifeking", "%s\n", line);
+            g_setFrameSites.clear();
+            if (g_setFrameObjs.size() > 4096) g_setFrameObjs.clear();
+        }
+    }
+    GuestFunctions::BaseTranslation(Address)(ctx);
+}
+} // namespace
+
+extern "C" void LifeKing_AnimSetFrame0(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B164Cu>(ctx); }
+extern "C" void LifeKing_AnimSetFrame1(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B1DDCu>(ctx); }
+extern "C" void LifeKing_AnimSetFrame2(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B2B60u>(ctx); }
+extern "C" void LifeKing_AnimSetFrame3(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B358Cu>(ctx); }
+extern "C" void LifeKing_AnimSetFrame4(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B5138u>(ctx); }
+extern "C" void LifeKing_AnimSetFrame5(CpuContext* ctx) { LifeKing_AnimSetFrame<0x801B5F5Cu>(ctx); }
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B164C, LifeKing_AnimSetFrame0);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B1DDC, LifeKing_AnimSetFrame1);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B2B60, LifeKing_AnimSetFrame2);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B358C, LifeKing_AnimSetFrame3);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B5138, LifeKing_AnimSetFrame4);
+FOREIGN_GAME_WRAPPER(WFCPGD, 801B5F5C, LifeKing_AnimSetFrame5);
+
+// --- Particle effects at 60 Hz ------------------------------------------------------------------------
+// The effect manager (system object +0x6AA8) steps every nw4r::ef effect by one 30 Hz frame per call
+// (0x800BBBA0, called once per game frame by System::Update 0x80032D18; scripts pre-warm with their own
+// calcFrame). At 60 Hz it runs on every other frame only, so smoke, dust and sparkles keep their speed;
+// they are still drawn every frame.
+extern "C" void LifeKing_EffectCalc(CpuContext* ctx) {
+    if (LifeKing60Hz() && (g_gameFrame & 1u) != 0) {
+        return;
+    }
+    GuestFunctions::BaseTranslation(0x800BBBA0u)(ctx);
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800BBBA0, LifeKing_EffectCalc);
+
+// --- Menu layout animations at 60 Hz ------------------------------------------------------------------
+// A menu animation (script MenuAnime, native object with the speed at +0xC and its nw4r::lyt
+// animation at +0x8) moves its frame (+0x10 of the lyt animation) by the speed each update
+// (0x800CB040, called once per game frame). At 60 Hz the update runs with half the speed.
+extern "C" void LifeKing_MenuAnimeUpdate(CpuContext* ctx) {
+    if (!LifeKing60Hz()) {
+        GuestFunctions::BaseTranslation(0x800CB040u)(ctx);
+        return;
+    }
+    const uint32_t anime = ctx->gpr[3];
+    const uint32_t speedBits = Memory::Read32(anime + 0xCu);
+    float speed;
+    std::memcpy(&speed, &speedBits, sizeof(speed));
+    const float half = speed * 0.5f;
+    uint32_t halfBits;
+    std::memcpy(&halfBits, &half, sizeof(halfBits));
+    Memory::Write32(anime + 0xCu, halfBits);
+    GuestFunctions::BaseTranslation(0x800CB040u)(ctx);
+    if (Memory::Read32(anime + 0xCu) == halfBits) {
+        Memory::Write32(anime + 0xCu, speedBits);
+    }
+}
+FOREIGN_GAME_WRAPPER(WFCPGD, 800CB040, LifeKing_MenuAnimeUpdate);
